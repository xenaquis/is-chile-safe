  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/chroma-js": "^3.1.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
