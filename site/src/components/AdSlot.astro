---
/**
 * AdSlot — CLS-safe ad slot, env-gated by ADSENSE_ENABLED (MON-01, D-09/D-10).
 * With ADSENSE_ENABLED unset (Phase 4 default), renders a reserved-dimension
 * placeholder only — no adsbygoogle <ins>, no Google script request.
 * The pagead2 async loader lives in BaseLayout (D-12, injected once per page).
 * Zero client:* directives.
 */
interface Props {
  // NOTE: prop is `position`, NOT `slot` — `slot` is a reserved Astro attribute
  // (named-slot projection) and would never reach Astro.props (CR/WR fix).
  position: 'content' | 'bottom';
  publisherId?: string;
}

const { position, publisherId = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID ?? '' } = Astro.props;
// Pitfall 4: exact string compare — never !!env (empty string is truthy)
const enabled = import.meta.env.ADSENSE_ENABLED === 'true';
const adSlotId = position === 'content' ? 'CONTENT_SLOT_ID' : 'BOTTOM_SLOT_ID';
---

<div class={`ad-slot ad-slot--${position}`} aria-hidden={!enabled ? 'true' : undefined}>
  {enabled && publisherId ? (
    <ins class="adsbygoogle"
      data-ad-client={publisherId}
      data-ad-slot={adSlotId}
      data-ad-format="auto"
      data-full-width-responsive="true">
    </ins>
  ) : (
    <div class="ad-placeholder" aria-hidden="true"></div>
  )}
</div>

<style>
  .ad-slot {
    width: 100%;
    max-width: 728px;
    margin: var(--lg) auto;
  }

  /* IAB leaderboard 728×90 reserved height (CLS-safe, literal value per UI-SPEC exception) */
  .ad-slot--content { height: 90px; }
  .ad-slot--bottom  { height: 90px; }

  @media (max-width: 639px) {
    /* Mobile banner 320×50 reserved height */
    .ad-slot--content,
    .ad-slot--bottom { height: 50px; }
  }

  .ad-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg);
    border: 2px dashed var(--line);
    border-radius: var(--radius);
  }
</style>
