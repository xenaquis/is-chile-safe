---
/**
 * CrimeFamilyCharts — server-rendered static SVG longitudinal charts.
 * One mini-chart per crime family (7) + one homicide-per-year chart.
 * Zero client:* directives (D-09). Pattern mirrors Sparkline.astro.
 *
 * Partial-year data points render at 0.5 opacity.
 * Each chart is scaled to its OWN max so low-volume families stay readable.
 * NEVER rescale per-100k values — plot raw (memory: crime-rates-already-per-100k).
 */
import { FAMILY_ORDER, FAMILY_LABELS_PAGE } from '../lib/familyDefs';

interface SeriesPoint {
  year: number;
  by_family: Record<string, number>;
  partial?: boolean;
}

interface Props {
  series: SeriesPoint[];
  homicidios: Record<string, number>;
  locale: 'en' | 'es';
  heading: string;
}

const { series, homicidios, locale, heading } = Astro.props;

const SVG_W = 280;
const SVG_H = 80;
const PAD_LEFT = 2;
const PAD_RIGHT = 2;
const PAD_TOP = 4;
const PAD_BOTTOM = 4;

// Sort series ascending by year
const sortedSeries = [...series].sort((a, b) => a.year - b.year);

// Build points for a given value array
function buildPolyline(values: number[], maxVal: number): string {
  if (values.length === 0) return '';
  const n = values.length;
  const plotW = SVG_W - PAD_LEFT - PAD_RIGHT;
  const plotH = SVG_H - PAD_TOP - PAD_BOTTOM;
  return values
    .map((v, i) => {
      const x = PAD_LEFT + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
      const y = PAD_TOP + plotH - (maxVal > 0 ? (v / maxVal) * plotH : 0);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}

// Build per-family chart data
interface ChartDef {
  key: string;
  label: string;
  ariaLabel: string;
  years: number[];
  values: number[];
  partials: boolean[];
  polyline: string;
}

const familyCharts: ChartDef[] = FAMILY_ORDER.map((key) => {
  const years = sortedSeries.map((s) => s.year);
  const values = sortedSeries.map((s) => s.by_family[key] ?? 0);
  const partials = sortedSeries.map((s) => s.partial ?? false);
  const maxVal = Math.max(...values, 1);
  const polyline = buildPolyline(values, maxVal);
  const label = FAMILY_LABELS_PAGE[key]?.[locale] ?? key;
  const firstYear = years[0] ?? '';
  const lastYear = years[years.length - 1] ?? '';
  const ariaLabel =
    locale === 'es'
      ? `${label}, incidencia reportada por 100.000, ${firstYear}–${lastYear}`
      : `${label} reported incidence per 100,000, ${firstYear}–${lastYear}`;
  return { key, label, ariaLabel, years, values, partials, polyline };
});

// Homicide chart
const homYears = Object.keys(homicidios).map(Number).sort((a, b) => a - b);
const homValues = homYears.map((y) => homicidios[String(y)] ?? 0);
const homPartials = homYears.map((y) => {
  const entry = sortedSeries.find((s) => s.year === y);
  return entry?.partial ?? false;
});
const homMax = Math.max(...homValues, 1);
const homPolyline = buildPolyline(homValues, homMax);
const homLabel = FAMILY_LABELS_PAGE['homicidios']?.[locale] ?? 'Homicide';
const homFirstYear = homYears[0] ?? '';
const homLastYear = homYears[homYears.length - 1] ?? '';
const homAriaLabel =
  locale === 'es'
    ? `${homLabel}, incidencia reportada por 100.000, ${homFirstYear}–${homLastYear}`
    : `${homLabel} reported incidence per 100,000, ${homFirstYear}–${homLastYear}`;
---

<section class="crime-family-charts" aria-label={heading}>
  <h2 class="section-heading">{heading}</h2>
  <div class="charts-grid">
    {familyCharts.map((chart) => (
      <div class="mini-chart" aria-label={chart.ariaLabel}>
        <p class="mini-chart-label">{chart.label}</p>
        <svg
          width={SVG_W}
          height={SVG_H}
          viewBox={`0 0 ${SVG_W} ${SVG_H}`}
          aria-hidden="true"
          class="mini-chart-svg"
          style="width:100%;height:auto;overflow:visible"
        >
          {/* Baseline */}
          <line
            x1={PAD_LEFT}
            y1={SVG_H - PAD_BOTTOM}
            x2={SVG_W - PAD_RIGHT}
            y2={SVG_H - PAD_BOTTOM}
            stroke="var(--line)"
            stroke-width="1"
          />
          {/* Polyline */}
          {chart.polyline && (
            <polyline
              points={chart.polyline}
              fill="none"
              stroke="var(--primary)"
              stroke-width="1.5"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
          )}
          {/* Data points — partial at 0.5 opacity */}
          {chart.years.map((_yr, i) => {
            const n = chart.years.length;
            const plotW = SVG_W - PAD_LEFT - PAD_RIGHT;
            const plotH = SVG_H - PAD_TOP - PAD_BOTTOM;
            const maxVal = Math.max(...chart.values, 1);
            const cx = PAD_LEFT + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
            const cy = PAD_TOP + plotH - (maxVal > 0 ? (chart.values[i]! / maxVal) * plotH : 0);
            return (
              <circle
                cx={cx.toFixed(1)}
                cy={cy.toFixed(1)}
                r="2.5"
                fill="var(--primary)"
                opacity={chart.partials[i] ? 0.5 : 1}
              />
            );
          })}
        </svg>
        <p class="mini-chart-years">
          {chart.years[0]}–{chart.years[chart.years.length - 1]}
        </p>
      </div>
    ))}

    {/* Homicide chart */}
    <div class="mini-chart" aria-label={homAriaLabel}>
      <p class="mini-chart-label">{homLabel}</p>
      <svg
        width={SVG_W}
        height={SVG_H}
        viewBox={`0 0 ${SVG_W} ${SVG_H}`}
        aria-hidden="true"
        class="mini-chart-svg"
        style="width:100%;height:auto;overflow:visible"
      >
        <line
          x1={PAD_LEFT}
          y1={SVG_H - PAD_BOTTOM}
          x2={SVG_W - PAD_RIGHT}
          y2={SVG_H - PAD_BOTTOM}
          stroke="var(--line)"
          stroke-width="1"
        />
        {homPolyline && (
          <polyline
            points={homPolyline}
            fill="none"
            stroke="var(--primary)"
            stroke-width="1.5"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
        )}
        {homYears.map((_yr, i) => {
          const n = homYears.length;
          const plotW = SVG_W - PAD_LEFT - PAD_RIGHT;
          const plotH = SVG_H - PAD_TOP - PAD_BOTTOM;
          const cx = PAD_LEFT + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
          const cy = PAD_TOP + plotH - (homMax > 0 ? (homValues[i]! / homMax) * plotH : 0);
          return (
            <circle
              cx={cx.toFixed(1)}
              cy={cy.toFixed(1)}
              r="2.5"
              fill="var(--primary)"
              opacity={homPartials[i] ? 0.5 : 1}
            />
          );
        })}
      </svg>
      <p class="mini-chart-years">
        {homFirstYear}–{homLastYear}
      </p>
    </div>
  </div>
</section>

<style>
  .crime-family-charts {
    margin: var(--xl) 0;
  }

  .charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--md);
    margin-top: var(--md);
  }

  .mini-chart {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--sm);
  }

  .mini-chart-label {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: 0 0 var(--xs) 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-chart-svg {
    display: block;
  }

  .mini-chart-years {
    font-size: 11px;
    color: var(--muted);
    margin: var(--xs) 0 0 0;
    text-align: right;
  }
</style>
