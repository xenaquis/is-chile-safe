---
/**
 * PageHeader — site wordmark + nav + lang toggle.
 * Static server-rendered only — zero client:* directives (D-09).
 * Ported from ischilesafe.com/components.jsx Header (lines 21-39).
 *
 * Uses getRelativeLocaleUrl() for all internal links per Astro i18n docs.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { EN_STRINGS, ES_STRINGS } from '../config/i18n.ts';

interface Props {
  locale: 'en' | 'es';
  enPath: string;
  esPath: string;
}

const { locale, enPath, esPath } = Astro.props;
const t = locale === 'en' ? EN_STRINGS : ES_STRINGS;

const homeHref = getRelativeLocaleUrl(locale, '/');
// ES uses a localized slug (/es/mapa/), so getRelativeLocaleUrl('/map') would emit a
// broken /es/map/. Map the slug per-locale, matching methodHref below.
const mapHref  = locale === 'en' ? '/map/' : '/es/mapa/';
const methodHref = locale === 'en' ? '/methodology/' : '/es/metodologia/';
// Hardcoded per-locale — getRelativeLocaleUrl does NOT translate ES slugs (Pitfall 3)
const communesHref = locale === 'en' ? '/communes/' : '/es/comunas/';

// Lang toggle: link to the alternate locale's equivalent path
const altHref = locale === 'en' ? esPath : enPath;
---

<header class="csm-header">
  <a href={homeHref} class="wordmark" aria-label="Chile Safety Map home">
    <!-- PinGlyph SVG (ported from components.jsx lines 4-10) -->
    <span class="wordmark-glyph" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11" cy="9" r="5" fill="var(--primary)" />
        <ellipse cx="11" cy="9" rx="2" ry="2" fill="white" />
        <path d="M11 14 Q7 18 11 22 Q15 18 11 14Z" fill="var(--primary)" />
      </svg>
    </span>
    <span class="wordmark-text">Chile Safety Map</span>
  </a>

  <!--
    Zero-JS hamburger (WR-03 fix): the checkbox is the keyboard-operable control
    — sr-only but focusable, so Tab reaches it and Space toggles the nav. It
    carries the accessible name; the <label> is the decorative burger surface
    (aria-hidden) and still toggles the checkbox for pointer users.
  -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-label={t.nav_menu_open} />
  <label for="nav-toggle" class="nav-toggle-btn" aria-hidden="true">
    <span class="burger-bar"></span>
    <span class="burger-bar"></span>
    <span class="burger-bar"></span>
  </label>

  <nav class="csm-nav" aria-label="Main navigation">
    <a href={homeHref} class="nav-link">{t.nav_home}</a>
    <a href={mapHref}  class="nav-link">{t.nav_map}</a>
    <a href={communesHref} class="nav-link">{t.nav_communes}</a>
    <a href={methodHref} class="nav-link">{t.nav_methodology}</a>
  </nav>

  <div class="header-right">
    <div class="lang-toggle" role="group" aria-label="Idioma / Language">
      {locale === 'en' ? (
        <>
          <span class="lang-btn active" aria-current="true">EN</span>
          <a href={altHref} class="lang-btn" lang="es">ES</a>
        </>
      ) : (
        <>
          <a href={altHref} class="lang-btn" lang="en">EN</a>
          <span class="lang-btn active" aria-current="true">ES</span>
        </>
      )}
    </div>
  </div>
</header>

<style>
  .csm-header {
    display: flex;
    align-items: center;
    gap: var(--md);
    height: var(--3xl); /* 64px */
    padding: 0 var(--lg);
    background: var(--card);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--xs);
    text-decoration: none;
    color: var(--ink);
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    flex-shrink: 0;
  }

  .wordmark-glyph {
    display: flex;
    align-items: center;
  }

  .csm-nav {
    display: none;
    align-items: center;
    gap: var(--sm);
    flex: 1;
  }

  @media (min-width: 640px) {
    .csm-nav {
      display: flex;
    }
  }

  .nav-link {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--muted);
    text-decoration: none;
    padding: var(--sm) 14px;
    border-radius: calc(var(--radius) / 2);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s, background 0.15s;
  }

  .nav-link:hover {
    color: var(--primary);
    background: var(--bg);
  }

  .header-right {
    margin-left: auto;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) / 2);
    overflow: hidden;
  }

  .lang-btn {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    padding: 4px 10px;
    color: var(--muted);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .lang-btn.active {
    background: var(--primary);
    color: var(--card);
  }

  .lang-btn:not(.active):hover {
    background: var(--bg);
    color: var(--primary);
  }

  /* Zero-JS hamburger — checkbox is sr-only but FOCUSABLE (not display:none),
     so keyboard users can Tab to it and toggle the nav with Space (WR-03). */
  .nav-toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Desktop: nav always visible, so the toggle is irrelevant — remove it from
     the tab order entirely. */
  @media (min-width: 640px) {
    .nav-toggle-input { display: none; }
  }

  /* Show a visible focus ring on the burger when the (hidden) checkbox is
     keyboard-focused. */
  .nav-toggle-input:focus-visible ~ .nav-toggle-btn {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Hamburger button: visible only below 640px */
  .nav-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    cursor: pointer;
    margin-left: auto;
  }

  @media (min-width: 640px) {
    .nav-toggle-btn { display: none; }
  }

  .burger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  /* When checked, show the nav as a dropdown */
  .nav-toggle-input:checked ~ .csm-nav {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: var(--3xl);
    left: 0;
    right: 0;
    background: var(--card);
    border-bottom: 1px solid var(--line);
    padding: var(--sm) var(--lg);
    z-index: 99;
    gap: 0;
  }

  /* Keep desktop layout unchanged */
  @media (min-width: 640px) {
    .nav-toggle-input:checked ~ .csm-nav {
      position: static;
      flex-direction: row;
      border-bottom: none;
      padding: 0;
    }
  }
</style>
