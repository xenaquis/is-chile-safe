---
/**
 * CommuneRankingTable — server-rendered <table> for region page commune listing.
 * NEW component (no prototype analog).
 *
 * Low-population communes marked with * and excluded from rank numbering.
 * Commune names link to locale-aware commune pages.
 * Mobile: table scrolls horizontally via overflow-x: auto wrapper.
 *
 * Zero client:* directives, no JS sorting (D-09).
 */
import { EN_STRINGS, ES_STRINGS } from '../config/i18n.ts';
import TrendChip from './TrendChip.astro';
import RateTooltip from './RateTooltip.astro';
import RankingTableEnhancer from './RankingTableEnhancer.astro';
import { formatRate } from '../lib/formatNumber';

interface RankingRow {
  name: string;
  slug: string;
  rate: number;
  national_rank: number;
  trend: 'up' | 'down' | 'stable';
  low_population: boolean;
  ratesByYear: Record<number, number>;
}

interface Props {
  rows: RankingRow[];
  locale: 'en' | 'es';
  sortable?: boolean;
  defaultSortDir?: 'asc' | 'desc';
}

const { rows, locale, sortable = true, defaultSortDir } = Astro.props;
const t = locale === 'en' ? EN_STRINGS : ES_STRINGS;

const communeColLabel = t.th_commune;
const rateColLabel    = t.th_rate_per_100k;
const rankColLabel    = t.national_rank_label;
const trendColLabel   = t.trend_label;

// Locale-aware commune URL prefix
const communePrefix = locale === 'en' ? '/commune/' : '/es/comuna/';

// Glossary cross-link
const glossaryHref = locale === 'en' ? '/glossary/' : '/es/glosario/';
const glossaryLabel = t.glossary_link;
---

<div class="table-wrapper">
  <table
    class="commune-ranking-table"
    data-locale={locale}
    {...(sortable ? { 'data-ranking-table': true, 'data-rate-col': '1', 'data-name-col': '0', 'data-rate-format': 'round', ...(defaultSortDir ? { 'data-default-sort-dir': defaultSortDir } : {}) } : {})}
  >
    <thead>
      <tr>
        <th scope="col">{communeColLabel}</th>
        <th scope="col" class="col-num">{rateColLabel}<RateTooltip lang={locale} tip={t.rate_tooltip_body} /></th>
        <th scope="col" class="col-num">{rankColLabel}</th>
        <th scope="col">{trendColLabel}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr
          class={row.low_population ? 'low-pop' : ''}
          {...(sortable ? { 'data-rates': JSON.stringify(row.ratesByYear), 'data-low-pop': row.low_population ? '1' : undefined } : {})}
        >
          <td>
            <a href={`${communePrefix}${row.slug}/`} class="commune-link">
              {row.name}
            </a>
            {row.low_population && (
              <sup class="low-pop-marker" title={t.low_population_caveat}>*</sup>
            )}
          </td>
          <td class="col-num">{formatRate(row.rate, locale)}</td>
          <td class="col-num">
            {row.low_population ? '—' : `#${row.national_rank}`}
          </td>
          <td><TrendChip trend={row.trend} locale={locale} /></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
{rows.some((r) => r.low_population) && (
  <p class="low-pop-footnote">* {t.low_population_caveat}</p>
)}
<p class="glossary-footnote">
  <a href={glossaryHref}>{glossaryLabel}</a>
</p>
{sortable && <RankingTableEnhancer locale={locale} />}

<style>
  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .commune-ranking-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-label);
  }

  .commune-ranking-table thead th {
    background: var(--bg);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--muted);
    padding: var(--sm) var(--md);
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .commune-ranking-table tbody tr {
    border-bottom: 1px solid var(--line);
    background: var(--card);
    transition: background 0.1s;
  }

  .commune-ranking-table tbody tr:last-child {
    border-bottom: none;
  }

  .commune-ranking-table tbody tr:hover {
    background: var(--bg);
  }

  .commune-ranking-table td {
    padding: var(--sm) var(--md);
    color: var(--ink);
    white-space: nowrap;
  }

  .col-num {
    text-align: right;
  }

  .commune-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--weight-strong);
  }

  .commune-link:hover {
    text-decoration: underline;
  }

  .low-pop {
    opacity: 0.75;
  }

  .low-pop-marker {
    color: var(--muted);
    margin-left: 2px;
    font-size: 0.85em;
  }

  .low-pop-footnote {
    font-size: var(--text-label);
    font-weight: var(--weight-body);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .glossary-footnote {
    font-size: var(--text-label);
    font-weight: var(--weight-body);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .glossary-footnote a {
    color: var(--primary);
    text-decoration: none;
  }

  .glossary-footnote a:hover {
    text-decoration: underline;
  }
</style>
