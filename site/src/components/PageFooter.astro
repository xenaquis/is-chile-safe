---
/**
 * PageFooter — wordmark (small) + CEAD source attribution + locale switcher link
 *             + legal page links (EDIT-04, D-13).
 * Zero client:* directives (D-09).
 */
import { EN_STRINGS, ES_STRINGS } from '../config/i18n.ts';

interface Props {
  locale: 'en' | 'es';
  enPath: string;
  esPath: string;
}

const { locale, enPath, esPath } = Astro.props;
const t = locale === 'en' ? EN_STRINGS : ES_STRINGS;

const attribution = locale === 'en'
  ? 'Source: CEAD — Centro de Estudios y Análisis del Delito'
  : 'Fuente: CEAD — Centro de Estudios y Análisis del Delito';

const altLocaleLabel = locale === 'en' ? 'ES' : 'EN';
const altHref = locale === 'en' ? esPath : enPath;
---

<footer class="csm-footer">
  <div class="footer-inner page-content">
    <span class="footer-wordmark">Chile Safety Map</span>
    <span class="footer-attribution">{attribution}</span>
    <a href={altHref} class="footer-lang" lang={locale === 'en' ? 'es' : 'en'}>
      {altLocaleLabel}
    </a>
  </div>
  <!-- Legal links row (D-13) — second nav below the existing footer-inner row -->
  <nav class="footer-legal page-content" aria-label="Legal pages">
    {locale === 'en' ? (
      <>
        <a href="/privacy-policy/">{t.footer_privacy}</a>
        <a href="/terms/">{t.footer_terms}</a>
        <a href="/about/">{t.footer_about}</a>
        <a href="/contact/">{t.footer_contact}</a>
      </>
    ) : (
      <>
        <a href="/es/politica-privacidad/">{t.footer_privacy}</a>
        <a href="/es/terminos/">{t.footer_terms}</a>
        <a href="/es/acerca-de/">{t.footer_about}</a>
        <a href="/es/contacto/">{t.footer_contact}</a>
      </>
    )}
  </nav>
</footer>

<style>
  .csm-footer {
    border-top: 1px solid var(--line);
    background: var(--card);
    padding: var(--lg) 0;
    margin-top: var(--2xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
  }

  .footer-wordmark {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
  }

  .footer-attribution {
    font-size: var(--text-label);
    font-weight: var(--weight-body);
    color: var(--muted);
    flex: 1;
  }

  .footer-lang {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--primary);
    text-decoration: none;
  }

  .footer-lang:hover {
    text-decoration: underline;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md);
    margin-top: var(--sm);
    padding-bottom: var(--sm);
  }

  .footer-legal a {
    font-size: var(--text-label);
    font-weight: var(--weight-body);
    color: var(--muted);
    text-decoration: none;
  }

  .footer-legal a:hover {
    text-decoration: underline;
  }
</style>
