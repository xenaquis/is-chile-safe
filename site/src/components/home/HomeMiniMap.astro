---
/**
 * HomeMiniMap.astro — build-time SVG dot map of the 346 communes + quintile strip.
 *
 * Server-rendered (zero fetch, zero client:* directives): dots from
 * src/data/comuna-centroids.json joined against build-time levels (WR-06
 * value-threshold quintiles, same levelForRate as the rest of the site).
 * Insular communes (lng < -76: Rapa Nui, Juan Fernández) are excluded from the
 * silhouette — same clipping the low-zoom map applies visually via viewport.
 *
 * Enhancement (vanilla <script>): the quintile strip buttons isolate a band —
 * dots outside the band dim via CSS, and a `home:band` CustomEvent notifies
 * HomeExtremes. JS off: strip renders as a static legend (buttons disabled).
 */
import type { HomeCommune } from './homeData.ts';
import { homeV2Strings, fmt } from '../../config/homeV2Strings.ts';

interface Props {
  locale: 'en' | 'es';
  rows: HomeCommune[];
  bandCounts: number[];
  referenceYear: number;
}
const { locale, rows, bandCounts, referenceYear } = Astro.props;
const t = homeV2Strings(locale);
const mapHref = locale === 'en' ? '/map/' : '/es/mapa/';

// LPX-3(c): the real silhouette only occupies ~74px of the old 190px canvas
// (~60% was empty margin inside the strip column) — shrink to match.
const W = 110;
const H = 560;
const PAD = 12;

const pts = rows.filter((c: HomeCommune) => c.lat !== null && c.lng !== null && (c.lng as number) > -76);
let la0 = 90, la1 = -90, ln0 = 180, ln1 = -180;
pts.forEach((c: HomeCommune) => {
  la0 = Math.min(la0, c.lat as number); la1 = Math.max(la1, c.lat as number);
  ln0 = Math.min(ln0, c.lng as number); ln1 = Math.max(ln1, c.lng as number);
});
// ~cos(mean lat) longitude compression so the silhouette isn't stretched
const kY = Math.min((H - 2 * PAD) / Math.max(0.1, la1 - la0), (W - 2 * PAD) / (Math.max(0.1, ln1 - ln0) * 0.82));
const kX = kY * 0.82;
const cx = (ln0 + ln1) / 2;
const cy = (la0 + la1) / 2;

interface MiniMapDot { x: number; y: number; r: number; level: HomeCommune['level']; title: string }

const numLocale = locale === 'en' ? 'en-US' : 'es-CL';
const dots: MiniMapDot[] = pts.map((c: HomeCommune): MiniMapDot => {
  const x = W / 2 + ((c.lng as number) - cx) * kX;
  const y = H / 2 - ((c.lat as number) - cy) * kY;
  const r = Math.max(1.7, Math.min(5.4, 1.5 + Math.sqrt(c.population || 800) / 140));
  return {
    x: Math.round(x * 10) / 10,
    y: Math.round(y * 10) / 10,
    r: Math.round(r * 10) / 10,
    level: c.level,
    title: `${c.name} · ${Math.round(c.rate).toLocaleString(numLocale)} /100k`,
  };
});
---

<div class="minimap-card" data-home-minimap>
  <p class="minimap-title">{t.glance_title}</p>
  <p class="minimap-note" data-minimap-note data-default-note={fmt(t.glance_note, { n: rows.length, year: referenceYear })}>{fmt(t.glance_note, { n: rows.length, year: referenceYear })}</p>
  <svg viewBox={`0 0 ${W} ${H}`} class="minimap-svg" role="img" aria-label={t.glance_svg_aria}>
    {dots.map((d: MiniMapDot) => (
      <circle cx={d.x} cy={d.y} r={d.r} class={`mm-dot mm-l${d.level}`} data-level={d.level}>
        <title>{d.title}</title>
      </circle>
    ))}
  </svg>
  <div class="minimap-strip" role="group">
    {bandCounts.map((n: number, i: number) => (
      <button
        type="button"
        class={`mm-band mm-b${i + 1}`}
        data-band={i + 1}
        data-band-label={t.bands[i]}
        aria-pressed="false"
        aria-label={fmt(t.glance_band_aria, { label: t.bands[i], n })}
        title={fmt(t.glance_band_aria, { label: t.bands[i], n })}
        disabled
      ><span class="mm-count">{n}</span></button>
    ))}
  </div>
  <div class="minimap-scale"><span>{t.glance_low}</span><span>{t.glance_high}</span></div>
  <a href={mapHref} class="minimap-link">{t.glance_open_map}</a>
</div>

<script>
  (function () {
    'use strict';
    const cardEl = document.querySelector<HTMLElement>('[data-home-minimap]');
    if (!cardEl) return;
    // Non-null alias: TS's null-guard narrowing above doesn't propagate into
    // the nested `apply` function declaration below (hoisting semantics), so
    // `card` is redeclared here with a definite HTMLElement type instead.
    const card = cardEl;
    const buttons = Array.from(card.querySelectorAll<HTMLButtonElement>('.mm-band'));
    const note = card.querySelector<HTMLElement>('[data-minimap-note]');
    buttons.forEach((b) => { b.disabled = false; });

    let active = 0;
    function apply(band: number) {
      active = active === band ? 0 : band;
      if (active) card.setAttribute('data-active-band', String(active));
      else card.removeAttribute('data-active-band');
      buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.band === String(active) ? 'true' : 'false'));
      if (note) {
        note.textContent = active
          ? (buttons[active - 1].dataset.bandLabel || note.dataset.defaultNote || '')
          : (note.dataset.defaultNote || '');
      }
      document.dispatchEvent(new CustomEvent('home:band', { detail: { band: active } }));
    }
    buttons.forEach((b) => b.addEventListener('click', () => apply(Number(b.dataset.band))));
  })();
</script>

<style>
  .minimap-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--md); display: flex; flex-direction: column; }
  .minimap-title { font-size: var(--text-label); font-weight: var(--weight-strong); color: var(--ink); }
  .minimap-note { font-size: var(--text-label); color: var(--muted); margin-top: 2px; }
  .minimap-svg { width: 110px; margin: var(--sm) auto 0; display: block; }

  /* LPX-12: hardcoded rgba(28,42,43,…) → color-mix against the --ink token */
  .mm-dot { stroke: color-mix(in srgb, var(--ink) 30%, transparent); stroke-width: 0.6; transition: opacity 0.15s; }
  .mm-l1 { fill: var(--s1); } .mm-l2 { fill: var(--s2); } .mm-l3 { fill: var(--s3); } .mm-l4 { fill: var(--s4); } .mm-l5 { fill: var(--s5); }

  [data-active-band='1'] .mm-dot:not([data-level='1']),
  [data-active-band='2'] .mm-dot:not([data-level='2']),
  [data-active-band='3'] .mm-dot:not([data-level='3']),
  [data-active-band='4'] .mm-dot:not([data-level='4']),
  [data-active-band='5'] .mm-dot:not([data-level='5']) { opacity: 0.12; }

  .minimap-strip { display: flex; border-radius: calc(var(--radius) / 2); overflow: hidden; margin-top: auto; }
  .mm-band { flex: 1; border: none; min-height: 30px; font-family: var(--font); font-size: 12px; font-weight: var(--weight-strong); color: var(--ink); cursor: pointer; padding: 0; transition: opacity 0.15s; }
  .mm-band:disabled { cursor: default; }
  .mm-b1 { background: var(--s1); } .mm-b2 { background: var(--s2); } .mm-b3 { background: var(--s3); } .mm-b4 { background: var(--s4); } .mm-b5 { background: var(--s5); }
  /* LPX-13: dim inactive bands via an overlay instead of opacity on the whole
     button, so the count pill (.mm-count) stays legible on any band color. */
  [data-active-band] .mm-band[aria-pressed='false'] { background-image: linear-gradient(rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.72)); }
  .mm-band[aria-pressed='true'] { box-shadow: inset 0 0 0 2px var(--ink); }
  /* LPX-6: focus-visible ring — overflow:hidden on the strip clipped the
     default outline, so use an inset box-shadow instead (compatible with the
     aria-pressed inset above; source order lets focus win when both apply). */
  .mm-band:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--primary); }

  /* LPX-13: number pill — readable on any of the 5 band background colors. */
  .mm-count { display: inline-block; background: rgba(255, 255, 255, 0.78); color: var(--ink); border-radius: 999px; padding: 0 5px; }

  .minimap-scale { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: var(--xs); }
  .minimap-link { display: inline-block; margin-top: var(--sm); font-size: var(--text-label); font-weight: var(--weight-strong); color: var(--primary); text-decoration: none; }
  .minimap-link:hover { text-decoration: underline; }

  /* LPX-19: reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .mm-dot, .mm-band { transition: none; }
  }
</style>
