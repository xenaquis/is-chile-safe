---
/**
 * ContactForm — static mailto contact form (D-14, EDIT-04).
 * Phase-4 MVP: mailto link mechanism. No backend endpoint.
 *
 * Security note (RESEARCH Security Domain V5):
 *   - The mailto: address is visible in HTML source (email-harvesting tradeoff accepted for MVP volume).
 *   - All three fields carry `required` for client-side validation; no injection sink since there
 *     is no server-side processing — the browser sends the form to the mail client directly.
 *   - v2 migration: replace action with a form service endpoint (e.g. Formspree, Cloudflare Turnstile)
 *     to hide the address and add server-side validation.
 *
 * Props:
 *   locale — 'en' | 'es' for field labels and button copy
 *
 * No client:* directive. Zero JavaScript. Pure server-render.
 */
interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const labels = locale === 'en'
  ? {
      name: 'Your name',
      email: 'Email address',
      message: 'Message',
      submit: 'Send message',
    }
  : {
      name: 'Tu nombre',
      email: 'Correo electrónico',
      message: 'Mensaje',
      submit: 'Enviar mensaje',
    };
---

<!-- Phase-4 MVP: mailto link. Replace with a form service endpoint in v2. -->
<form
  class="contact-form"
  action="mailto:xenaquis@gmail.com"
  method="POST"
  enctype="text/plain"
>
  <div class="form-field">
    <label class="form-label" for="contact-name">{labels.name}</label>
    <input
      class="form-input"
      id="contact-name"
      type="text"
      name="name"
      autocomplete="name"
      required
    />
  </div>

  <div class="form-field">
    <label class="form-label" for="contact-email">{labels.email}</label>
    <input
      class="form-input"
      id="contact-email"
      type="email"
      name="email"
      autocomplete="email"
      required
    />
  </div>

  <div class="form-field">
    <label class="form-label" for="contact-message">{labels.message}</label>
    <textarea
      class="form-input form-textarea"
      id="contact-message"
      name="message"
      rows="5"
      required
    ></textarea>
  </div>

  <button class="form-submit" type="submit">{labels.submit}</button>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .form-field {
    margin-bottom: var(--md);
  }

  .form-label {
    display: block;
    font-size: var(--text-label); /* 14px/700 */
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--xs);
  }

  .form-input {
    font-size: var(--text-body); /* 16px/400 */
    font-weight: var(--weight-body);
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) / 2);
    padding: var(--sm) var(--md);
    width: 100%;
    max-width: 480px;
    box-sizing: border-box;
  }

  .form-input:focus {
    border: 2px solid var(--primary);
  }
  .form-input:focus:not(:focus-visible) {
    outline: none;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-submit {
    font-size: var(--text-body); /* 16px/700 */
    font-weight: var(--weight-strong);
    background: var(--primary);
    color: var(--card);
    padding: var(--sm) var(--xl);
    border: none;
    border-radius: calc(var(--radius) / 2);
    min-height: 44px; /* WCAG touch target */
    cursor: pointer;
    align-self: flex-start;
  }

  .form-submit:hover {
    /* darken var(--primary) ~10% — token-derived per UI-SPEC hover state */
    background: color-mix(in srgb, var(--primary) 90%, black);
  }
</style>
