---
/**
 * MapPlaceholderSlot — Live-map call-to-action card.
 * Replaces the former "coming soon" placeholder (TD-02).
 *
 * Renders a static link to /map/ (EN) or /es/mapa/ (ES) so the six
 * editorial templates (region, crime, crime-ranking × EN/ES) point users
 * to the live interactive map. Zero client:* directives — stays static HTML.
 */
import { EN_STRINGS, ES_STRINGS } from '../config/i18n.ts';

interface Props {
  mountType: 'commune-map' | 'region-map' | 'crime-type-map';
  locale: 'en' | 'es';
}

const { mountType, locale } = Astro.props;
const t = locale === 'en' ? EN_STRINGS : ES_STRINGS;

const mapUrl = locale === 'en' ? '/map/' : '/es/mapa/';

// Variant-specific min-heights (kept for layout compatibility)
const isFull = mountType === 'commune-map';
const mobileH = isFull ? '320px' : '280px';
const desktopH = isFull ? '480px' : '400px';
---

<div
  class="map-cta-slot"
  style={`--mobile-h:${mobileH};--desktop-h:${desktopH}`}
>
  <div class="map-cta-inner">
    <!-- Map pin glyph -->
    <svg
      width="40"
      height="40"
      viewBox="0 0 22 22"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      class="map-pin-glyph"
    >
      <circle cx="11" cy="9" r="5" fill="var(--muted)" />
      <ellipse cx="11" cy="9" rx="2" ry="2" fill="white" />
      <path d="M11 14 Q7 18 11 22 Q15 18 11 14Z" fill="var(--muted)" />
    </svg>
    <a href={mapUrl} class="map-cta-link">{t.map_cta_label}</a>
  </div>
</div>

<style>
  .map-cta-slot {
    min-height: var(--mobile-h, 320px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--xl) 0;
  }

  @media (min-width: 1024px) {
    .map-cta-slot {
      min-height: var(--desktop-h, 480px);
    }
  }

  .map-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--md);
    padding: var(--xl);
  }

  .map-pin-glyph {
    opacity: 0.4;
  }

  .map-cta-link {
    font-size: var(--text-label);
    font-weight: var(--weight-body);
    color: var(--accent);
    text-decoration: underline;
    text-align: center;
  }

  .map-cta-link:hover {
    text-decoration: none;
  }
</style>
