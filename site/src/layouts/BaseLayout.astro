---
/**
 * BaseLayout — head meta + hreflang + canonical + PWA meta + JSON-LD slot.
 * Wraps every page with PageHeader and PageFooter.
 *
 * SEO-01: Injects reciprocal hreflang (en / es / x-default) and self-canonical
 * on every page from the central enPath/esPath props (never per-page frontmatter).
 *
 * JSON-LD: Use JSON.stringify() via set:html — never raw string interpolation
 * (RESEARCH XSS note lines 794-798).
 */
import '../styles/global.css';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';

interface Props {
  lang: 'en' | 'es';
  title: string;
  description: string;
  enPath: string;
  esPath: string;
  jsonLd?: object | object[] | null;
  mountType?: string;
  pageType?: 'home' | 'commune' | 'region' | 'crime' | 'ranking' | 'editorial';
}

const {
  lang,
  title,
  description,
  enPath,
  esPath,
  jsonLd = null,
  pageType = 'default',
} = Astro.props;

const BASE_URL = 'https://ischilesafe.com';
const canonicalPath = lang === 'en' ? enPath : esPath;

const OG_IMAGE_BY_TYPE: Record<string, string> = {
  home: '/og/home.png',
  commune: '/og/commune.png',
  region: '/og/region.png',
  crime: '/og/crime.png',
  ranking: '/og/ranking.png',
  editorial: '/og/editorial.png',
  default: '/og/default.png',
};
const ogImage = `${BASE_URL}${OG_IMAGE_BY_TYPE[pageType] ?? OG_IMAGE_BY_TYPE.default}`;
const ogType = pageType === 'editorial' ? 'article' : 'website';
const ogLocale    = lang === 'en' ? 'en_US' : 'es_CL';
const ogLocaleAlt = lang === 'en' ? 'es_CL' : 'en_US';

// AdSense loader gate (D-12): inject async script only when flag is explicitly 'true'.
// Default (ADSENSE_ENABLED unset) emits nothing — no Google request, no ad markup in Phase 4.
const adsenseEnabled = import.meta.env.ADSENSE_ENABLED === 'true';
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID ?? '';

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- hreflang: en / es / x-default (SEO-01 reciprocal alternates) -->
    <link rel="alternate" hreflang="en" href={`${BASE_URL}${enPath}`} />
    <link rel="alternate" hreflang="es" href={`${BASE_URL}${esPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${BASE_URL}${enPath}`} />
    <link rel="canonical" href={`${BASE_URL}${canonicalPath}`} />

    <!-- OpenGraph + Twitter Card (RSEO-01) -->
    <meta property="og:site_name" content="Chile Safety Map" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={`${BASE_URL}${canonicalPath}`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- PWA meta -->
    <meta name="theme-color" content="#0f766e" />
    <link rel="manifest" href="/manifest.json" />

    <!-- AdSense async loader (D-12): single load point, gated by ADSENSE_ENABLED build flag.
         CookieConsent banner is injected by EditorialLayout (Plan 03), not here. -->
    {adsenseEnabled && adsenseClient && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
    )}

    <!-- Schema.org JSON-LD (JSON.stringify for XSS safety; escape </ to prevent
         </script> breakout if any value contains the sequence — CR-01 fix) -->
    {jsonLd !== null && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/<\//g, '<\\/')} />
    )}
  </head>
  <body>
    <PageHeader locale={lang} enPath={enPath} esPath={esPath} />
    <main class="page-content">
      <slot />
    </main>
    <PageFooter locale={lang} enPath={enPath} esPath={esPath} />
  </body>
</html>
