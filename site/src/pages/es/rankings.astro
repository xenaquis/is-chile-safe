---
/**
 * /es/rankings/ — hub ES de rankings (IA-03, D-12).
 * Rankings v2: la lista de enlaces de texto pasa a RankingHub.astro (8 tarjetas
 * con la media nacional y la comuna a la cabeza de cada ranking).
 * El ItemList ahora apunta a las páginas de ranking, que antes no se enlazaban
 * desde ninguna parte del hub.
 */
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import RankingHub from '../../components/RankingHub.astro';
import { RANKING_DEFS, rankingPath } from '../../config/rankingStrings.ts';
import { FAMILY_LABELS_ES } from '../../lib/familyDefs';
import { buildItemList } from '../../lib/jsonld.ts';

// URLs ES hardcoded — nunca getRelativeLocaleUrl (i18n-localized-slug-pitfall)
const rankingLinks = [
  { name: 'Comunas con menor incidencia delictiva reportada en Chile', url: 'https://ischilesafe.com/es/comunas-mas-seguras-chile/' },
  { name: 'Ver las 346 comunas', url: 'https://ischilesafe.com/es/comunas/' },
  ...RANKING_DEFS.map((def) => ({
    name: `${FAMILY_LABELS_ES[def.familyKey] ?? def.familyKey} — ranking nacional por comuna`,
    url: `https://ischilesafe.com${rankingPath(def, 'es')}`,
  })),
];
const rankingItemList = buildItemList(rankingLinks, 'es', { order: 'Unordered', urlMode: 'full' });
---

<EditorialLayout
  lang="es"
  title="Rankings de Incidencia Delictiva — Chile | Chile Safety Map"
  description="Explora rankings de incidencia delictiva reportada por comuna, tipo de delito y región en Chile. Datos: estadísticas policiales oficiales CEAD."
  enPath="/rankings/"
  esPath="/es/rankings/"
  pageType="ranking"
  jsonLd={[rankingItemList]}
>
  <RankingHub lang="es" />
</EditorialLayout>
