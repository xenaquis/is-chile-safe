---
/**
 * ES commune page — /es/comuna/{slug}/
 *
 * IDENTICAL getStaticPaths rollout gate as EN route — guarantees hreflang
 * reciprocity (Pitfall 2): both locales always build the same 12 communes.
 *
 * vs-national and vs-regional computed against per-capita MEANS:
 *   loadNationalAverage() and loadRegionalAverage(region_id)
 * NEVER against loadNational()/loadRegion() series rate (pop-weighted incidence,
 * not the unweighted commune-mean these comparisons need — Pitfall 1).
 *
 * Zero client:* directives (D-09). All components are static .astro.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LevelChip from '../../../components/LevelChip.astro';
import TrendChip from '../../../components/TrendChip.astro';
import StatCard from '../../../components/StatCard.astro';
import Sparkline from '../../../components/Sparkline.astro';
import ComparisonCallout from '../../../components/ComparisonCallout.astro';
import FamilyBreakdownBars from '../../../components/FamilyBreakdownBars.astro';
import ComparableCommune from '../../../components/ComparableCommune.astro';
import CommuneRankingTable from '../../../components/CommuneRankingTable.astro';
import { FAMILY_SLUGS } from '../../../config/i18n.ts';
import MethodologyCaveat from '../../../components/MethodologyCaveat.astro';
import {
  loadCommune,
  loadRegion,
  regionFileId,
  loadRolloutCuts,
  loadNationalAverage,
  loadRegionalAverage,
  nearestComparable,
  nearestComparables,
  latestCompleteYearRate,
  loadIndex,
} from '../../../lib/data.ts';
import { buildCommuneProse } from '../../../lib/proseEngine.ts';
import { buildBreadcrumb, buildItemList } from '../../../lib/jsonld.ts';
import { levelForRate } from '../../../lib/colorScale.ts';
import { ES_STRINGS } from '../../../config/i18n.ts';

export async function getStaticPaths() {
  // IDENTICAL rollout gate as EN route — guarantees hreflang parity (Pitfall 2)
  const cuts = loadRolloutCuts();
  return cuts.map((cut) => {
    const meta = loadIndex().find((c) => c.cut === cut);
    return {
      params: { slug: meta?.slug ?? cut },
      props: { cut },
    };
  });
}

// --- Page-level data ---
const { cut } = Astro.props as { cut: string };
const data = loadCommune(cut);
const year = data.latestCompleteYear;
const rate = latestCompleteYearRate(data);

// Dimension 1: vs-national (MEAN, not SUM)
const nationalAvg = loadNationalAverage();
const vsNationalPct = nationalAvg > 0 ? ((rate - nationalAvg) / nationalAvg) * 100 : 0;
const vsNationalDir: 'above' | 'below' = vsNationalPct >= 0 ? 'above' : 'below';

// Dimension 2: vs-regional (MEAN, not SUM)
const regionalAvg = loadRegionalAverage(data.region_id);
const vsRegionalPct = regionalAvg > 0 ? ((rate - regionalAvg) / regionalAvg) * 100 : 0;
const vsRegionalDir: 'above' | 'below' = vsRegionalPct >= 0 ? 'above' : 'below';

// Dimension 4: dominant + secondary family
const seriesEntry = data.series.find((s) => s.year === year && !s.partial);
const byFamily = seriesEntry?.by_family ?? {};

// Dimension 5: comparable commune
const comparable = nearestComparable(cut);

// Slug de región para la ruta de navegación — se resuelve vía el archivo de región,
// NO data.slug (data.slug es el slug de comuna; las páginas de región se generan
// en /es/region/{region.slug}/).
const regionSlug = loadRegion(regionFileId(data.region_id)).slug;

// Compute incidence level (1–5) for LevelChip
const allRates = loadIndex()
  .filter((c) => !c.low_population)
  .map((c) => latestCompleteYearRate(loadCommune(c.cut)))
  .sort((a, b) => a - b);
const level = levelForRate(rate, allRates);

// Region commune count for regional-rank device (#N de M)
// region_id es ahora la región limpia 1–16 (999.1 resuelto, quick-260616-ldi),
// así que el conteo es exacto — sin colisión Tarapacá 11/14 con Aysén/Los Ríos.
const regionCommuneCount = loadIndex().filter(
  (c) => c.region_id === data.region_id
).length;

// Comunas similares en la misma región (D-07)
const similarComunas = nearestComparables(cut, 5);

// Prose (ES)
const prose = buildCommuneProse(data, 'es');

// URLs
const enPath = `/commune/${data.slug}/`;
const esPath = `/es/comuna/${data.slug}/`;

// Meta
const t = ES_STRINGS;
const title = `Incidencia en ${data.name} — Chile Safety Map`;
const description = `Estadísticas CEAD de incidencia delictiva en ${data.name}, ${data.regionName}: tasa reportada, posición nacional, evolución 2005–${year}.`;

// JSON-LD: Dataset + Place (variante en español)
const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': ['Dataset', 'Place'],
  name: `${data.name} — Incidencia Delictiva Reportada`,
  description: `Tasas anuales de incidencia delictiva reportada por 100.000 habitantes para ${data.name}, según datos del CEAD (Centro de Estudios y Análisis del Delito), Chile.`,
  url: `https://ischilesafe.com/es/comuna/${data.slug}/`,
  spatialCoverage: {
    '@type': 'Place',
    name: data.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: data.regionName },
  },
  temporalCoverage: `2005/${year}`,
  measurementTechnique: 'Tasa por 100.000 habitantes, estadísticas policiales oficiales CEAD',
  creator: { '@type': 'Organization', name: 'CEAD — Centro de Estudios y Análisis del Delito' },
};

// BreadcrumbList: espeja la ruta visual 4 niveles Inicio › Comunas › {Región} › {Comuna}
// ES URLs hardcoded — nunca getRelativeLocaleUrl (i18n-localized-slug-pitfall)
const breadcrumb = buildBreadcrumb([
  { name: 'Inicio',        url: 'https://ischilesafe.com/es/' },
  { name: 'Comunas',       url: 'https://ischilesafe.com/es/comunas/' },
  { name: data.regionName, url: `https://ischilesafe.com/es/region/${regionSlug}/` },
  { name: data.name },  // página actual — omite item
]);

// ItemList: "comunas similares" por proximidad — NO es un ranking de seguridad (A1 / T-13-05)
const similarList = buildItemList(similarComunas, 'es', { order: 'Unordered' });

const jsonLd = [jsonLdDataset, breadcrumb, similarList];
---

<BaseLayout
  lang="es"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="commune-map"
  pageType="commune"
>
  <!-- 2. CommuneHero -->
  <section class="commune-hero">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/es/">Inicio</a>
      <span aria-hidden="true"> › </span>
      <a href="/es/comunas/">Comunas</a>
      <span aria-hidden="true"> › </span>
      <a href={`/es/region/${regionSlug}/`}>{data.regionName}</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">{data.name}</span>
    </nav>
    <h1 class="commune-h1">{data.name}</h1>
    <div class="hero-meta">
      <LevelChip level={level} locale="es" />
      <span class="population-note">Población: {data.population.toLocaleString('es-CL')}</span>
    </div>
    {data.low_population && (
      <p class="low-pop-caveat">{t.low_population_caveat}</p>
    )}
  </section>

  <!-- 3. KeyStatsRow -->
  <section class="key-stats-row" aria-label="Estadísticas clave">
    <StatCard
      label={t.rate_label.replace('{year}', String(year))}
      value={Math.round(rate).toLocaleString('es-CL')}
    />
    <StatCard
      label={t.national_rank_label}
      value={`#${data.national_rank} ${t.rank_of} 346`}
    />
    <StatCard
      label={t.regional_rank_label}
      value={`#${data.regional_rank} de ${regionCommuneCount}`}
    />
  </section>

  <!-- 4. SparklineSection -->
  <section class="sparkline-section" aria-label="Evolución anual">
    <h2 class="section-heading">{t.sparkline_heading}</h2>
    <Sparkline series={data.series} activeYear={year} />
    <TrendChip trend={data.trend} locale="es" />
  </section>

  <!-- 5. ComparisonCallouts -->
  <section class="comparison-callouts" aria-label="Comparaciones nacionales y regionales">
    <ComparisonCallout
      pct={vsNationalPct}
      direction={vsNationalDir}
      scope="national"
      locale="es"
    />
    <ComparisonCallout
      pct={vsRegionalPct}
      direction={vsRegionalDir}
      scope="regional"
      locale="es"
    />
  </section>

  <!-- 6. CrimeFamilyBreakdown -->
  <section class="family-breakdown" aria-label="Desglose por familia delictiva">
    <h2 class="section-heading">
      {t.family_breakdown_heading.replace('{year}', String(year))}
    </h2>
    <FamilyBreakdownBars byFamily={byFamily} locale="es" level={level} />
  </section>

  <!-- 6b. Índice Compuesto de Delincuencia (CI-05/CI-06) — superficie estática, sin toggle de mapa -->
  {(() => {
    const COMPOSITE_YEAR = 2024;
    const ci = data.composite_index?.[String(COMPOSITE_YEAR)];
    if (!ci) return null;
    const BAND_ES_PAGE = ['Muy Bajo', 'Bajo', 'Moderado', 'Alto', 'Muy Alto'];
    const bandLabel = BAND_ES_PAGE[ci.level - 1] ?? '';
    return (
      <section class="panel-section composite-index-section" aria-label="Índice Compuesto de Delincuencia">
        <h2 class="section-heading">{t.ci_section_heading}</h2>
        <div>
          <span class="ci-score-big">{Math.round(ci.score)}</span>
          <span class="ci-band-label">{bandLabel}</span>
        </div>
        <div class="ci-rank">
          {t.ci_rank_national.replace('#{rank}', `#${ci.rank}`).replace('{total}', '346')}
          {' · '}
          {t.ci_rank_regional.replace('#{rank}', `#${ci.regional_rank}`).replace('{region}', data.regionName)}
        </div>
        <div class="ci-caveat">{t.ci_caveat_text}</div>
      </section>
    );
  })()}

  <!-- 7. ComparableCommune -->
  <ComparableCommune comparable={comparable} locale="es" />

  <!-- 8. Spoke mapa (D-08) — enlace estático, sin client:* -->
  <section class="map-spoke" aria-label="Ver en el mapa nacional">
    <h2 class="section-heading">{t.map_spoke_heading}</h2>
    <a href={`/es/mapa/?cut=${data.cut}`} class="map-spoke-cta">
      {t.map_spoke_cta.replace('{name}', data.name)}
    </a>
  </section>

  <!-- 8b. Comunas similares en esta región (D-07) -->
  <section class="similar-comunas-spoke" aria-label="Comunas similares en esta región">
    <h2 class="section-heading">{t.similar_communes_heading}</h2>
    <p class="spoke-intro">{t.similar_communes_intro.replace('{region}', data.regionName)}</p>
    <CommuneRankingTable rows={similarComunas} locale="es" />
  </section>

  <!-- 8c. Spoke por tipo de delito (D-10) -->
  <section class="crime-type-spoke" aria-label="Rankings por tipo de delito">
    <h2 class="section-heading">{t.crime_type_heading}</h2>
    <ul class="crime-type-list">
      <li>
        <a href="/es/ranking-delito/homicidios/">ranking de homicidios</a>
      </li>
      {Object.entries(byFamily).filter(([key]) => key !== 'vida').map(([key]) => (
        <li>
          <a href={`/es/delito/${FAMILY_SLUGS[key]?.es ?? key}/`}>
            ranking {FAMILY_SLUGS[key]?.es ?? key}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 9. ProseSummary -->
  <section class="prose-summary" aria-label="Resumen">
    {prose.split('\n\n').map((para) => <p>{para}</p>)}
  </section>

  <!-- 10. MethodologyCaveat -->
  <MethodologyCaveat locale="es" />
</BaseLayout>

<style>
  .commune-hero {
    padding: var(--xl) 0 var(--lg);
  }

  .breadcrumb {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--sm);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .commune-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
    margin-top: var(--sm);
  }

  .population-note {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .low-pop-caveat {
    margin-top: var(--md);
    padding: var(--sm) var(--md);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-label);
    color: var(--muted);
  }

  .key-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--md);
    margin: var(--xl) 0;
  }

  @media (max-width: 600px) {
    .key-stats-row {
      grid-template-columns: 1fr;
    }
  }

  .sparkline-section {
    margin: var(--xl) 0;
  }

  .section-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--md);
  }

  .comparison-callouts {
    display: flex;
    gap: var(--md);
    flex-wrap: wrap;
    margin: var(--xl) 0;
  }

  .family-breakdown {
    margin: var(--xl) 0;
  }

  .map-spoke {
    margin: var(--xl) 0;
  }

  .map-spoke-cta {
    display: inline-block;
    padding: var(--sm) var(--md);
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    border-radius: var(--radius);
    font-size: var(--text-body);
  }

  .map-spoke-cta:hover {
    opacity: 0.9;
  }

  .similar-comunas-spoke {
    margin: var(--xl) 0;
  }

  .spoke-intro {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--md);
  }

  .crime-type-spoke {
    margin: var(--xl) 0;
  }

  .crime-type-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sm);
  }

  .crime-type-list li a {
    display: inline-block;
    padding: var(--xs) var(--sm);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-label);
    color: var(--primary);
    text-decoration: none;
    text-transform: capitalize;
  }

  .crime-type-list li a:hover {
    background: var(--bg);
  }

  .prose-summary {
    margin: var(--2xl) 0;
    max-width: 72ch;
  }

  .prose-summary p {
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: var(--md);
  }

  /* Phase 18-04: composite index section */
  .composite-index-section {
    margin: var(--xl) 0;
    padding: var(--md);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .ci-score-big {
    font-size: 28px;
    font-weight: 700;
    color: var(--ink);
    margin-right: 8px;
  }

  .ci-band-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
  }

  .ci-rank {
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
    margin-top: 4px;
  }

  .ci-caveat {
    background: var(--bg);
    border: 1px solid var(--line);
    border-left: 3px solid var(--primary);
    padding: 8px 16px;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
    border-radius: 3px;
  }
</style>
