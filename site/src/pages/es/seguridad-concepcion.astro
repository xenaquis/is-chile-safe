---
/**
 * /es/seguridad-concepcion/ — ES counterpart for /concepcion-safety/
 *
 * Stub page for hreflang reciprocity (Plan 04-04 Task 3).
 * Full editorial content will be authored in Plan 06 (ES editorial pages).
 *
 * HREFLANG PAIR: enPath=/concepcion-safety/ <-> esPath=/es/seguridad-concepcion/
 */
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import DataCallout from '../../components/DataCallout.astro';
import { loadCommune, loadNationalAverage, latestCompleteYearRate } from '../../lib/data.ts';

const concepcion = loadCommune('8101');
const year = concepcion.latestCompleteYear;
const rate = latestCompleteYearRate(concepcion);
const nationalAvg = loadNationalAverage();
---

<EditorialLayout
  lang="es"
  title="Seguridad en Concepción — Datos CEAD — Chile Safety Map"
  description="Estadísticas oficiales CEAD de delitos para la comuna de Concepción. Tasa de delitos reportados, tendencia y comparación nacional."
  enPath="/concepcion-safety/"
  esPath="/es/seguridad-concepcion/"
>
  <section>
    <h1>Seguridad en Concepción: datos CEAD para la segunda ciudad de Chile</h1>
    <p>
      Concepción es la segunda área metropolitana de Chile y capital de la Región del Biobío.
      Es un importante centro universitario, industrial y de transporte. Esta página reporta
      lo que muestran los datos oficiales del CEAD para la comuna de Concepción en {year}.
    </p>

    <DataCallout
      value={`${Math.round(rate).toLocaleString('es-CL')} por 100k`}
      label={`Tasa de delitos reportados en Concepción — CEAD ${year}`}
      source="Fuente: CEAD (Centro de Estudios y Análisis del Delito)"
      locale="es"
    />

    <DataCallout
      value={`${Math.round(nationalAvg).toLocaleString('es-CL')} por 100k`}
      label={`Promedio nacional de delitos reportados — CEAD ${year}`}
      source="Fuente: CEAD — media simple de comunas no de baja población"
      locale="es"
    />

    <p>
      El contenido editorial completo en español para Concepción, incluyendo análisis por
      tipo de delito, zona universitaria, Gran Concepción y comparaciones regionales,
      estará disponible próximamente.
    </p>
    <p>
      <a href="/concepcion-safety/">Ver versión en inglés</a> &middot;
      <a href="/commune/concepcion/">Ficha detallada de la comuna</a>
    </p>
  </section>
</EditorialLayout>

<style>
  section {
    margin-bottom: var(--2xl);
  }

  p + p {
    margin-top: var(--md);
  }

  a {
    color: var(--primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
