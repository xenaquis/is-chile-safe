---
/**
 * ES region page — /es/region/{slug}/
 *
 * Mirrors EN region page. Builds all 16 regions — NOT rollout-gated (D-26).
 * Zero client:* directives (D-09). All components are static .astro.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatCard from '../../../components/StatCard.astro';
import Sparkline from '../../../components/Sparkline.astro';
import CommuneRankingTable from '../../../components/CommuneRankingTable.astro';
import MapPlaceholderSlot from '../../../components/MapPlaceholderSlot.astro';
import MethodologyCaveat from '../../../components/MethodologyCaveat.astro';
import {
  loadRegion,
  loadIndex,
  loadCommune,
  loadNationalAverage,
  loadNational,
  latestCompleteYearRate,
} from '../../../lib/data.ts';
import { regionNameEs } from '../../../config/i18n.ts';
import { buildBreadcrumb, buildItemList } from '../../../lib/jsonld.ts';

export async function getStaticPaths() {
  const paths = [];
  for (let i = 1; i <= 16; i++) {
    const region = loadRegion(String(i));
    paths.push({
      params: { slug: region.slug },
      props: { regionFileId: String(i) },
    });
  }
  return paths;
}

// --- Page-level data ---
const { regionFileId } = Astro.props as { regionFileId: string };
const region = loadRegion(regionFileId);
// Grammatical ES region phrase ("Región Metropolitana", "Región del Biobío",
// "Región de Tarapacá"...) — never the literal "Región de {name}" (F-006).
const regionFull = regionNameEs(region.name);

// Latest complete year from regional series.
// Region series may be empty (region JSON generated without series data) — fall back
// to national data's latest complete year in that case (Rule 1 auto-fix: 02-06).
const _regionSeriesYear = region.series
  .filter((s) => !s.partial)
  .reduce((max, s) => Math.max(max, s.year), 0);

const _nationalFallbackYear = _regionSeriesYear === 0
  ? loadNational().series.filter((s) => !s.partial).reduce((max, s) => Math.max(max, s.year), 0)
  : 0;

const latestCompleteYear = _regionSeriesYear > 0 ? _regionSeriesYear : _nationalFallbackYear;

// Aggregate population + commune count from index
const index = loadIndex();
// region_id is the clean 1–16 region (999.1 resolved, quick-260616-ldi) —
// direct equality to this region file (no province-code remapping needed).
const regionCommunes = index.filter((c) => c.region_id === regionFileId);

const aggregatePopulation = regionCommunes.reduce((sum, c) => sum + c.population, 0);
const communeCount = regionCommunes.length;

// Load commune data for ranking table
const rankingRows = regionCommunes.map((c) => {
  const data = loadCommune(c.cut);
  const rate = latestCompleteYearRate(data);
  // Build ratesByYear: complete-year keys only (partial===true excluded — D-3)
  const ratesByYear: Record<number, number> = {};
  data.series.filter((s) => !s.partial).forEach((s) => {
    ratesByYear[s.year] = s.rate_per_100k;
  });
  return {
    name: c.name,
    slug: c.slug,
    rate,
    national_rank: data.national_rank,
    trend: data.trend,
    low_population: c.low_population,
    ratesByYear,
  };
});

// Sort by rate descending
rankingRows.sort((a, b) => b.rate - a.rate);

// National position among 16 regions
const allRegionRates: number[] = [];
for (let i = 1; i <= 16; i++) {
  const regCommunes = index.filter((c) => c.region_id === String(i));
  const eligible = regCommunes.filter((c) => !c.low_population);
  if (eligible.length === 0) {
    allRegionRates.push(0);
    continue;
  }
  const rates = eligible.map((c) => latestCompleteYearRate(loadCommune(c.cut)));
  allRegionRates.push(rates.reduce((s, r) => s + r, 0) / rates.length);
}

const thisRegionEligible = regionCommunes.filter((c) => !c.low_population);
const thisRegionRate =
  thisRegionEligible.length > 0
    ? thisRegionEligible
        .map((c) => latestCompleteYearRate(loadCommune(c.cut)))
        .reduce((s, r) => s + r, 0) / thisRegionEligible.length
    : 0;

const nationalPosition = allRegionRates.filter((r) => r > thisRegionRate).length + 1;
const nationalAvg = loadNationalAverage();

// URLs
const enPath = `/region/${region.slug}/`;
const esPath = `/es/region/${region.slug}/`;

// Meta
const title = `${regionFull} — Datos de Incidencia Delictiva — Chile Safety Map`;
const description = `Estadísticas CEAD de incidencia delictiva para la ${regionFull}: tasa reportada, ranking de comunas, evolución anual 2005–${latestCompleteYear}.`;

// JSON-LD: Dataset + Place
const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': ['Dataset', 'Place'],
  name: `${regionFull} — Incidencia Delictiva Reportada`,
  description: `Tasas anuales de incidencia delictiva reportada por 100.000 habitantes para la ${regionFull}, fuente CEAD (Centro de Estudios y Análisis del Delito), Chile.`,
  url: `https://ischilesafe.com/es/region/${region.slug}/`,
  spatialCoverage: {
    '@type': 'AdministrativeArea',
    name: regionFull,
    containedInPlace: { '@type': 'Country', name: 'Chile' },
  },
  temporalCoverage: `2005/${latestCompleteYear}`,
  measurementTechnique: 'Tasa por 100.000 habitantes, estadísticas policiales oficiales CEAD',
  creator: {
    '@type': 'Organization',
    name: 'CEAD — Centro de Estudios y Análisis del Delito',
  },
};

// BreadcrumbList: espeja la ruta visual 2 niveles Inicio › Regiones (A2 espejo estricto)
// URLs ES hardcoded — nunca getRelativeLocaleUrl (i18n-localized-slug-pitfall)
const breadcrumb = buildBreadcrumb([
  { name: 'Inicio', url: 'https://ischilesafe.com/es/' },
  { name: 'Regiones' },  // página actual — omite item
]);

// ItemList: comunas de la región por incidencia reportada descendente (D-06)
const ranking = buildItemList(rankingRows, 'es', {
  name: `Comunas de ${regionFull} por incidencia reportada CEAD (descendente)`,
  order: 'Descending',
});

const jsonLd = [jsonLdDataset, breadcrumb, ranking];
---

<BaseLayout
  lang="es"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="region-map"
  pageType="region"
>
  <!-- 2. RegionHero -->
  <section class="region-hero">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/es/">Inicio</a>
      <span aria-hidden="true"> › </span>
      <span>Regiones</span>
    </nav>
    <h1 class="region-h1">{regionFull} — Panorama de Incidencia Delictiva</h1>
    <div class="hero-meta">
      <span class="hero-stat">Población: {aggregatePopulation.toLocaleString('es-CL')}</span>
      <span class="hero-sep" aria-hidden="true">·</span>
      <span class="hero-stat">{communeCount} comunas</span>
    </div>
  </section>

  <!-- 3. RegionKeyStats -->
  <section class="key-stats-row" aria-label="Estadísticas clave">
    <StatCard
      label={`Tasa promedio por 100.000 hab. (${latestCompleteYear})`}
      value={Math.round(thisRegionRate).toLocaleString('es-CL')}
    />
    <StatCard
      label="Posición nacional (entre 16 regiones)"
      value={`#${nationalPosition} de 16`}
      sublabel="(1 = mayor incidencia reportada)"
    />
    <StatCard
      label="Promedio nacional"
      value={Math.round(nationalAvg).toLocaleString('es-CL')}
    />
  </section>

  <!-- 4. RegionSparkline -->
  <section class="sparkline-section" aria-label="Evolución anual">
    <h2 class="section-heading">Evolución anual (2005–2026*)</h2>
    <Sparkline series={region.series} activeYear={latestCompleteYear} />
    <p class="chart-footnote">* 2026: año parcial (ene–jun)</p>
  </section>

  <!-- 5. CommuneRankingTable -->
  <section class="ranking-section" aria-label="Ranking de comunas">
    <h2 class="section-heading">
      Comunas de {region.name} — por tasa de incidencia reportada ({latestCompleteYear})
    </h2>
    <CommuneRankingTable rows={rankingRows} locale="es" />
  </section>

  <!-- 6. MapPlaceholderSlot — región con CTA específica -->
  <div class="map-placeholder-card-wrap">
    <a href={`/es/mapa/?region=${region.slug}`} class="map-placeholder-card">
      <svg width="40" height="40" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="map-pin-glyph">
        <circle cx="11" cy="9" r="5" fill="var(--primary)" />
        <ellipse cx="11" cy="9" rx="2" ry="2" fill="white" />
        <path d="M11 14 Q7 18 11 22 Q15 18 11 14Z" fill="var(--primary)" />
      </svg>
      <span>Ver mapa interactivo →</span>
    </a>
  </div>

  <!-- 7. MethodologyCaveat -->
  <MethodologyCaveat locale="es" />
</BaseLayout>

<style>
  .region-hero {
    padding: var(--xl) 0 var(--lg);
  }

  .breadcrumb {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--sm);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .region-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
    margin-top: var(--sm);
  }

  .hero-stat {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .hero-sep {
    color: var(--line);
  }

  .key-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--md);
    margin: var(--xl) 0;
  }

  @media (max-width: 600px) {
    .key-stats-row {
      grid-template-columns: 1fr;
    }
  }

  .sparkline-section {
    margin: var(--xl) 0;
  }

  .section-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--md);
  }

  .ranking-section {
    margin: var(--xl) 0;
  }

  .rollout-note {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .chart-footnote {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--xs);
  }

  .map-placeholder-card-wrap {
    margin: var(--xl) 0;
  }

  .map-placeholder-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--md);
    padding: var(--xl);
    min-height: 280px;
    border: 2px dashed var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    text-decoration: none;
    color: var(--primary);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    transition: border-color 0.15s, background 0.15s;
  }

  .map-placeholder-card:hover {
    border-color: var(--primary);
    background: var(--card);
  }

  .map-pin-glyph {
    opacity: 0.7;
  }
</style>
