---
/**
 * ES crime-type page — /es/delito/{family}/
 *
 * Mirror of /crime/[family].astro in Spanish. Builds all 7 crime families — NOT rollout-gated (D-26).
 * getStaticPaths returns translated ES slug params per FAMILY_SLUGS (D-17).
 *
 * Same national ranking computation as EN page: non-low-pop communes sorted by
 * by_family[familyKey] rate at latestCompleteYear descending.
 *
 * Schema.org: Dataset ONLY — no Place (UI-SPEC line 288).
 * Zero client:* directives (D-09).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapPlaceholderSlot from '../../../components/MapPlaceholderSlot.astro';
import MethodologyCaveat from '../../../components/MethodologyCaveat.astro';
import TrendChip from '../../../components/TrendChip.astro';
import {
  loadIndex,
  loadCommune,
  loadCatalog,
  regionFileId,
} from '../../../lib/data.ts';
import { FAMILY_SLUGS, ES_STRINGS } from '../../../config/i18n.ts';
const t = ES_STRINGS;
import { FAMILY_LABELS_ES, FAMILY_DEFS_ES, FAMILY_SCOPE_NOTE_ES } from '../../../lib/familyDefs';
import { buildBreadcrumb, buildItemList } from '../../../lib/jsonld.ts';

export async function getStaticPaths() {
  const catalog = loadCatalog();
  return catalog.family_keys.map((key) => ({
    params: { family: FAMILY_SLUGS[key]!.es },
    props: { familyKey: key },
  }));
}

// --- Page-level data ---
const { familyKey } = Astro.props as { familyKey: string };

const catalog = loadCatalog();
const featured = catalog.families[familyKey]?.featured ?? false;

const index = loadIndex();

// Build national family ranking
type RankRow = {
  name: string;
  slug: string;
  cut: string;
  regionName: string;
  regionFileIdStr: string;
  rate: number;
  trend: 'up' | 'down' | 'stable';
  low_population: boolean;
  nationalRank: number | null;
};

const allRows: Omit<RankRow, 'nationalRank'>[] = [];
// Capturamos el último año completo directamente al iterar las comunas, en lugar
// de re-derivarlo mediante una búsqueda por slug con un fallback fijo (CR-02).
let latestYear = new Date().getFullYear() - 1;
for (const meta of index) {
  const commune = loadCommune(meta.cut);
  if (!meta.low_population) {
    latestYear = Math.max(latestYear, commune.latestCompleteYear);
  }
  const entry = commune.series.find(
    (s) => s.year === commune.latestCompleteYear && !s.partial
  );
  const rate = entry?.by_family?.[familyKey] ?? 0;
  allRows.push({
    name: meta.name,
    slug: meta.slug,
    cut: meta.cut,
    regionName: commune.regionName,
    regionFileIdStr: regionFileId(meta.region_id),
    rate,
    trend: commune.trend,
    low_population: meta.low_population,
  });
}

const eligibleRows = allRows.filter((r) => !r.low_population).sort((a, b) => b.rate - a.rate);
const lowPopRows = allRows.filter((r) => r.low_population).sort((a, b) => b.rate - a.rate);

// Asignar rango nacional estable antes de cualquier filtro (CR-01)
let rankCounter = 0;
const rankingRows: RankRow[] = [
  ...eligibleRows.map((row) => ({ ...row, nationalRank: ++rankCounter })),
  ...lowPopRows.map((row) => ({ ...row, nationalRank: null })),
];

const familyNationalMean =
  eligibleRows.length > 0
    ? eligibleRows.reduce((sum, r) => sum + r.rate, 0) / eligibleRows.length
    : 0;

// Region breakdown
type RegionBreakRow = {
  regionId: string;
  regionName: string;
  rate: number;
};

const regionMap = new Map<string, { name: string; rates: number[] }>();
for (const row of allRows) {
  if (row.low_population) continue;
  const rid = row.regionFileIdStr;
  if (!regionMap.has(rid)) {
    regionMap.set(rid, { name: row.regionName, rates: [] });
  }
  regionMap.get(rid)!.rates.push(row.rate);
}

const regionBreakRows: RegionBreakRow[] = [];
for (const [rid, { name, rates }] of regionMap.entries()) {
  const mean = rates.length > 0 ? rates.reduce((s, r) => s + r, 0) / rates.length : 0;
  regionBreakRows.push({ regionId: rid, regionName: name, rate: mean });
}
regionBreakRows.sort((a, b) => b.rate - a.rate);

const maxRegionRate = Math.max(...regionBreakRows.map((r) => r.rate), 1);

// URL slugs
const enSlug = FAMILY_SLUGS[familyKey]!.en;
const esSlug = FAMILY_SLUGS[familyKey]!.es;
const enPath = `/crime/${enSlug}/`;
const esPath = `/es/delito/${esSlug}/`;

const familyLabel = FAMILY_LABELS_ES[familyKey] ?? familyKey;
const familyDef = FAMILY_DEFS_ES[familyKey] ?? '';
const familyScopeNote = FAMILY_SCOPE_NOTE_ES[familyKey] ?? '';

const title = `${familyLabel} en Chile — Ranking Nacional por Comuna — Chile Safety Map`;
const description = `Compare la tasa de ${familyLabel.toLowerCase()} por 100.000 habitantes en todas las comunas de Chile. Datos oficiales CEAD, con ranking nacional.`;

// Dataset-only JSON-LD (crime-type pages emit Dataset, NOT Place — UI-SPEC line 288)
const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${familyLabel} — Ranking Nacional por Comuna (Chile)`,
  description: `Tasas anuales reportadas de ${familyLabel.toLowerCase()} por 100.000 habitantes para todas las comunas de Chile, según el CEAD (Centro de Estudios y Análisis del Delito).`,
  url: `https://ischilesafe.com${esPath}`,
  spatialCoverage: {
    '@type': 'Country',
    name: 'Chile',
  },
  temporalCoverage: `2005/${latestYear}`,
  measurementTechnique: 'Tasa por 100.000 habitantes, estadísticas policiales oficiales CEAD',
  creator: {
    '@type': 'Organization',
    name: 'CEAD — Centro de Estudios y Análisis del Delito',
  },
};

// BreadcrumbList: espeja la ruta visual 2 niveles Inicio › Tipos de Delito (A2 espejo estricto)
// URLs ES hardcoded — nunca getRelativeLocaleUrl (i18n-localized-slug-pitfall)
const breadcrumb = buildBreadcrumb([
  { name: 'Inicio', url: 'https://ischilesafe.com/es/' },
  { name: 'Tipos de Delito' },  // página actual — omite item
]);

// ItemList: comunas por incidencia de este tipo de delito descendente (D-06)
// Construido desde los mismos rankingRows que mapea la tabla; solo comunas elegibles
const eligibleRankingRows = rankingRows.filter((r) => !r.low_population);
const ranking = buildItemList(eligibleRankingRows, 'es', {
  name: `Comunas por incidencia reportada de ${familyLabel.toLowerCase()} (descendente)`,
  order: 'Descending',
});

const jsonLd = [jsonLdDataset, breadcrumb, ranking];
---

<BaseLayout
  lang="es"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="crime-type-map"
  pageType="crime"
>
  <!-- CrimeTypeHero (ES) -->
  <section class="crime-hero">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/es/">Inicio</a>
      <span aria-hidden="true"> › </span>
      <span>Tipos de Delito</span>
    </nav>
    <h1 class="crime-h1">
      {familyLabel}
      {featured && <span class="featured-badge">Destacado</span>}
    </h1>
    <p class="crime-def">{familyDef}</p>
    {familyScopeNote && <p class="crime-scope-note">{familyScopeNote}</p>}
    <div class="hero-meta">
      <span class="hero-stat">Media nacional: {Math.round(familyNationalMean).toLocaleString('es-CL')} por 100k ({latestYear})</span>
      <span class="hero-sep" aria-hidden="true">·</span>
      <span class="hero-stat">{eligibleRows.length} comunas en ranking</span>
    </div>
  </section>

  <!-- NationalRankingTable (ES) -->
  <section class="ranking-section" aria-label="Ranking nacional de comunas">
    <h2 class="section-heading">
      Comunas ordenadas por tasa de {familyLabel.toLowerCase()} por 100.000 habitantes ({latestYear})
    </h2>
    <div class="table-wrapper">
      <table class="ranking-table">
        <thead>
          <tr>
            <th scope="col">{t.th_rank}</th>
            <th scope="col">{t.th_commune}</th>
            <th scope="col">{t.th_region}</th>
            <th scope="col" class="col-num">{t.th_rate_per_100k}</th>
            <th scope="col">{t.th_trend}</th>
          </tr>
        </thead>
        <tbody>
          {rankingRows.map((row) => (
            <tr class={row.low_population ? 'low-pop' : ''}>
              <td class="col-num col-rank">
                {row.low_population ? '—' : `#${row.nationalRank}`}
              </td>
              <td>
                <a href={`/es/comuna/${row.slug}/`} class="commune-link">
                  {row.name}
                </a>
                {row.low_population && (
                  <sup class="low-pop-marker" title="Población pequeña — la tasa puede presentar alta volatilidad estadística">*</sup>
                )}
              </td>
              <td class="col-region">{row.regionName}</td>
              <td class="col-num">{Math.round(row.rate).toLocaleString('es-CL')}</td>
              <td><TrendChip trend={row.trend} locale="es" /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {rankingRows.some((r) => r.low_population) && (
      <p class="low-pop-footnote">{t.low_pop_footnote}</p>
    )}
  </section>

  <!-- RegionBreakdownBars (ES) -->
  <section class="region-breakdown" aria-label="Desglose regional">
    <h2 class="section-heading">
      Desglose regional — tasa media de {familyLabel.toLowerCase()} por 100.000 habitantes ({latestYear})
    </h2>
    <div class="region-bars">
      {regionBreakRows.map((r) => {
        const widthPct = Math.round((r.rate / maxRegionRate) * 100) + '%';
        return (
          <div class="region-bar-row">
            <span class="region-bar-label">{r.regionName}</span>
            <span class="region-bar-track" aria-hidden="true">
              <span class="region-bar-fill" style={`width:${widthPct}`}></span>
            </span>
            <span class="region-bar-val">{Math.round(r.rate).toLocaleString('es-CL')}</span>
          </div>
        );
      })}
    </div>
  </section>

  <!-- MapPlaceholderSlot (D-13 crime-type-map) -->
  <MapPlaceholderSlot mountType="crime-type-map" locale="es" />

  <!-- MethodologyCaveat -->
  <MethodologyCaveat locale="es" />
</BaseLayout>

<style>
  .crime-hero {
    padding: var(--xl) 0 var(--lg);
  }

  .breadcrumb {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--sm);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .crime-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
    display: flex;
    align-items: center;
    gap: var(--sm);
    flex-wrap: wrap;
  }

  .featured-badge {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    background: var(--primary);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
    vertical-align: middle;
  }

  .crime-def {
    font-size: var(--text-body);
    color: var(--muted);
    margin: var(--sm) 0;
    max-width: 68ch;
  }

  .crime-scope-note {
    font-size: var(--text-label);
    color: var(--muted);
    margin: var(--sm) 0;
    max-width: 68ch;
    padding: var(--sm) var(--md);
    border-left: 3px solid var(--line);
    background: var(--bg);
    border-radius: var(--radius);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
    margin-top: var(--sm);
  }

  .hero-stat {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .hero-sep {
    color: var(--line);
  }

  .ranking-section {
    margin: var(--xl) 0;
  }

  .section-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--md);
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .ranking-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-label);
  }

  .ranking-table thead th {
    background: var(--bg);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--muted);
    padding: var(--sm) var(--md);
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .ranking-table tbody tr {
    border-bottom: 1px solid var(--line);
    background: var(--card);
    transition: background 0.1s;
  }

  .ranking-table tbody tr:last-child {
    border-bottom: none;
  }

  .ranking-table tbody tr:hover {
    background: var(--bg);
  }

  .ranking-table td {
    padding: var(--sm) var(--md);
    color: var(--ink);
    white-space: nowrap;
  }

  .col-num {
    text-align: right;
  }

  .col-rank {
    color: var(--muted);
    width: 4rem;
  }

  .col-region {
    color: var(--muted);
    font-size: var(--text-label);
  }

  .commune-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--weight-strong);
  }

  .commune-link:hover {
    text-decoration: underline;
  }

  .low-pop {
    opacity: 0.75;
  }

  .low-pop-marker {
    color: var(--muted);
    margin-left: 2px;
    font-size: 0.85em;
  }

  .low-pop-footnote {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .rollout-note {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .region-breakdown {
    margin: var(--xl) 0;
  }

  .region-bars {
    display: flex;
    flex-direction: column;
    gap: var(--sm);
  }

  .region-bar-row {
    display: grid;
    grid-template-columns: 14rem 1fr 5rem;
    align-items: center;
    gap: var(--sm);
  }

  .region-bar-label {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .region-bar-track {
    height: 10px;
    background: var(--line);
    border-radius: 5px;
    overflow: hidden;
  }

  .region-bar-fill {
    display: block;
    height: 100%;
    border-radius: 5px;
    background: var(--primary);
  }

  .region-bar-val {
    font-size: var(--text-label);
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 600px) {
    .region-bar-row {
      grid-template-columns: 8rem 1fr 4rem;
    }
  }
</style>
