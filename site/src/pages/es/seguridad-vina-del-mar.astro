---
/**
 * /es/seguridad-vina-del-mar/ — ES counterpart for /vina-del-mar-safety/
 *
 * Stub page for hreflang reciprocity (Plan 04-04 Task 3).
 * Full editorial content will be authored in Plan 06 (ES editorial pages).
 *
 * HREFLANG PAIR: enPath=/vina-del-mar-safety/ <-> esPath=/es/seguridad-vina-del-mar/
 */
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import DataCallout from '../../components/DataCallout.astro';
import { loadCommune, loadNationalAverage, latestCompleteYearRate } from '../../lib/data.ts';

const vina = loadCommune('5109');
const year = vina.latestCompleteYear;
const rate = latestCompleteYearRate(vina);
const nationalAvg = loadNationalAverage();
---

<EditorialLayout
  lang="es"
  title="Seguridad en Viña del Mar — Datos CEAD — Chile Safety Map"
  description="Estadísticas oficiales CEAD de delitos para la comuna de Viña del Mar. Tasa de delitos reportados, tendencia y comparación nacional."
  enPath="/vina-del-mar-safety/"
  esPath="/es/seguridad-vina-del-mar/"
>
  <section>
    <h1>Seguridad en Viña del Mar: datos CEAD para la Ciudad Jardín</h1>
    <p>
      Viña del Mar es el principal balneario de Chile y atrae a millones de visitantes
      durante la temporada estival. Esta página reporta lo que muestran los datos oficiales
      del CEAD para la comuna de Viña del Mar en {year}.
    </p>

    <DataCallout
      value={`${Math.round(rate).toLocaleString('es-CL')} por 100k`}
      label={`Tasa de delitos reportados en Viña del Mar — CEAD ${year}`}
      source="Fuente: CEAD (Centro de Estudios y Análisis del Delito)"
      locale="es"
    />

    <DataCallout
      value={`${Math.round(nationalAvg).toLocaleString('es-CL')} por 100k`}
      label={`Promedio nacional de delitos reportados — CEAD ${year}`}
      source="Fuente: CEAD — media simple de comunas no de baja población"
      locale="es"
    />

    <p>
      El contenido editorial completo en español para Viña del Mar, incluyendo análisis
      estacional, zonas turísticas y contexto provincial, estará disponible próximamente.
    </p>
    <p>
      <a href="/vina-del-mar-safety/">Ver versión en inglés</a> &middot;
      <a href="/commune/vina-del-mar/">Ficha detallada de la comuna</a>
    </p>
  </section>
</EditorialLayout>

<style>
  section {
    margin-bottom: var(--2xl);
  }

  p + p {
    margin-top: var(--md);
  }

  a {
    color: var(--primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
