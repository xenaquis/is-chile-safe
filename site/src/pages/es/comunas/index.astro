---
/**
 * /es/comunas/ — ES comuna directory
 * SSR full 346-link list: A–Z + por-región blocks, both server-rendered.
 * Inline vanilla script filters/toggles existing DOM nodes (SEO-safe, no island).
 * Threat T-11-05: highlight by slicing TRUSTED data-name around match index — never inject raw query.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ES_STRINGS } from '../../../config/i18n.ts';
import { loadIndex, loadCommune, latestCompleteYearRate, loadRegion } from '../../../lib/data.ts';
import { levelForRate, INCIDENCE_COLORS } from '../../../lib/colorScale.ts';

const t = ES_STRINGS;

// Build the full 346-row dataset
const index = loadIndex();

// Compute all non-low-pop rates for quintile thresholds
const allRates = index
  .filter(c => !c.low_population)
  .map(c => latestCompleteYearRate(loadCommune(c.cut)))
  .filter(r => r > 0)
  .sort((a, b) => a - b);

// Enrich each commune with rate + region number + level
const rows = index.map(c => {
  const commune = loadCommune(c.cut);
  const rate = latestCompleteYearRate(commune);
  const region = Math.floor(parseInt(c.cut, 10) / 1000);
  const level = rate > 0 ? levelForRate(rate, allRates) : 3;
  return {
    name: c.name,
    slug: c.slug,
    cut: c.cut,
    low_population: c.low_population,
    rate,
    region,
    level,
  };
});

// Build A–Z grouping (normalize accent for letter key)
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const azSorted = [...rows].sort((a, b) => a.name.localeCompare(b.name, 'es'));
const azGroups: Record<string, typeof rows> = {};
for (const r of azSorted) {
  const letter = norm(r.name)[0]?.toUpperCase() ?? '#';
  (azGroups[letter] = azGroups[letter] ?? []).push(r);
}
const azLetters = Object.keys(azGroups).sort();

// Build by-region grouping (regions 1..16)
const regionGroups: Record<number, typeof rows> = {};
for (const r of rows) {
  (regionGroups[r.region] = regionGroups[r.region] ?? []).push(r);
}
const regionNumbers = Array.from({length: 16}, (_, i) => i + 1).filter(n => regionGroups[n]);
const regionNames: Record<number, string> = {};
for (const n of regionNumbers) {
  try {
    regionNames[n] = loadRegion(String(n)).name;
  } catch {
    regionNames[n] = `Región ${n}`;
  }
}
// Sort communes within each region alphabetically
for (const n of regionNumbers) {
  regionGroups[n].sort((a, b) => a.name.localeCompare(b.name, 'es'));
}

const levelColors = INCIDENCE_COLORS;
---

<BaseLayout
  lang="es"
  title="Las 346 comunas de Chile — Directorio de datos delictivos | Chile Safety Map"
  description="Explora o busca las 346 comunas de Chile con datos de incidencia reportada CEAD. Filtra por nombre o explora las 16 regiones."
  enPath="/communes/"
  esPath="/es/comunas/"
>
  <div class="dir-wrap">
    <h1>{t.dir_title}</h1>
    <p class="dir-lead">{t.dir_lead}</p>

    <div class="toolbar" id="toolbar">
      <div class="toolbar-row">
        <input
          type="search"
          id="q"
          class="dir-search"
          placeholder={t.dir_search_placeholder}
          autocomplete="off"
          aria-label={t.dir_search_placeholder}
        />
        <span class="viewtoggle">
          <button id="vAZ" class="toggle-btn on" type="button">{t.dir_view_az}</button>
          <button id="vReg" class="toggle-btn" type="button">{t.dir_view_region}</button>
        </span>
        <span class="dir-count" id="count">{t.dir_count.replace('{n}', String(rows.length))}</span>
      </div>
      <div class="az-index" id="az-index">
        {azLetters.map(letter => (
          <a href={`#L-${letter}`}>{letter}</a>
        ))}
      </div>
    </div>

    {/* A–Z block — default visible */}
    <div id="block-az">
      {azLetters.map(letter => (
        <div class="section" id={`L-${letter}`}>
          <h2>{letter} <span class="section-cnt">{azGroups[letter].length}</span></h2>
          <div class="clist">
            {azGroups[letter].map(r => (
              <a
                class="citem"
                href={`/es/comuna/${r.slug}/`}
                data-name={r.name}
                data-norm={norm(r.name)}
                data-region={r.region}
              >
                <span
                  class={`lvl-dot lvl-${r.level}`}
                  style={`background:${levelColors[r.level - 1]}`}
                  aria-hidden="true"
                ></span>
                <span class="nm">{r.name}</span>
                {r.low_population && <span class="lowpop">{t.dir_lowpop_tag}</span>}
                <span class="rt">{r.rate > 0 ? `${Math.round(r.rate)}/100k` : '—'}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* Por-región block — hidden by default, shown on toggle */}
    <div id="block-reg" hidden>
      {regionNumbers.map(n => (
        <div class="section" id={`region-${n}`}>
          <h2>{regionNames[n]} <span class="section-cnt">{regionGroups[n].length} comunas</span></h2>
          <div class="clist">
            {regionGroups[n].map(r => (
              <a
                class="citem"
                href={`/es/comuna/${r.slug}/`}
                data-name={r.name}
                data-norm={norm(r.name)}
                data-region={r.region}
              >
                <span
                  class={`lvl-dot lvl-${r.level}`}
                  style={`background:${levelColors[r.level - 1]}`}
                  aria-hidden="true"
                ></span>
                <span class="nm">{r.name}</span>
                {r.low_population && <span class="lowpop">{t.dir_lowpop_tag}</span>}
                <span class="rt">{r.rate > 0 ? `${Math.round(r.rate)}/100k` : '—'}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="empty-msg" hidden class="empty"></div>
  </div>
</BaseLayout>

<script>
// Vanilla inline script — filters/groups/highlights pre-existing DOM nodes.
// NEVER constructs or appends the link list (SEO-safe: links are server-rendered above).
// T-11-05: highlight by slicing TRUSTED data-name around match index — never inject raw query.
(function () {
  const norm = (s: string) =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  let view: 'az' | 'reg' = 'az';
  let q = '';

  const blockAZ = document.getElementById('block-az') as HTMLElement;
  const blockReg = document.getElementById('block-reg') as HTMLElement;
  const azIndex = document.getElementById('az-index') as HTMLElement;
  const countEl = document.getElementById('count') as HTMLElement;
  const emptyEl = document.getElementById('empty-msg') as HTMLElement;
  const input = document.getElementById('q') as HTMLInputElement;
  const btnAZ = document.getElementById('vAZ') as HTMLButtonElement;
  const btnReg = document.getElementById('vReg') as HTMLButtonElement;

  // All citem anchors from BOTH blocks
  const allItems = Array.from(document.querySelectorAll('.citem')) as HTMLAnchorElement[];
  // Deduplicate by href (each slug appears in both A-Z and region blocks)
  const seenHrefs = new Set<string>();
  const uniqueItems = allItems.filter(el => {
    const href = el.getAttribute('href') || '';
    if (seenHrefs.has(href)) return false;
    seenHrefs.add(href);
    return true;
  });

  function highlight(name: string): string {
    if (!q) return name;
    const nq = norm(q);
    const nn = norm(name);
    const i = nn.indexOf(nq);
    if (i < 0) return name;
    // Slice trusted name — never inject q into DOM (T-11-05)
    return (
      name.slice(0, i) +
      '<mark>' +
      name.slice(i, i + q.length) +
      '</mark>' +
      name.slice(i + q.length)
    );
  }

  function applyHighlight(item: HTMLAnchorElement) {
    const nmEl = item.querySelector('.nm') as HTMLElement | null;
    if (!nmEl) return;
    const name = item.getAttribute('data-name') || '';
    nmEl.innerHTML = highlight(name);
  }

  function render() {
    const nq = norm(q);

    // Show/hide items in both blocks based on filter
    allItems.forEach(item => {
      const nn = item.getAttribute('data-norm') || '';
      const matches = !nq || nn.includes(nq);
      item.style.display = matches ? '' : 'none';
      if (matches) {
        applyHighlight(item);
      }
    });

    // Count visible unique items
    let visibleCount = 0;
    uniqueItems.forEach(item => {
      const nn = item.getAttribute('data-norm') || '';
      if (!nq || nn.includes(nq)) visibleCount++;
    });

    // Update count
    countEl.textContent = '{n} de 346 comunas'.replace('{n}', String(visibleCount));

    // Show/hide blocks based on view
    const activeBlock = view === 'az' ? blockAZ : blockReg;
    const otherBlock = view === 'az' ? blockReg : blockAZ;

    activeBlock.removeAttribute('hidden');
    otherBlock.setAttribute('hidden', '');

    // Show/hide A-Z jump index
    azIndex.style.display = view === 'az' ? '' : 'none';

    // Hide sections with no visible items
    activeBlock.querySelectorAll('.section').forEach(section => {
      const visibleInSection = Array.from(section.querySelectorAll('.citem')).some(
        el => (el as HTMLElement).style.display !== 'none'
      );
      (section as HTMLElement).style.display = visibleInSection ? '' : 'none';
    });

    // Show empty message
    if (visibleCount === 0 && q) {
      emptyEl.textContent = 'Sin resultados para "' + q + '".';
      emptyEl.removeAttribute('hidden');
      activeBlock.setAttribute('hidden', '');
    } else {
      emptyEl.setAttribute('hidden', '');
    }
  }

  // Pre-populate search from ?q= URL parameter (T-12-01: assign to input.value only, never innerHTML)
  const initialQ = new URLSearchParams(window.location.search).get('q');
  if (initialQ) {
    q = initialQ;
    input.value = initialQ;
  }

  input.addEventListener('input', e => {
    q = (e.target as HTMLInputElement).value;
    render();
  });

  btnAZ.addEventListener('click', () => {
    view = 'az';
    btnAZ.classList.add('on');
    btnReg.classList.remove('on');
    render();
  });

  btnReg.addEventListener('click', () => {
    view = 'reg';
    btnReg.classList.add('on');
    btnAZ.classList.remove('on');
    render();
  });

  render();
})();
</script>

<style>
  .dir-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--lg);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    margin-bottom: var(--sm);
  }

  .dir-lead {
    color: var(--muted);
    margin-bottom: var(--lg);
    max-width: 680px;
  }

  .toolbar {
    position: sticky;
    top: 64px; /* below header */
    background: var(--bg);
    padding: var(--md) 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--lg);
  }

  .toolbar-row {
    display: flex;
    gap: var(--md);
    align-items: center;
    flex-wrap: wrap;
  }

  .dir-search {
    flex: 1;
    min-width: 200px;
    max-width: 380px;
    padding: 9px 12px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    font-size: var(--text-label);
    font-family: inherit;
    background: var(--card);
    color: var(--ink);
  }

  .dir-search:focus {
    outline: none;
    border-color: var(--primary);
  }

  .viewtoggle {
    display: flex;
    gap: 4px;
  }

  .toggle-btn {
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: var(--weight-strong);
    cursor: pointer;
    font-family: inherit;
    font-size: var(--text-label);
    color: var(--ink);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .toggle-btn.on {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .dir-count {
    color: var(--muted);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    margin-left: auto;
  }

  .az-index {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: var(--sm);
  }

  .az-index a {
    font-weight: var(--weight-strong);
    font-size: 13px;
    padding: 3px 7px;
    border-radius: 6px;
    color: var(--primary);
    text-decoration: none;
  }

  .az-index a:hover {
    background: var(--bg);
    text-decoration: underline;
  }

  .section {
    margin-top: var(--lg);
  }

  .section h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-bottom: 2px solid var(--primary);
    padding-bottom: 6px;
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    margin-bottom: var(--sm);
  }

  .section-cnt {
    font-size: 13px;
    color: var(--muted);
    font-weight: 400;
  }

  .clist {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 6px;
    margin-top: var(--sm);
  }

  .citem {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.12s, background 0.12s;
  }

  .citem:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 5%, var(--card));
  }

  .lvl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nm {
    font-weight: var(--weight-strong);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lowpop {
    font-size: 10px;
    background: var(--line);
    color: var(--muted);
    border-radius: 4px;
    padding: 1px 5px;
    flex-shrink: 0;
  }

  .rt {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .empty {
    color: var(--muted);
    padding: var(--xl);
    text-align: center;
    font-size: var(--text-body);
  }

  mark {
    background: #ffe9a8;
    padding: 0 1px;
  }
</style>
