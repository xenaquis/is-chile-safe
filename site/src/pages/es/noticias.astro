---
/**
 * /es/noticias/ — ES news page parity with /news/ (NEWS-04).
 *
 * Incidentes recientes de noticias chilenas, geolocalizados por comuna.
 * Cada entrada enlaza al artículo fuente y a la página de la comuna.
 * Tono sobrio: siempre atribuir fuente; sin veredictos absolutos de seguridad/peligro.
 *
 * hreflang: /es/noticias/ <-> /news/
 * Pitfall 4: existsSync fallback — build no falla si current.json está ausente.
 * Pitfall slug: esPath hardcodeado — NUNCA getRelativeLocaleUrl para este slug.
 * P1-6: estructura semántica h2/h3, secciones por mes, chips de tipo + comuna (paridad con /news/).
 *
 * Pasada de UX (NEWSUX): los 28 controles apilados de la barra de filtros pasan a
 * tres gestos — histograma de días, desplegable de región, chips de tipo con color —
 * y las tarjetas con borde pasan a filas densas en columnas fijas. Restricciones que
 * ESTA página debe respetar (scripts/validate/facets.mjs):
 *   - assertion 12: un <article class="news-card"> por incidente; jamás `hidden` en
 *     servidor; y NINGUNA regla CSS cuyo selector contenga `.news-card` puede fijar
 *     `display` (defeatearía el [hidden] del UA). Por eso el grid de la fila vive en
 *     `.news-row`, un hijo, y `.news-card` solo lleva padding/borde.
 *   - assertion 18: ids news-filters / news-comuna-q / news-result-count /
 *     news-clear-filters; fieldsets data-facet="window|region|family"; region y
 *     family DEBEN contener <input type="checkbox"> — por eso la región es un
 *     <details> desplegable sobre los mismos checkboxes y NO un <select>. Además solo
 *     puede existir UN data-result-count-template y ningún {n}/{date} sin sustituir,
 *     por eso el pie del histograma se sustituye aquí, en build.
 *   - assertion 11: todo toLocaleDateString con opción `month:` lleva timeZone:'UTC'.
 */
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { loadIndex, loadRegion, regionFileId } from '../../lib/data';
import { FAMILY_LABELS_ES } from '../../lib/familyDefs';
import { computeNewsFacets, escapeForInlineScript } from '../../lib/newsFacets';
import { computeDayBuckets, peakBucket } from '../../lib/newsDayFacets';
import { norm, FILTER_LOGIC_MARKER } from '../../lib/newsFilterLogic';
import { ES_STRINGS, regionNameEs } from '../../config/i18n.ts';

const t = ES_STRINGS;

// Resolve from the synced public copy via process.cwd() (= site/ during `astro build`).
// import.meta.url is unreliable at build time — compiled chunk locations differ per page,
// which previously made EN resolve to a missing path and render empty (bilingual drift).
const dataPath = path.resolve(process.cwd(), 'public/data/incidents/current.json');

let generated: string | null = null;
let incidents: Array<{
  id: string;
  title_es: string;
  title_en: string;
  date: string;
  outlet: string;
  url: string;
  slug?: string;
  cut?: string | number;
  family?: string;
}> = [];

if (existsSync(dataPath)) {
  try {
    const raw = JSON.parse(readFileSync(dataPath, 'utf-8'));
    generated = raw.generated ?? null;
    incidents = raw.incidents ?? [];
  } catch {
    // JSON malformado — fallback vacío
  }
}

// Formato de fecha para mostrar
let formattedDate = '';
if (generated) {
  try {
    formattedDate = new Date(generated).toLocaleDateString('es-CL', {
      timeZone: 'UTC',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    formattedDate = generated.slice(0, 10);
  }
}

// Lookup CUT → comuna {name, slug} desde loadIndex() en build time (paridad con /news/)
const _index = loadIndex();
const cutToCommune = new Map<string, { name: string; slug: string }>(
  _index.map((c) => [c.cut, { name: c.name, slug: c.slug }])
);
const slugToCommune = new Map<string, { name: string; slug: string }>(
  _index.map((c) => [c.slug, { name: c.name, slug: c.slug }])
);
// CUT → region_id, para los data-region-id de cada card (espeja el mapa interno de newsFacets.ts)
const cutToRegion = new Map<string, string>(_index.map((c) => [c.cut, c.region_id]));

// Resolver comuna del incidente (cut prima sobre slug; cut puede venir numérico)
function getCommuneInfo(incident: { cut?: string | number; slug?: string }): { name: string; slug: string } | undefined {
  if (incident.cut != null) return cutToCommune.get(String(incident.cut));
  if (incident.slug) return slugToCommune.get(incident.slug);
  return undefined;
}

// Label localizado de familia desde el mapa canónico; fallback capitalizado
function familyLabel(family: string): string {
  return FAMILY_LABELS_ES[family] ?? family.charAt(0).toUpperCase() + family.slice(1);
}

// Formatear YYYY-MM como "mes de YYYY" para los h2 de grupo
function formatMonth(yearMonth: string): string {
  if (!yearMonth || yearMonth.length < 7) return yearMonth;
  const [year, month] = yearMonth.split('-');
  const y = parseInt(year, 10);
  const m = parseInt(month, 10);
  if (isNaN(y) || isNaN(m)) return yearMonth;
  const d = new Date(Date.UTC(y, m - 1, 1));
  return d.toLocaleDateString('es-CL', { timeZone: 'UTC', year: 'numeric', month: 'long' });
}

// Etiqueta corta de día ("5 ago") para la columna de fecha, el eje del histograma y
// los títulos de barra. Memoizada: son ~1.500 incidentes sobre ~30 fechas distintas,
// así que sin caché se pagarían ~1.500 formateos de Intl en cada build.
// assertion 11: `month:` obliga a timeZone: 'UTC' (sin esto un lector chileno vería
// la etiqueta desfasada un día).
const dayLabelCache = new Map<string, string>();
function dayLabel(date: string): string {
  const hit = dayLabelCache.get(date);
  if (hit !== undefined) return hit;
  let label: string;
  try {
    label = new Date(date + 'T00:00:00Z').toLocaleDateString('es-CL', {
      timeZone: 'UTC',
      month: 'short',
      day: 'numeric',
    });
  } catch {
    label = date;
  }
  dayLabelCache.set(date, label);
  return label;
}

// Ordenar más recientes primero (TD-03)
incidents.sort((a, b) => b.date.localeCompare(a.date));

// Agrupar por YYYY-MM (build time, cero JS en cliente)
const monthGroups = new Map<string, typeof incidents>();
for (const incident of incidents) {
  const yearMonth = incident.date.slice(0, 7);
  if (!monthGroups.has(yearMonth)) monthGroups.set(yearMonth, []);
  monthGroups.get(yearMonth)!.push(incident);
}

// Helper URL segura — espeja IncidentPinLayer.ts safeUrl() (TD-05, T-19-03)
function safeUrl(url: string): string {
  try {
    const u = new URL(url);
    if (u.protocol === 'http:' || u.protocol === 'https:') {
      return url;
    }
  } catch {
    // URL malformada
  }
  return '#';
}

// Facet index (Phase 27, FACET-01/05/06) — build-time only, inert #news-facets JSON node below.
const archiveDir = path.resolve(process.cwd(), 'public/data/incidents/archive');
// incidents' `cut` is optional (string | number | undefined); IncidentLike requires
// string | number. computeNewsFacets/facets.mjs already guard every lookup with
// `cutToRegion.get(String(inc.cut))`, which safely no-ops on an undefined cut — no
// runtime behavior change, this cast only resolves the type-checker mismatch.
const facets = computeNewsFacets(incidents as unknown as import('../../lib/newsFacets').IncidentLike[], loadIndex(), archiveDir);
const facetsProjection = {
  byFamily: facets.byFamily,
  byRegion: facets.byRegion,
  byMonth: facets.byMonth,
  byWindow: {
    today: facets.byWindow.today.length,
    sevenDay: facets.byWindow.sevenDay.length,
    thirtyDay: facets.byWindow.thirtyDay.length,
  },
  anchorDate: facets.anchorDate,
};

// Histograma por día — anclado a facets.anchorDate (fecha del incidente más nuevo),
// nunca al reloj del build. Serie densa: los días con cero se dibujan igual, porque
// un hueco en la cobertura es información, no ruido a comprimir.
const dayBuckets = computeDayBuckets(incidents.map((i) => i.date), facets.anchorDate);
const peak = peakBucket(dayBuckets);
// F-32 / assertion 18: sustitución en servidor — el HTML indexado no puede contener
// un token {n}/{date} literal fuera del único data-result-count-template.
const peakText = peak
  ? t.news_histogram_peak.replace('{n}', String(peak.count)).replace('{date}', dayLabel(peak.date))
  : '';
const axisFirst = dayBuckets.length > 0 ? dayLabel(dayBuckets[0].date) : '';
const axisMid = dayBuckets.length > 0 ? dayLabel(dayBuckets[Math.floor(dayBuckets.length / 2)].date) : '';
const axisLast = dayBuckets.length > 0 ? dayLabel(dayBuckets[dayBuckets.length - 1].date) : '';

// Nombres de región para la barra de filtros (máx. 16 lookups) — CommuneMeta no
// tiene campo de nombre de región, así que loadRegion(regionFileId(...)).name es
// la única fuente correcta.
const regionNames = new Map<string, string>(
  facets.byRegion.map((r) => [r.regionId, regionNameEs(loadRegion(regionFileId(r.regionId)).name)])
);

// F-32: sustitución server-side — el HTML indexado nunca debe contener un token
// literal {n}/{date}. La fecha ancla se formatea con timeZone: 'UTC' obligatorio
// (sin esto, un lector chileno vería la etiqueta desfasada un día).
const anchorLabel = facets.anchorDate ? dayLabel(facets.anchorDate) : '—';
const resultCountText = t.news_result_count.replace('{n}', String(incidents.length));
const windowLatestText = t.news_window_latest.replace('{date}', anchorLabel);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Noticias de delincuencia en Chile — Incidentes recientes",
  "description": "Incidentes recientes de delincuencia reportados en medios chilenos, geolocalizados por comuna. Cada incidente cita y enlaza su artículo fuente.",
  "url": "https://ischilesafe.com/es/noticias/",
};
---

<EditorialLayout
  lang="es"
  title="Noticias de delincuencia en Chile — Incidentes recientes"
  description="Incidentes recientes de delincuencia reportados en medios chilenos, geolocalizados por comuna. Cada incidente cita y enlaza su artículo fuente."
  enPath="/news/"
  esPath="/es/noticias/"
  jsonLd={jsonLd}
>
  <section>
    <h1>Noticias de delincuencia en Chile — Incidentes recientes</h1>
    <p>
      Esta página presenta incidentes recientes de delincuencia reportados en medios de prensa
      chilenos y geolocalizados por comuna. Cada entrada enlaza al artículo fuente original y
      a la página de la comuna donde se dispone de mayor contexto estadístico CEAD. Los
      incidentes se extraen de feeds RSS y se clasifican mediante pipeline automatizado.
      Se atribuye siempre la fuente; no se emiten veredictos absolutos sobre seguridad.
    </p>
    {generated && (
      <p class="freshness">
        <time datetime={generated}>Actualizado {formattedDate}</time>
      </p>
    )}
  </section>

  {incidents.length > 0 && (
    <details class="news-filter-bar" id="news-filters" open>
      <summary>{t.news_filter_heading}</summary>

      <div class="filter-primary">
        <div class="filter-group filter-group--search" data-facet="comuna-search">
          <label for="news-comuna-q" class="news-sr">{t.news_search_comuna_label}</label>
          <span class="search-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6" />
              <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          <input
            type="search"
            id="news-comuna-q"
            placeholder={t.news_search_comuna_placeholder}
            autocomplete="off"
          />
        </div>

        <details class="filter-dropdown" id="news-region-dropdown">
          <summary>
            <span>{t.news_filter_region_label}</span>
            <span class="dd-count" id="news-region-count"></span>
          </summary>
          <fieldset class="filter-group filter-group--panel" data-facet="region">
            <legend class="news-sr">{t.news_filter_region_label}</legend>
            {facets.byRegion.map((r) => (
              <label class="filter-chip">
                <input type="checkbox" name="region" value={r.regionId} />
                <span class="filter-opt-label">{regionNames.get(r.regionId) ?? r.regionId}</span>
                <span class="filter-count">{r.count}</span>
              </label>
            ))}
          </fieldset>
        </details>

        <fieldset class="filter-group filter-group--presets" data-facet="window">
          <legend class="news-sr">{t.news_filter_window_label}</legend>
          <label class="preset-chip">
            <input type="radio" name="window" value="today" />
            <span class="filter-opt-label">{windowLatestText}</span>
            <span class="filter-count">{facets.byWindow.today.length}</span>
          </label>
          <label class="preset-chip">
            <input type="radio" name="window" value="7d" />
            <span class="filter-opt-label">{t.news_window_7d_label}</span>
            <span class="filter-count">{facets.byWindow.sevenDay.length}</span>
          </label>
          <label class="preset-chip">
            <input type="radio" name="window" value="30d" />
            <span class="filter-opt-label">{t.news_window_30d_label}</span>
            <span class="filter-count">{facets.byWindow.thirtyDay.length}</span>
          </label>
          <label class="preset-chip">
            <input type="radio" name="window" value="" checked />
            <span class="filter-opt-label">{t.news_window_all}</span>
            <span class="filter-count">{incidents.length}</span>
          </label>
        </fieldset>
      </div>

      {dayBuckets.length > 0 && (
        <div class="day-histogram">
          <p class="day-histogram-head">
            <span>{t.news_histogram_label}</span>
            <span class="day-peak">{peakText}</span>
          </p>
          <div class="day-bars" id="news-day-bars" role="group" aria-label={t.news_histogram_label}>
            {dayBuckets.map((b) => (
              <button
                type="button"
                class="day-bar"
                data-day={b.date}
                aria-pressed="false"
                style={`--h:${b.pct}%`}
              >
                <span class="day-bar-fill" aria-hidden="true"></span>
                <span class="news-sr">{dayLabel(b.date)} · {b.count}</span>
              </button>
            ))}
          </div>
          <p class="day-axis" aria-hidden="true">
            <span>{axisFirst}</span>
            <span>{axisMid}</span>
            <span>{axisLast}</span>
          </p>
        </div>
      )}

      <fieldset class="filter-group filter-group--families" data-facet="family">
        <legend class="news-sr">{t.news_filter_family_label}</legend>
        {facets.byFamily.map((f) => (
          <label class="filter-chip filter-chip--family" data-family={f.key}>
            <input type="checkbox" name="family" value={f.key} />
            <span class="fam-dot" title={familyLabel(f.key)} aria-hidden="true"></span>
            <span class="filter-opt-label">{familyLabel(f.key)}</span>
            <span class="filter-count">{f.count}</span>
          </label>
        ))}
      </fieldset>

      <p class="filter-actions">
        <button type="button" id="news-clear-filters">{t.news_clear_filters}</button>
        <span
          id="news-result-count"
          role="status"
          aria-live="polite"
          data-result-count-template={t.news_result_count}
        >
          {resultCountText}
        </span>
      </p>
      <p class="facet-semantics-note" id="news-facet-semantics">{t.news_facet_semantics_note}</p>
    </details>
  )}

  <div id="news-empty" hidden>
    <p>{t.news_empty_heading}</p>
    <p>{t.news_empty_body}</p>
  </div>

  {incidents.length === 0 ? (
    <section>
      <p class="empty-state">Sin incidentes aún. Vuelve pronto.</p>
    </section>
  ) : (
    <div class="news-list">
      <p class="news-list-head" aria-hidden="true">
        <span>{t.news_col_headline}</span>
        <span>{t.news_col_commune}</span>
        <span>{t.news_col_outlet}</span>
        <span>{t.news_col_date}</span>
      </p>
      {Array.from(monthGroups.entries()).map(([yearMonth, groupIncidents]) => (
        <section class="news-month-section" id={'month-' + yearMonth}>
          <h2 class="news-date-group">{formatMonth(yearMonth)}</h2>
          {groupIncidents.map((incident) => {
            const communeInfo = getCommuneInfo(incident);
            const family = incident.family ?? '';
            return (
              <article
                class="news-card"
                data-family={family}
                data-region-id={cutToRegion.get(String(incident.cut)) ?? ''}
                data-year-month={yearMonth}
                data-commune-norm={communeInfo ? norm(communeInfo.name) : ''}
                data-date={incident.date}
              >
                {/* El grid vive aquí, en un hijo: assertion 12 prohíbe que cualquier
                    regla CSS cuyo selector contenga `.news-card` fije `display`. */}
                <div class="news-row" data-family={family}>
                  <h3 class="news-title">
                    <span class="fam-dot" title={family ? familyLabel(family) : ''} aria-hidden="true"></span>
                    <a href={safeUrl(incident.url)} target="_blank" rel="noopener noreferrer">
                      {incident.title_es}
                    </a>
                    {family && <span class="news-sr">{familyLabel(family)}</span>}
                  </h3>
                  <span class="news-commune-chip">
                    {communeInfo && (
                      <a href={'/es/comuna/' + communeInfo.slug + '/'}>{communeInfo.name}</a>
                    )}
                  </span>
                  <span class="news-outlet">{incident.outlet}</span>
                  <time class="news-date" datetime={incident.date}>{dayLabel(incident.date)}</time>
                </div>
              </article>
            );
          })}
        </section>
      ))}
    </div>
  )}
  {/* H-2: set:html no escapa; un `</script>` dentro de un string serializado (p.ej.
      una family envenenada del clasificador LLM) cerraría este elemento antes de
      tiempo y rompería hacia markup — escapar `<` en el borde de serialización. */}
  <script type="application/json" id="news-facets" set:html={escapeForInlineScript(JSON.stringify(facetsProjection))}></script>
  <script>
    import {
      parseFilterParams,
      serializeFilterParams,
      norm,
      cardMatchesFilters,
      computeFacetCounts,
      FILTER_LOGIC_MARKER,
      type FilterParams,
      type CardFilterState,
    } from '../../lib/newsFilterLogic';

    (function () {
      const filtersElMaybe = document.getElementById('news-filters');
      if (!filtersElMaybe) return; // sin incidentes renderizados — nada que conectar
      const filtersEl: HTMLElement = filtersElMaybe;

      filtersEl.setAttribute('data-filter-logic', FILTER_LOGIC_MARKER);

      const facetsBlob = document.getElementById('news-facets');
      let anchorDate: string | null = null;
      try {
        const parsed = JSON.parse(facetsBlob?.textContent || '{}');
        anchorDate = parsed.anchorDate ?? null;
      } catch {
        anchorDate = null;
      }

      const cardEls = Array.from(document.querySelectorAll<HTMLElement>('.news-card'));
      const cards: { el: HTMLElement; state: CardFilterState }[] = cardEls.map((el) => ({
        el,
        state: {
          family: el.getAttribute('data-family') || '',
          regionId: el.getAttribute('data-region-id') || '',
          date: el.getAttribute('data-date') || '',
          communeNorm: el.getAttribute('data-commune-norm') || '',
        },
      }));

      const monthSections = Array.from(
        document.querySelectorAll<HTMLElement>('.news-month-section')
      );

      const resultCountEl = document.getElementById('news-result-count');
      const resultCountTemplate = resultCountEl?.dataset.resultCountTemplate || '{n}';
      const emptyEl = document.getElementById('news-empty');
      const comunaInput = document.getElementById('news-comuna-q') as HTMLInputElement | null;
      const clearBtn = document.getElementById('news-clear-filters');
      const dayBars = Array.from(filtersEl.querySelectorAll<HTMLButtonElement>('.day-bar'));
      const dayKeys = dayBars.map((b) => b.getAttribute('data-day') || '');
      const regionCountEl = document.getElementById('news-region-count');

      let active: FilterParams = parseFilterParams(window.location.search);
      // `day` y `window` son predicados de fecha mutuamente excluyentes (ver los
      // manejadores más abajo, que dan precedencia a `day` sobre `window`). Una
      // URL editada a mano o compartida no debe llegar a un estado que la UI no
      // puede producir ni explicar: normalizar una sola vez, justo tras el parseo.
      if (active.day) active = { ...active, window: '' };
      // Descartar un día fijado que no está en la ventana del histograma
      // renderizado — filtraría a una lista vacía sin ningún bar activo visible.
      if (active.day && !dayKeys.includes(active.day)) active = { ...active, day: '' };

      // Pre-poblar controles desde los params parseados (T-12-01: solo asignación de value, nunca innerHTML)
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
        input.checked = input.value === active.window;
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((input) => {
        input.checked = active.region.includes(input.value);
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach((input) => {
        input.checked = active.family.includes(input.value);
      });
      if (comunaInput && active.q) {
        comunaInput.value = active.q;
      }

      function applyFilters(): void {
        let visibleTotal = 0;

        for (const { el, state } of cards) {
          const matches = cardMatchesFilters(state, active, anchorDate);
          el.hidden = !matches;
          if (matches) visibleTotal++;
        }

        for (const section of monthSections) {
          const visibleInSection = Array.from(
            section.querySelectorAll<HTMLElement>('.news-card')
          ).some((card) => !card.hidden);
          section.hidden = !visibleInSection;
        }

        if (emptyEl) emptyEl.hidden = visibleTotal !== 0;

        if (resultCountEl) {
          resultCountEl.textContent = resultCountTemplate.replace('{n}', String(visibleTotal));
        }

        // Conteos por opción con auto-exclusión F-28, desde los data-* de cada card (F-29)
        const windowKeys = ['today', '7d', '30d'];
        const windowCounts = computeFacetCounts(
          cards.map((c) => c.state),
          active,
          anchorDate,
          'window',
          windowKeys
        );
        // "Todas las fechas" (value="") no tiene predicado de ventana propio — su conteo
        // con auto-exclusión es simplemente cuántas cards coinciden con las demás
        // dimensiones de filtro activas.
        const allDatesCount = cards.filter((c) =>
          cardMatchesFilters(c.state, active, anchorDate, 'window')
        ).length;
        filtersEl.querySelectorAll<HTMLElement>('[data-facet="window"] label').forEach((label) => {
          const input = label.querySelector('input') as HTMLInputElement | null;
          const countEl = label.querySelector('.filter-count');
          if (!input || !countEl) return;
          countEl.textContent = String(input.value === '' ? allDatesCount : windowCounts[input.value] ?? 0);
        });

        const regionKeys = Array.from(
          filtersEl.querySelectorAll<HTMLInputElement>('[data-facet="region"] input')
        ).map((i) => i.value);
        const regionCounts = computeFacetCounts(
          cards.map((c) => c.state),
          active,
          anchorDate,
          'region',
          regionKeys
        );
        filtersEl.querySelectorAll<HTMLElement>('[data-facet="region"] label.filter-chip').forEach((label) => {
          const input = label.querySelector('input') as HTMLInputElement | null;
          const countEl = label.querySelector('.filter-count');
          if (!input || !countEl) return;
          countEl.textContent = String(regionCounts[input.value] ?? 0);
        });

        const familyKeys = Array.from(filtersEl.querySelectorAll<HTMLInputElement>('[data-facet="family"] input')).map((i) => i.value);
        const familyCounts = computeFacetCounts(
          cards.map((c) => c.state),
          active,
          anchorDate,
          'family',
          familyKeys
        );
        filtersEl.querySelectorAll<HTMLElement>('[data-facet="family"] label.filter-chip').forEach((label) => {
          const input = label.querySelector('input') as HTMLInputElement | null;
          const countEl = label.querySelector('.filter-count');
          if (!input || !countEl) return;
          countEl.textContent = String(familyCounts[input.value] ?? 0);
        });

        // Histograma: alturas re-escaladas con auto-exclusión de la propia dimensión
        // `day`, de modo que ninguna barra pueda quedar en cero solo por estar
        // seleccionada otra fecha — cada barra siempre sigue siendo alcanzable.
        if (dayBars.length > 0) {
          const dayCounts = computeFacetCounts(
            cards.map((c) => c.state),
            active,
            anchorDate,
            'day',
            dayKeys
          );
          let maxDay = 0;
          for (const key of dayKeys) maxDay = Math.max(maxDay, dayCounts[key] ?? 0);
          for (const bar of dayBars) {
            const key = bar.getAttribute('data-day') || '';
            const count = dayCounts[key] ?? 0;
            const pct = maxDay === 0 || count === 0 ? 0 : Math.round((count / maxDay) * 100);
            bar.style.setProperty('--h', pct + '%');
            const selected = active.day === key;
            bar.setAttribute('aria-pressed', selected ? 'true' : 'false');
            // Atenuar lo que la ventana activa deja fuera, sin ocultarlo: el lector
            // debe seguir viendo la forma completa del mes mientras filtra.
            const inScope = active.day
              ? selected
              : cardMatchesFilters(
                  { family: '', regionId: '', date: key, communeNorm: '' },
                  { family: [], region: [], window: active.window, q: '' },
                  anchorDate
                );
            bar.classList.toggle('is-out', !inScope);
          }
        }

        if (regionCountEl) {
          regionCountEl.textContent = active.region.length > 0 ? ' · ' + active.region.length : '';
        }

        const nextParams = new URLSearchParams(location.search);
        nextParams.delete('family');
        nextParams.delete('region');
        nextParams.delete('window');
        nextParams.delete('q');
        nextParams.delete('day');
        for (const [key, value] of new URLSearchParams(serializeFilterParams(active))) {
          nextParams.set(key, value);
        }
        const qs = nextParams.toString();
        history.replaceState(
          null,
          '',
          location.pathname + (qs ? '?' + qs : '') + location.hash
        );
      }

      // `window` y `day` son ambos predicados de fecha. Se mantienen mutuamente
      // exclusivos AQUÍ, en la capa de interacción: elegir un preset suelta el día
      // fijado y viceversa. newsFilterLogic los ANDea si ambos llegan puestos —
      // deliberadamente, para que la función pura no mienta sobre sus entradas.
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
        input.addEventListener('change', () => {
          active = { ...active, window: input.value as FilterParams['window'], day: '' };
          applyFilters();
        });
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((input) => {
        input.addEventListener('change', () => {
          const checked = Array.from(
            filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"]:checked')
          ).map((i) => i.value);
          active = { ...active, region: checked };
          applyFilters();
        });
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach((input) => {
        input.addEventListener('change', () => {
          const checked = Array.from(
            filtersEl.querySelectorAll<HTMLInputElement>('input[name="family"]:checked')
          ).map((i) => i.value);
          active = { ...active, family: checked };
          applyFilters();
        });
      });
      for (const bar of dayBars) {
        bar.addEventListener('click', () => {
          const key = bar.getAttribute('data-day') || '';
          const next = active.day === key ? '' : key;
          active = { ...active, day: next, window: '' };
          filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
            input.checked = input.value === '';
          });
          applyFilters();
        });
      }
      if (comunaInput) {
        comunaInput.addEventListener('input', () => {
          active = { ...active, q: comunaInput.value };
          applyFilters();
        });
      }
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          active = { family: [], region: [], window: '', q: '', day: '' };
          filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
            input.checked = input.value === '';
          });
          filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"], input[name="family"]').forEach((input) => {
            input.checked = false;
          });
          if (comunaInput) comunaInput.value = '';
          applyFilters();
        });
      }

      applyFilters();
    })();
  </script>
</EditorialLayout>

<style>
  section {
    margin-bottom: var(--2xl);
  }

  .freshness {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
  }

  .empty-state {
    color: var(--muted);
    font-style: italic;
  }

  /* Etiqueta accesible sin peso visual — usada por los <legend> que la barra
     rediseñada ya no muestra como título y por el tipo de delito de cada fila,
     que visualmente es solo un punto de color. */
  .news-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* --- Paleta de tipo de delito -------------------------------------------
     Un color por familia CEAD, compartido por el chip del filtro y el punto de
     cada fila: es lo que permite leer el tipo sin leer una etiqueta. Duplicada
     literalmente en /news/ — el bloque debe editarse en las DOS páginas a la vez.
     Tonos oklch de croma bajo para que ocho colores convivan sin competir con
     el acento del sitio. */
  [data-family='vida'] { --fam: oklch(0.58 0.14 25); }
  [data-family='robos_violentos'] { --fam: oklch(0.60 0.13 60); }
  [data-family='propiedad'] { --fam: oklch(0.62 0.12 95); }
  [data-family='drogas'] { --fam: oklch(0.58 0.13 305); }
  [data-family='armas'] { --fam: oklch(0.58 0.12 265); }
  [data-family='vif'] { --fam: oklch(0.58 0.13 345); }
  [data-family='sexuales'] { --fam: oklch(0.60 0.11 195); }
  [data-family='incivilidades'] { --fam: oklch(0.62 0.07 150); }
  [data-family='homicidios'] { --fam: oklch(0.45 0.16 12); }

  .fam-dot {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--fam, var(--muted));
  }

  /* homicidios comparte territorio de tono con vida — un anillo es el segundo
     canal visual (WR-02) para distinguirlos sin depender solo del color. */
  [data-family='homicidios'] .fam-dot {
    box-shadow: 0 0 0 1.5px #fff, 0 0 0 3px var(--fam);
  }

  /* --- Barra de filtros ---------------------------------------------------- */
  .news-filter-bar {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--lg);
    margin-bottom: var(--xl);
    background: #fff;
  }

  .news-filter-bar summary {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  .filter-primary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sm);
    margin-top: var(--md);
  }

  .filter-group--search {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--xs);
    flex: 1 1 260px;
    min-width: 0;
    height: 48px;
    padding: 0 var(--md);
    border: 1.5px solid var(--line);
    border-radius: 999px;
  }

  .filter-group--search:focus-within {
    border-color: var(--primary);
  }

  .search-icon {
    display: flex;
    color: var(--muted);
  }

  #news-comuna-q {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: var(--text-body);
    color: var(--ink);
  }

  /* Región: desplegable sobre los MISMOS checkboxes. No es un <select> a
     propósito — assertion 18 exige inputs type="checkbox" dentro del fieldset
     data-facet="region", y un <select> multiple es peor en móvil. */
  .filter-dropdown {
    position: relative;
  }

  .filter-dropdown > summary {
    display: flex;
    align-items: center;
    gap: var(--xs);
    height: 48px;
    padding: 0 var(--md);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
  }

  .filter-dropdown[open] > summary,
  .filter-dropdown > summary:has(~ * input:checked) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .dd-count {
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .filter-group--panel {
    position: absolute;
    z-index: 20;
    top: calc(100% + 4px);
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: max-content;
    max-width: 320px;
    max-height: 340px;
    overflow-y: auto;
    padding: var(--xs);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 12px 32px rgb(0 0 0 / 12%);
  }

  .filter-group--presets {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 48px;
    padding: 4px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
  }

  .preset-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--xs);
    height: 38px;
    padding: 0 var(--sm);
    border-radius: 999px;
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--muted);
    white-space: nowrap;
    cursor: pointer;
  }

  .preset-chip:has(input:checked) {
    background: var(--primary);
    color: #fff;
  }

  .preset-chip:has(input:checked) .filter-count {
    color: #fff;
  }

  .preset-chip input,
  .filter-chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .preset-chip:has(input:focus-visible),
  .filter-chip:has(input:focus-visible),
  .day-bar:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* --- Histograma por día -------------------------------------------------- */
  .day-histogram {
    margin-top: var(--md);
    padding: var(--sm) var(--md);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .day-histogram-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sm);
    margin: 0 0 var(--xs);
    font-size: var(--text-label);
    color: var(--muted);
  }

  .day-peak {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .day-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 54px;
  }

  .day-bar {
    flex: 1;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .day-bar-fill {
    width: 100%;
    /* Los días con cero conservan una marca de 3px: un hueco debe leerse como
       hueco, no desaparecer del eje. */
    height: max(var(--h, 0%), 3px);
    border-radius: 3px 3px 0 0;
    background: var(--primary);
    transition: height 120ms ease-out;
  }

  .day-bar.is-out .day-bar-fill {
    opacity: 0.22;
  }

  .day-bar[aria-pressed='true'] .day-bar-fill {
    background: var(--ink);
  }

  .day-axis {
    display: flex;
    justify-content: space-between;
    margin: var(--xs) 0 0;
    font-size: var(--text-label);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* --- Chips de tipo de delito --------------------------------------------- */
  .filter-group--families {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xs);
    margin-top: var(--md);
    padding: 0;
    border: 0;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--xs);
    min-height: 44px;
    padding: 0 var(--sm);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .filter-chip--family {
    min-height: 34px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
  }

  .filter-chip:has(input:checked) {
    background: var(--primary);
    color: #fff;
    border-radius: 4px;
  }

  .filter-chip--family:has(input:checked) {
    border-color: var(--ink);
    background: var(--ink);
    border-radius: 999px;
  }

  .filter-count {
    color: var(--muted);
    font-size: var(--text-label);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .filter-chip:has(input:checked) .filter-count {
    color: #fff;
  }

  .filter-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    margin-top: var(--md);
  }

  #news-result-count {
    font-size: var(--text-body);
    font-weight: var(--weight-strong);
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  #news-clear-filters {
    background: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--primary);
    padding: var(--xs) var(--sm);
    min-height: 44px;
    cursor: pointer;
  }

  .facet-semantics-note {
    font-size: var(--text-label);
    color: var(--muted);
    max-width: 65ch;
    margin: var(--md) 0 0;
  }

  #news-empty {
    padding: var(--lg);
    margin-bottom: var(--xl);
    color: var(--muted);
    text-align: center;
  }

  /* --- Lista densa ---------------------------------------------------------
     `.news-card` NO puede llevar `display` en ninguna regla (assertion 12): el
     grid vive en `.news-row`, su hijo, para que el [hidden] del UA siga
     ocultando la tarjeta cuando el filtro la descarta. */
  .news-list {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .news-list-head,
  .news-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 170px 130px 84px;
    align-items: center;
    gap: var(--sm);
  }

  .news-list-head {
    margin: 0;
    padding: var(--xs) var(--md);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .news-list-head span:last-child,
  .news-date {
    text-align: right;
  }

  .news-month-section {
    margin: 0;
  }

  .news-date-group {
    margin: 0;
    padding: var(--xs) var(--md);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .news-card {
    padding: 10px var(--md);
    border-bottom: 1px solid var(--line);
  }

  .news-card:hover {
    background: var(--bg);
  }

  .news-title {
    display: flex;
    align-items: flex-start;
    gap: var(--sm);
    min-width: 0;
    margin: 0;
    font-size: var(--text-body);
    font-weight: var(--weight-strong);
    line-height: 1.35;
  }

  .news-title .fam-dot {
    margin-top: 6px;
  }

  .news-title a {
    color: var(--ink);
    text-decoration: none;
    /* Dos líneas como techo: el titular es la columna que decide si la fila
       merece un clic, recortarlo a una línea deja demasiados titulares mudos. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-title a:hover {
    text-decoration: underline;
    color: var(--primary);
  }

  .news-commune-chip,
  .news-outlet,
  .news-date {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-label);
  }

  .news-commune-chip {
    font-weight: 700;
  }

  .news-commune-chip a {
    color: var(--primary);
    text-decoration: none;
  }

  .news-commune-chip a:hover {
    text-decoration: underline;
  }

  .news-outlet,
  .news-date {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .news-list-head {
      display: none;
    }

    .news-row {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 2px;
    }

    .news-title {
      grid-column: 1 / -1;
    }

    .news-commune-chip {
      grid-column: 1 / -1;
    }

    /* El medio se queda: es la atribución de la fuente, no decoración
       (CLAUDE.md "siempre atribuir fuentes"). Pasa a su propia línea,
       junto a la fecha, en tipografía secundaria en vez de eliminarse. */
    .news-outlet {
      grid-column: 1;
      text-align: left;
    }

    .news-date {
      grid-column: 2;
      text-align: right;
    }
  }

  @media (max-width: 480px) {
    .filter-primary {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-group--presets,
    .filter-dropdown > summary {
      justify-content: center;
    }

    .filter-group--panel {
      position: static;
      max-width: none;
      box-shadow: none;
    }
  }
</style>
