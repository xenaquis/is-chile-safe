---
/**
 * ES crime-type ranking page — /es/ranking-delito/{crime}/
 *
 * Rankings v2: la tabla, el selector de año, el buscador, el filtro por región
 * y el desglose regional viven ahora en RankingBoard.astro. El frontmatter
 * (carga de datos, rangos nacionales, JSON-LD, hreflang) es el mismo de antes.
 *
 * Cambios respecto a la versión anterior:
 *   - CRIME_RANKING_DEFS se importa de config/rankingStrings.ts (antes estaba
 *     duplicado literal en esta página y en su gemela EN).
 *   - regionSlug se resuelve aquí para que el panel regional pueda enlazar.
 *   - RankingTableEnhancer y TrendChip ya no se usan en esta página.
 *
 * Zero client:* directives.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapPlaceholderSlot from '../../../components/MapPlaceholderSlot.astro';
import MethodologyCaveat from '../../../components/MethodologyCaveat.astro';
import RankingBoard from '../../../components/RankingBoard.astro';
import { loadIndex, loadCommune, loadRegion, regionFileId } from '../../../lib/data.ts';
import { FAMILY_LABELS_ES, RANKING_METHODOLOGY_ES, RANKING_RATE_EXPLAINER_ES } from '../../../lib/familyDefs';
import { RANKING_DEFS } from '../../../config/rankingStrings.ts';
import { buildBreadcrumb, buildItemList } from '../../../lib/jsonld.ts';

export async function getStaticPaths() {
  return RANKING_DEFS.map((def) => ({
    params: { crime: def.es },              // ES slug is the route param
    props: { familyKey: def.familyKey, dataSource: def.dataSource, enParam: def.en },
  }));
}

const { crime } = Astro.params;
const { familyKey, dataSource, enParam } = Astro.props as {
  familyKey: string;
  dataSource: 'featured_rates' | 'by_family';
  enParam: string;
};

const index = loadIndex();

type Row = {
  name: string;
  slug: string;
  cut: string;
  regionName: string;
  regionSlug: string;
  regionId: number;
  rate: number;
  low_population: boolean;
  nationalRank: number | null;
  ratesByYear: Record<number, number>;
};

const regionCache = new Map<string, { name: string; slug: string }>();
function region(fileId: string) {
  if (!regionCache.has(fileId)) {
    try {
      const r = loadRegion(fileId);
      regionCache.set(fileId, { name: r.name, slug: r.slug });
    } catch {
      regionCache.set(fileId, { name: `Región ${fileId}`, slug: fileId });
    }
  }
  return regionCache.get(fileId)!;
}

const allRows: Omit<Row, 'nationalRank'>[] = [];
// Último año completo capturado al iterar las comunas (CR-02).
// Fix B-01: latestYear se deriva del dato, nunca del reloj del sistema.
let latestYear = 0;
for (const meta of index) {
  const commune = loadCommune(meta.cut);
  if (!meta.low_population) {
    latestYear = Math.max(latestYear, commune.latestCompleteYear);
  }
  let rate: number;
  if (dataSource === 'featured_rates') {
    // Homicidios subgrupo 101 — vive en featured_rates, NO en by_family (Pitfall 1)
    rate = commune.featured_rates?.homicidios?.[commune.latestCompleteYear] ?? 0;
  } else {
    const entry = commune.series.find((s) => s.year === commune.latestCompleteYear && !s.partial);
    rate = entry?.by_family?.[familyKey] ?? 0;
  }
  // ratesByYear: solo años completos (D-3)
  const ratesByYear: Record<number, number> = {};
  const completeYears = new Set(commune.series.filter((s) => !s.partial).map((s) => s.year));
  if (dataSource === 'featured_rates') {
    const hom = commune.featured_rates?.homicidios ?? {};
    for (const [y, v] of Object.entries(hom)) {
      const yr = Number(y);
      if (completeYears.has(yr)) ratesByYear[yr] = v as number;
    }
  } else {
    commune.series.filter((s) => !s.partial).forEach((s) => {
      ratesByYear[s.year] = s.by_family?.[familyKey] ?? 0;
    });
  }
  const rFileId = regionFileId(meta.region_id);
  const reg = region(rFileId);
  allRows.push({
    name: meta.name,
    slug: meta.slug,
    cut: meta.cut,
    regionName: commune.regionName,
    regionSlug: reg.slug,
    regionId: Number(rFileId),
    rate,
    low_population: meta.low_population,
    ratesByYear,
  });
}

const eligibleRows = allRows.filter((r) => !r.low_population).sort((a, b) => b.rate - a.rate);
const lowPopRows = allRows.filter((r) => r.low_population).sort((a, b) => b.rate - a.rate);

// Rango nacional asignado antes de cualquier filtro (CR-01)
let rankCounter = 0;
const rankingRows: Row[] = [
  ...eligibleRows.map((row) => ({ ...row, nationalRank: ++rankCounter })),
  ...lowPopRows.map((row) => ({ ...row, nationalRank: null })),
];

const familyNationalMean =
  eligibleRows.length > 0 ? eligibleRows.reduce((sum, r) => sum + r.rate, 0) / eligibleRows.length : 0;

const enPath = `/crime-ranking/${enParam}/`;
const esPath = `/es/ranking-delito/${crime}/`;

const familyLabel = FAMILY_LABELS_ES[familyKey] ?? familyKey;
const familyDef = RANKING_METHODOLOGY_ES[familyKey] ?? '';

const title = `Comunas con mayor incidencia de ${familyLabel} en Chile — Chile Safety Map`;
const description = `Compare la tasa de ${familyLabel.toLowerCase()} reportada por 100.000 habitantes en todas las comunas de Chile. Datos oficiales CEAD, con ranking nacional.`;

const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${familyLabel} — Ranking Nacional por Comuna (Chile)`,
  description: `Tasas anuales reportadas de ${familyLabel.toLowerCase()} por 100.000 habitantes para todas las comunas de Chile, según el CEAD (Centro de Estudios y Análisis del Delito).`,
  url: `https://ischilesafe.com${esPath}`,
  spatialCoverage: { '@type': 'Country', name: 'Chile' },
  temporalCoverage: `2005/${latestYear}`,
  measurementTechnique: 'Tasa por 100.000 habitantes, estadísticas policiales oficiales CEAD',
  creator: { '@type': 'Organization', name: 'CEAD — Centro de Estudios y Análisis del Delito' },
};

const breadcrumb = buildBreadcrumb([
  { name: 'Inicio', url: 'https://ischilesafe.com/es/' },
  { name: 'Rankings', url: 'https://ischilesafe.com/es/rankings/' },
  { name: familyLabel },
]);

const eligibleRankingRows = rankingRows.filter((r) => !r.low_population);
const ranking = buildItemList(eligibleRankingRows, 'es', {
  name: `Comunas por incidencia reportada de ${familyLabel.toLowerCase()} (descendente)`,
  order: 'Descending',
});

const jsonLd = [jsonLdDataset, breadcrumb, ranking];
---

<BaseLayout
  lang="es"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="crime-type-map"
  pageType="crime"
>
  <section class="crime-hero">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/es/">Inicio</a>
      <span aria-hidden="true"> › </span>
      <a href="/es/rankings/">Rankings</a>
      <span aria-hidden="true"> › </span>
      <span>{familyLabel}</span>
    </nav>
    <h1 class="crime-h1">
      Comunas con mayor incidencia reportada de {familyLabel.toLowerCase()} en Chile
    </h1>
    <p class="crime-def">{familyDef}</p>
    <p class="crime-def">{RANKING_RATE_EXPLAINER_ES}</p>
    <p class="hero-caveat">
      La media nacional es la <strong>media simple de comunas</strong> para esta familia delictiva
      (comunas ≥ 10.000 hab., último año completo). <a href="/es/metodologia/#comparison-criteria">Metodología</a>.
    </p>
  </section>

  <section aria-label="Ranking nacional de comunas">
    <h2 class="rk-section-h2">
      Comunas ordenadas por tasa de {familyLabel.toLowerCase()} por 100.000 habitantes (<span id="rk-year-label">{latestYear}</span>)
    </h2>
    <RankingBoard
      lang="es"
      familyKey={familyKey}
      latestYear={latestYear}
      mean={familyNationalMean}
      rows={rankingRows}
    />
  </section>

  <MapPlaceholderSlot mountType="crime-type-map" locale="es" />
  <MethodologyCaveat locale="es" />
</BaseLayout>

<style>
  .crime-hero { padding: var(--xl) 0 var(--lg); }

  .breadcrumb { font-size: var(--text-label); color: var(--muted); margin-bottom: var(--sm); }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--primary); }

  .crime-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
  }

  .crime-def {
    font-size: var(--text-body);
    color: var(--muted);
    margin: var(--sm) 0;
    max-width: 68ch;
  }

  .hero-caveat { font-size: var(--text-label); color: var(--muted); margin-top: var(--xs); }

  .rk-section-h2 {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: 0 0 var(--md);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
