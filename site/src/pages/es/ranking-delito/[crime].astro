---
/**
 * ES crime-type ranking page — /es/ranking-delito/{crime}/
 *
 * Mirror of /crime-ranking/[crime].astro in Spanish. Builds 8 crime-type pages:
 * homicidios (featured_rates subgroup 101) + 7 CEAD families.
 * Route param is the ES slug; both EN and ES param stored in props for path wiring.
 *
 * Zero client:* directives.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapPlaceholderSlot from '../../../components/MapPlaceholderSlot.astro';
import MethodologyCaveat from '../../../components/MethodologyCaveat.astro';
import TrendChip from '../../../components/TrendChip.astro';
import {
  loadIndex,
  loadCommune,
  regionFileId,
} from '../../../lib/data.ts';
import { FAMILY_LABELS_ES, RANKING_METHODOLOGY_ES, RANKING_RATE_EXPLAINER_ES } from '../../../lib/familyDefs';
import { buildBreadcrumb, buildItemList } from '../../../lib/jsonld.ts';

// ES slug map — hardcoded (never getRelativeLocaleUrl — i18n-localized-slug-pitfall)
const ES_CRIME_SLUGS: Record<string, string> = {
  'homicide':          'homicidios',
  'violent-robbery':   'robos-violentos',
  'drug-crimes':       'drogas',
  'property':          'propiedad',
  'domestic-violence': 'violencia-intrafamiliar',
  'weapons':           'armas',
  'disorder':          'incivilidades',
  'life-crimes':       'delitos-contra-la-vida',
};

export async function getStaticPaths() {
  const CRIME_RANKING_DEFS = [
    { param: 'homicide',          familyKey: 'homicidios',      dataSource: 'featured_rates' as const },
    { param: 'violent-robbery',   familyKey: 'robos_violentos', dataSource: 'by_family'      as const },
    { param: 'drug-crimes',       familyKey: 'drogas',          dataSource: 'by_family'      as const },
    { param: 'property',          familyKey: 'propiedad',       dataSource: 'by_family'      as const },
    { param: 'domestic-violence', familyKey: 'vif',             dataSource: 'by_family'      as const },
    { param: 'weapons',           familyKey: 'armas',           dataSource: 'by_family'      as const },
    { param: 'disorder',          familyKey: 'incivilidades',   dataSource: 'by_family'      as const },
    { param: 'life-crimes',       familyKey: 'vida',            dataSource: 'by_family'      as const },
  ] as const;

  const ES_SLUGS: Record<string, string> = {
    'homicide':          'homicidios',
    'violent-robbery':   'robos-violentos',
    'drug-crimes':       'drogas',
    'property':          'propiedad',
    'domestic-violence': 'violencia-intrafamiliar',
    'weapons':           'armas',
    'disorder':          'incivilidades',
    'life-crimes':       'delitos-contra-la-vida',
  };

  return CRIME_RANKING_DEFS.map((def) => ({
    params: { crime: ES_SLUGS[def.param] },   // ES slug is the route param
    props: { ...def, enParam: def.param },     // carry EN param for enPath wiring
  }));
}

// --- Page-level data ---
const { crime } = Astro.params;
const { familyKey, dataSource, enParam } = Astro.props as {
  familyKey: string;
  dataSource: 'featured_rates' | 'by_family';
  enParam: string;
};

const index = loadIndex();

// Build national ranking: non-low-pop communes sorted by crime rate desc
type RankRow = {
  name: string;
  slug: string;
  cut: string;
  regionName: string;
  regionFileIdStr: string;
  rate: number;
  trend: 'up' | 'down' | 'stable';
  low_population: boolean;
  nationalRank: number | null;
};

const allRows: Omit<RankRow, 'nationalRank'>[] = [];
// Capturamos el último año completo directamente al iterar las comunas (CR-02).
let latestYear = new Date().getFullYear() - 1;
for (const meta of index) {
  const commune = loadCommune(meta.cut);
  if (!meta.low_population) {
    latestYear = Math.max(latestYear, commune.latestCompleteYear);
  }
  let rate: number;
  if (dataSource === 'featured_rates') {
    // Homicidios subgrupo 101 — vive en featured_rates, NO en by_family (Pitfall 1)
    rate = commune.featured_rates?.homicidios?.[commune.latestCompleteYear] ?? 0;
  } else {
    const entry = commune.series.find(
      (s) => s.year === commune.latestCompleteYear && !s.partial
    );
    rate = entry?.by_family?.[familyKey] ?? 0;
  }
  allRows.push({
    name: meta.name,
    slug: meta.slug,
    cut: meta.cut,
    regionName: commune.regionName,
    regionFileIdStr: regionFileId(meta.region_id),
    rate,
    trend: commune.trend,
    low_population: meta.low_population,
  });
}

const eligibleRows = allRows.filter((r) => !r.low_population).sort((a, b) => b.rate - a.rate);
const lowPopRows = allRows.filter((r) => r.low_population).sort((a, b) => b.rate - a.rate);

// Asignar rango nacional estable antes de cualquier filtro (CR-01)
let rankCounter = 0;
const rankingRows: RankRow[] = [
  ...eligibleRows.map((row) => ({ ...row, nationalRank: ++rankCounter })),
  ...lowPopRows.map((row) => ({ ...row, nationalRank: null })),
];

const familyNationalMean =
  eligibleRows.length > 0
    ? eligibleRows.reduce((sum, r) => sum + r.rate, 0) / eligibleRows.length
    : 0;

// Region breakdown
type RegionBreakRow = {
  regionId: string;
  regionName: string;
  rate: number;
};

const regionMap = new Map<string, { name: string; rates: number[] }>();
for (const row of allRows) {
  if (row.low_population) continue;
  const rid = row.regionFileIdStr;
  if (!regionMap.has(rid)) {
    regionMap.set(rid, { name: row.regionName, rates: [] });
  }
  regionMap.get(rid)!.rates.push(row.rate);
}

const regionBreakRows: RegionBreakRow[] = [];
for (const [rid, { name, rates }] of regionMap.entries()) {
  const mean = rates.length > 0 ? rates.reduce((s, r) => s + r, 0) / rates.length : 0;
  regionBreakRows.push({ regionId: rid, regionName: name, rate: mean });
}
regionBreakRows.sort((a, b) => b.rate - a.rate);

const maxRegionRate = Math.max(...regionBreakRows.map((r) => r.rate), 1);

// URL paths — enPath from EN param; esPath from ES slug (i18n-localized-slug-pitfall)
const enPath = `/crime-ranking/${enParam}/`;
const esPath = `/es/ranking-delito/${crime}/`;

const familyLabel = FAMILY_LABELS_ES[familyKey] ?? familyKey;
const familyDef = RANKING_METHODOLOGY_ES[familyKey] ?? '';

const title = `Comunas con mayor incidencia de ${familyLabel} en Chile — Chile Safety Map`;
const description = `Compare la tasa de ${familyLabel.toLowerCase()} reportada por 100.000 habitantes en todas las comunas de Chile. Datos oficiales CEAD, con ranking nacional.`;

// Dataset JSON-LD (crime-type pages emit Dataset, NOT Place — UI-SPEC line 288)
const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${familyLabel} — Ranking Nacional por Comuna (Chile)`,
  description: `Tasas anuales reportadas de ${familyLabel.toLowerCase()} por 100.000 habitantes para todas las comunas de Chile, según el CEAD (Centro de Estudios y Análisis del Delito).`,
  url: `https://ischilesafe.com${esPath}`,
  spatialCoverage: {
    '@type': 'Country',
    name: 'Chile',
  },
  temporalCoverage: `2005/${latestYear}`,
  measurementTechnique: 'Tasa por 100.000 habitantes, estadísticas policiales oficiales CEAD',
  creator: {
    '@type': 'Organization',
    name: 'CEAD — Centro de Estudios y Análisis del Delito',
  },
};

// BreadcrumbList: 2 niveles Inicio › Ranking de Delitos
// URL ES hardcoded — nunca getRelativeLocaleUrl (i18n-localized-slug-pitfall)
const breadcrumb = buildBreadcrumb([
  { name: 'Inicio', url: 'https://ischilesafe.com/es/' },
  { name: 'Ranking de Delitos' },  // página actual — omite url
]);

// ItemList: comunas por incidencia descendente — name sin 'segura'/'peligrosa' (assertSafeName)
const eligibleRankingRows = rankingRows.filter((r) => !r.low_population);
const ranking = buildItemList(eligibleRankingRows, 'es', {
  name: `Comunas por incidencia reportada de ${familyLabel.toLowerCase()} (descendente)`,
  order: 'Descending',
});

const jsonLd = [jsonLdDataset, breadcrumb, ranking];
---

<BaseLayout
  lang="es"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="crime-type-map"
  pageType="crime"
>
  <!-- CrimeTypeHero (ES) -->
  <section class="crime-hero">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/es/">Inicio</a>
      <span aria-hidden="true"> › </span>
      <span>Ranking de Delitos</span>
    </nav>
    <h1 class="crime-h1">
      Comunas con mayor incidencia de {familyLabel.toLowerCase()} reportados en Chile
    </h1>
    <p class="crime-def">{familyDef}</p>
    <div class="hero-meta">
      <span class="hero-stat">Media nacional: {familyNationalMean.toLocaleString('es-CL', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} por 100k ({latestYear})</span>
      <span class="hero-sep" aria-hidden="true">·</span>
      <span class="hero-stat">{eligibleRows.length} comunas en ranking</span>
    </div>
  </section>

  <!-- NationalRankingTable (ES) -->
  <section class="ranking-section" aria-label="Ranking nacional de comunas">
    <h2 class="section-heading">
      Comunas ordenadas por tasa de {familyLabel.toLowerCase()} por 100.000 habitantes ({latestYear})
    </h2>
    <p class="rate-explainer">{RANKING_RATE_EXPLAINER_ES}</p>
    <div class="table-wrapper">
      <table class="ranking-table">
        <thead>
          <tr>
            <th scope="col">Posición</th>
            <th scope="col">Comuna</th>
            <th scope="col">Región</th>
            <th scope="col" class="col-num">Denuncias por 100.000 hab. ({latestYear})</th>
            <th scope="col">Tendencia</th>
          </tr>
        </thead>
        <tbody>
          {rankingRows.map((row) => (
            <tr class={row.low_population ? 'low-pop' : ''}>
              <td class="col-num col-rank">
                {row.low_population ? '—' : `#${row.nationalRank}`}
              </td>
              <td>
                <a href={`/es/comuna/${row.slug}/`} class="commune-link">
                  {row.name}
                </a>
                {row.low_population && (
                  <sup class="low-pop-marker" title="Población pequeña — la tasa puede presentar alta volatilidad estadística">*</sup>
                )}
              </td>
              <td class="col-region">{row.regionName}</td>
              <td class="col-num">{row.rate.toLocaleString('es-CL', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</td>
              <td><TrendChip trend={row.trend} locale="es" /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {rankingRows.some((r) => r.low_population) && (
      <p class="low-pop-footnote">
        * Esta comuna tiene una pequeña población residente. Las tasas por 100.000 habitantes pueden presentar alta volatilidad estadística. Interprete con cautela.
      </p>
    )}
  </section>

  <!-- RegionBreakdownBars (ES) -->
  <section class="region-breakdown" aria-label="Desglose regional">
    <h2 class="section-heading">
      Desglose regional — tasa media de {familyLabel.toLowerCase()} por 100.000 habitantes ({latestYear})
    </h2>
    <div class="region-bars">
      {regionBreakRows.map((r) => {
        const widthPct = Math.round((r.rate / maxRegionRate) * 100) + '%';
        return (
          <div class="region-bar-row">
            <span class="region-bar-label">{r.regionName}</span>
            <span class="region-bar-track" aria-hidden="true">
              <span class="region-bar-fill" style={`width:${widthPct}`}></span>
            </span>
            <span class="region-bar-val">{Math.round(r.rate).toLocaleString('es-CL')}</span>
          </div>
        );
      })}
    </div>
  </section>

  <!-- MapPlaceholderSlot (D-13 crime-type-map) -->
  <MapPlaceholderSlot mountType="crime-type-map" locale="es" />

  <!-- MethodologyCaveat -->
  <MethodologyCaveat locale="es" />
</BaseLayout>

<style>
  .crime-hero {
    padding: var(--xl) 0 var(--lg);
  }

  .breadcrumb {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--sm);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .crime-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
    display: flex;
    align-items: center;
    gap: var(--sm);
    flex-wrap: wrap;
  }

  .featured-badge {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    background: var(--primary);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
    vertical-align: middle;
  }

  .crime-def {
    font-size: var(--text-body);
    color: var(--muted);
    margin: var(--sm) 0;
    max-width: 68ch;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
    margin-top: var(--sm);
  }

  .hero-stat {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .hero-sep {
    color: var(--line);
  }

  .ranking-section {
    margin: var(--xl) 0;
  }

  .section-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--md);
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .ranking-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-label);
  }

  .ranking-table thead th {
    background: var(--bg);
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--muted);
    padding: var(--sm) var(--md);
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .ranking-table tbody tr {
    border-bottom: 1px solid var(--line);
    background: var(--card);
    transition: background 0.1s;
  }

  .ranking-table tbody tr:last-child {
    border-bottom: none;
  }

  .ranking-table tbody tr:hover {
    background: var(--bg);
  }

  .ranking-table td {
    padding: var(--sm) var(--md);
    color: var(--ink);
    white-space: nowrap;
  }

  .col-num {
    text-align: right;
  }

  .col-rank {
    color: var(--muted);
    width: 4rem;
  }

  .col-region {
    color: var(--muted);
    font-size: var(--text-label);
  }

  .commune-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--weight-strong);
  }

  .commune-link:hover {
    text-decoration: underline;
  }

  .low-pop {
    opacity: 0.75;
  }

  .low-pop-marker {
    color: var(--muted);
    margin-left: 2px;
    font-size: 0.85em;
  }

  .low-pop-footnote {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .rate-explainer {
    font-size: 0.85em;
    color: var(--muted);
    margin-bottom: var(--sm);
    max-width: 72ch;
  }

  .rollout-note {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
    padding: 0 var(--xs);
  }

  .region-breakdown {
    margin: var(--xl) 0;
  }

  .region-bars {
    display: flex;
    flex-direction: column;
    gap: var(--sm);
  }

  .region-bar-row {
    display: grid;
    grid-template-columns: 14rem 1fr 5rem;
    align-items: center;
    gap: var(--sm);
  }

  .region-bar-label {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .region-bar-track {
    height: 10px;
    background: var(--line);
    border-radius: 5px;
    overflow: hidden;
  }

  .region-bar-fill {
    display: block;
    height: 100%;
    border-radius: 5px;
    background: var(--primary);
  }

  .region-bar-val {
    font-size: var(--text-label);
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 600px) {
    .region-bar-row {
      grid-template-columns: 8rem 1fr 4rem;
    }
  }
</style>
