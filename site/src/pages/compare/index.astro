---
/**
 * /compare/ — EN comparator landing page.
 *
 * Pre-rendered static shell (h1, lead, methodology caveat, noscript) for SEO.
 * ComparatorIsland mounts client:only="react" for interactive comparison.
 *
 * CMP-02: indexable shell guaranteed before island hydrates.
 *
 * Changed in the comparator redesign: the island also receives
 *   - low_population per commune (shown as a tag in the picker list)
 *   - regionNames (region_id → name), built from the already-cached loadRegion()
 * Nothing else about this page changes: same URL, same title/description, same
 * shell, same noscript fallback.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparatorIsland from '../../islands/ComparatorIsland';
import MethodologyCaveat from '../../components/MethodologyCaveat.astro';
import { loadIndex, loadRegion, regionFileId } from '../../lib/data.ts';
import { EN_STRINGS } from '../../config/i18n.ts';

const index = loadIndex();
const communes = index.map(c => ({
  id: c.cut,
  name: c.name,
  region_id: c.region_id,
  low_population: c.low_population,
}));

// region_id → region name. loadRegion() is process-cached, so this is 16 reads
// at build time and zero at runtime.
const regionNames: Record<string, string> = {};
for (const id of new Set(index.map(c => c.region_id))) {
  try {
    regionNames[id] = loadRegion(regionFileId(id)).name;
  } catch {
    // A missing region file must never fail the build — the island degrades to
    // no region label.
  }
}

// Pass only the cmp_* + nav keys the island needs (client:only safety — island
// cannot import EN_STRINGS at runtime without bundling the entire i18n module).
const strings: Record<string, string> = {
  cmp_input_placeholder: EN_STRINGS.cmp_input_placeholder,
  cmp_empty_heading: EN_STRINGS.cmp_empty_heading,
  cmp_add_prompt: EN_STRINGS.cmp_add_prompt,
  cmp_no_match: EN_STRINGS.cmp_no_match,
  cmp_max_reached: EN_STRINGS.cmp_max_reached,
  cmp_remove_aria: EN_STRINGS.cmp_remove_aria,
  cmp_data_error: EN_STRINGS.cmp_data_error,
  cmp_homicide_row: EN_STRINGS.cmp_homicide_row,
  cmp_homicide_no_data: EN_STRINGS.cmp_homicide_no_data,
  cmp_composite_label: EN_STRINGS.cmp_composite_label,
  cmp_what_is_this: EN_STRINGS.cmp_what_is_this,
  cmp_trend_unavailable: EN_STRINGS.cmp_trend_unavailable,
  cmp_empty_body: EN_STRINGS.cmp_empty_body,
  cmp_chips_label: EN_STRINGS.cmp_chips_label,
  cmp_case_singular: EN_STRINGS.cmp_case_singular,
  cmp_case_plural: EN_STRINGS.cmp_case_plural,
  low_pop_footnote: EN_STRINGS.low_pop_footnote,
};
---

<BaseLayout
  lang="en"
  title="Compare Chile Communes — Reported Crime Data — Is Chile Safe"
  description="Select 2 or 3 communes to view reported crime statistics side by side. Source: CEAD official statistics."
  enPath="/compare/"
  esPath="/es/comparar/"
>
  <div style="max-width: 1100px; margin: 0 auto; padding: var(--xl) var(--lg);">
    <h1 style="font-size: var(--text-display); font-weight: var(--weight-strong); color: var(--ink); margin-bottom: var(--sm);">
      {EN_STRINGS.cmp_page_h1}
    </h1>
    <p style="font-size: var(--text-body); color: var(--muted); margin-bottom: var(--md);">
      {EN_STRINGS.cmp_page_lead}
    </p>
    <MethodologyCaveat locale="en" />
    <noscript>
      <p style="background: var(--bg); border: 1px solid var(--line); padding: var(--md); border-radius: var(--radius); color: var(--muted);">
        Enable JavaScript to use the interactive comparator. See individual commune pages for reported crime data.
      </p>
    </noscript>
    <div id="comparator-root">
      <ComparatorIsland client:only="react" lang="en" communes={communes} strings={strings} regionNames={regionNames} />
    </div>
  </div>
</BaseLayout>
