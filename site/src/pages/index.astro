---
/**
 * EN home page — /
 *
 * Phase 12 Plan 03: Rebuilt on Hybrid C+B framing.
 * Above the fold: H1 + search hero + two lead ranking tables + map CTA + guide cards.
 * Below the fold: condensed prose (CEAD attribution + how-to-read + disclaimer).
 *
 * Constraints:
 *  - Exactly one H1
 *  - Zero client:* directives
 *  - Search hero: plain form GET → /communes/?q=
 *  - Editorial Tone Guard: never "safe"/"dangerous" as absolute labels
 *  - All hrefs hardcoded (never getRelativeLocaleUrl for localized slugs)
 */
import HomeLayout from '../layouts/HomeLayout.astro';
import CommuneRankingTable from '../components/CommuneRankingTable.astro';
import { loadIndex, loadCommune, latestCompleteYearRate, loadNationalAverage } from '../lib/data.ts';
import { buildItemList } from '../lib/jsonld.ts';

const nationalAvg = loadNationalAverage();

// Derive the reference year from any non-low-population commune
const index = loadIndex();
const sampleCut = index.find((c) => !c.low_population)?.cut ?? '13101';
const sampleCommune = loadCommune(sampleCut);
const referenceYear = sampleCommune.latestCompleteYear;

// Build lead ranking tables at build time (non-low-population communes only)
const allRanked = index
  .filter((c) => !c.low_population)
  .map((c) => {
    const commune = loadCommune(c.cut);
    return {
      name: c.name,
      slug: c.slug,
      rate: latestCompleteYearRate(commune),
      national_rank: commune.national_rank,
      trend: commune.trend,
      low_population: c.low_population,
    };
  })
  .sort((a, b) => a.rate - b.rate);

// Lowest reported rate (ascending) — top 6
const lowestRows = allRanked.slice(0, 6);

// Highest reported rate (descending) — last 6
const highestRows = allRanked.slice(-6).reverse();

// ItemList JSON-LD: two lead tables (NO breadcrumb on home — D-07)
const lowestList = buildItemList(lowestRows, 'en', {
  name: 'Communes by reported CEAD incidence (ascending)',
  order: 'Ascending',
});
const highestList = buildItemList(highestRows, 'en', {
  name: 'Communes by reported CEAD incidence (descending)',
  order: 'Descending',
});
---

<HomeLayout
  lang="en"
  title="Is Chile Safe — Chile Safety Map"
  description="Official CEAD crime statistics for every commune and region of Chile. Explore incidence rates, rankings, and trends by commune, region, or crime type."
  enPath="/"
  esPath="/es/"
  pageType="home"
  jsonLd={[lowestList, highestList]}
>
  <!-- ========================================================
       ABOVE THE FOLD
       ======================================================== -->

  <section class="home-hero">
    <h1>Is Chile Safe? Official CEAD Crime Data for All 346 Communes</h1>
    <p class="home-intro">
      Explore official crime-incidence data from Chile's CEAD for all 346 communes and 16 regions —
      ranked by reported rate, not editorial opinion.
    </p>

    <!-- Search hero: plain GET form — zero JS (D-05/D-06) -->
    <form action="/communes/" method="get" class="search-hero-form">
      <label for="q" class="search-label">Find your commune</label>
      <div class="search-row">
        <input
          type="search"
          id="q"
          name="q"
          placeholder="e.g. Ñuñoa, Valparaíso…"
          autocomplete="off"
          class="search-input"
        />
        <button type="submit" class="search-btn">Search &rarr;</button>
      </div>
    </form>
  </section>

  <!-- Lead ranking tables: two side-by-side (D-03) -->
  <section class="lead-tables-section">
    <div class="lead-tables-grid">
      <div class="lead-table-col">
        <h2 class="table-heading">Lowest Reported Rate</h2>
        <p class="table-subhead">Communes with the lowest CEAD-reported incidence per 100k — {referenceYear}</p>
        <CommuneRankingTable rows={lowestRows} locale="en" />
        <a href="/safest-cities-in-chile/" class="see-all-link">See full ranking &rarr;</a>
      </div>
      <div class="lead-table-col">
        <h2 class="table-heading">Highest Reported Rate</h2>
        <p class="table-subhead">Communes with the highest CEAD-reported incidence per 100k — {referenceYear}</p>
        <CommuneRankingTable rows={highestRows} locale="en" />
        <a href="/communes/" class="see-all-link">Browse all communes &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Map CTA -->
  <section class="map-cta-section">
    <h2 class="map-cta-heading">Explore the Interactive Map</h2>
    <p class="map-cta-body">
      See all 346 communes coloured by incidence rate. Filter by crime type and year.
    </p>
    <a href="/map/" class="map-cta-btn">Open Chile Crime Map &rarr;</a>
  </section>

  <!-- Guide cards: static links to existing editorial pages only (D-04) -->
  <section class="guide-cards-section">
    <h2 class="guide-cards-heading">Explore by Topic</h2>
    <ul class="guide-cards">
      <li><a href="/chile-crime-map/" class="guide-card">Chile Crime Map — interactive choropleth</a></li>
      <li><a href="/is-chile-safe/" class="guide-card">Is Chile Safe? — national overview</a></li>
      <li><a href="/is-santiago-safe/" class="guide-card">Is Santiago Safe? — capital city data</a></li>
      <li><a href="/safest-cities-in-chile/" class="guide-card">Communes with Lowest Reported Rates</a></li>
      <li><a href="/methodology/" class="guide-card">Methodology — how rates are calculated</a></li>
      <li><a href="/communes/" class="guide-card">Browse all 346 communes &rarr;</a></li>
    </ul>
  </section>

  <!-- ========================================================
       BELOW THE FOLD — condensed prose
       ======================================================== -->

  <section class="about-section">
    <h2>About the Data</h2>
    <p>
      Chile Safety Map presents official crime-incidence data from Chile's Centro de Estudios
      y Análisis del Delito (CEAD) for all 346 communes and 16 regions. Every figure is sourced
      directly from that government dataset. The canonical metric is the
      <strong>rate of reported offences per 100,000 inhabitants</strong>, which allows fair
      comparison between places of very different sizes. All rates are computed from CEAD's annual
      frequency tables and cover 2005 through {referenceYear}. The national mean rate across
      non-low-population communes for {referenceYear} is{' '}
      <strong>{Math.round(nationalAvg).toLocaleString('en-US')} per 100,000</strong>.
      A higher rate means more reported offences per 100,000 residents — not necessarily that a
      place is objectively more or less liveable. Under-reporting, floating populations, and
      crime-family composition all affect the figure; see the{' '}
      <a href="/methodology/">Methodology page</a> for full details.
    </p>
    <p>
      This site never assigns absolute "safe" or "dangerous" labels. It presents CEAD
      reported-incident data and lets you form your own informed view. Crime statistics reflect
      <em>reported incidents</em>, not actual crime — property crime is under-reported at
      rates of 50–70 % in many countries, and location decisions involve far more than a single
      incidence rate. Source: CEAD (Centro de Estudios y Análisis del Delito), Subsecretaría de
      Prevención del Delito, Ministry of the Interior and Public Security, Chile.
    </p>
  </section>
</HomeLayout>

<style>
  /* ── Hero ── */
  .home-hero {
    max-width: 780px;
    margin: 0 auto var(--2xl);
    padding-top: var(--xl);
  }

  .home-hero h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: var(--weight-strong);
    color: var(--ink);
    line-height: 1.2;
    margin-bottom: var(--md);
  }

  .home-intro {
    font-size: var(--text-body);
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: var(--lg);
  }

  /* ── Search hero form ── */
  .search-hero-form {
    margin-top: var(--lg);
  }

  .search-label {
    display: block;
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--sm);
  }

  .search-row {
    display: flex;
    gap: var(--sm);
    align-items: stretch;
  }

  .search-input {
    flex: 1;
    padding: var(--sm) var(--md);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-body);
    color: var(--ink);
    background: var(--card);
    min-width: 0;
  }

  .search-input:focus {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  .search-btn {
    padding: var(--sm) var(--lg);
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: var(--text-body);
    font-weight: var(--weight-strong);
    cursor: pointer;
    white-space: nowrap;
  }

  .search-btn:hover {
    opacity: 0.9;
  }

  /* ── Lead tables ── */
  .lead-tables-section {
    margin-bottom: var(--2xl);
  }

  .lead-tables-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--xl);
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .lead-tables-grid {
      grid-template-columns: 1fr;
    }
  }

  .table-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--xs);
  }

  .table-subhead {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--md);
  }

  .see-all-link {
    display: inline-block;
    margin-top: var(--sm);
    font-size: var(--text-label);
    color: var(--primary);
    text-decoration: none;
  }

  .see-all-link:hover {
    text-decoration: underline;
  }

  /* ── Map CTA ── */
  .map-cta-section {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--xl) var(--lg);
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--2xl);
  }

  .map-cta-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    margin-bottom: var(--sm);
  }

  .map-cta-body {
    color: var(--muted);
    margin-bottom: var(--lg);
  }

  .map-cta-btn {
    display: inline-block;
    padding: var(--sm) var(--xl);
    background: var(--primary);
    color: #fff;
    border-radius: var(--radius);
    font-weight: var(--weight-strong);
    text-decoration: none;
    font-size: var(--text-body);
  }

  .map-cta-btn:hover {
    opacity: 0.9;
  }

  /* ── Guide cards ── */
  .guide-cards-section {
    max-width: 900px;
    margin: 0 auto var(--2xl);
  }

  .guide-cards-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    margin-bottom: var(--md);
  }

  .guide-cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--md);
  }

  .guide-cards .guide-card {
    display: block;
    padding: var(--md) var(--lg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--primary);
    text-decoration: none;
    font-size: var(--text-body);
    transition: border-color 0.15s, background 0.15s;
  }

  .guide-cards .guide-card:hover {
    border-color: var(--primary);
    background: var(--bg);
  }

  /* ── About section ── */
  .about-section {
    max-width: 720px;
    margin: 0 auto var(--2xl);
    padding-top: var(--xl);
    border-top: 1px solid var(--line);
  }

  .about-section h2 {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    margin-bottom: var(--md);
  }

  .about-section p {
    font-size: var(--text-body);
    color: var(--ink);
    line-height: 1.7;
  }

  .about-section p + p {
    margin-top: var(--md);
  }

  .about-section a {
    color: var(--primary);
    text-decoration: none;
  }

  .about-section a:hover {
    text-decoration: underline;
  }
</style>
