---
/**
 * /news/ — EN news page (NEWS-04).
 *
 * Bilingual news surface for incidents sourced from Google News RSS search, classified by
 * the news pipeline's LLM classifier and geolocated by the deterministic commune
 * name->CUT resolver.
 * Each incident links to its source article AND its comuna page.
 * Legal-safe tone: attribute outlet; no absolute safe/dangerous verdicts.
 *
 * hreflang: /news/ <-> /es/noticias/
 * Pitfall 4: existsSync fallback — build does NOT crash if current.json absent.
 * P1-6: semantic h2/h3 heading structure, month-grouped sections, type+commune chips.
 */
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { loadIndex, loadRegion, regionFileId } from '../lib/data';
import { FAMILY_LABELS_EN } from '../lib/familyDefs';
import { computeNewsFacets, escapeForInlineScript } from '../lib/newsFacets';
import { norm, FILTER_LOGIC_MARKER } from '../lib/newsFilterLogic';
import { EN_STRINGS } from '../config/i18n.ts';

const t = EN_STRINGS;

// Resolve from the synced public copy via process.cwd() (= site/ during `astro build`).
// import.meta.url is unreliable at build time — compiled chunk locations differ per page,
// which previously made EN resolve to a missing path and render empty (bilingual drift).
const dataPath = path.resolve(process.cwd(), 'public/data/incidents/current.json');

let generated: string | null = null;
let incidents: Array<{
  id: string;
  title_es: string;
  title_en: string;
  date: string;
  outlet: string;
  url: string;
  slug?: string;
  cut?: string | number;
  family?: string;
}> = [];

if (existsSync(dataPath)) {
  try {
    const raw = JSON.parse(readFileSync(dataPath, 'utf-8'));
    generated = raw.generated ?? null;
    incidents = raw.incidents ?? [];
  } catch {
    // Malformed JSON — empty fallback
  }
}

// Build CUT → commune {name, slug} lookup from loadIndex() at build time
const _index = loadIndex();
const cutToCommune = new Map<string, { name: string; slug: string }>(
  _index.map((c) => [c.cut, { name: c.name, slug: c.slug }])
);
// Also slug → commune for incidents that have slug but no cut
const slugToCommune = new Map<string, { name: string; slug: string }>(
  _index.map((c) => [c.slug, { name: c.name, slug: c.slug }])
);
// CUT → region_id, for per-card data-region-id attributes (mirrors newsFacets.ts's internal map)
const cutToRegion = new Map<string, string>(_index.map((c) => [c.cut, c.region_id]));

// Helper: resolve commune info from incident (cut takes priority over slug)
// cut may be numeric in current.json — convert to string for Map lookup
function getCommuneInfo(incident: { cut?: string | number; slug?: string }): { name: string; slug: string } | undefined {
  if (incident.cut != null) return cutToCommune.get(String(incident.cut));
  if (incident.slug) return slugToCommune.get(incident.slug);
  return undefined;
}

// Localized family label from canonical map; fall back to capitalized key for unknown families
function familyLabel(family: string): string {
  return FAMILY_LABELS_EN[family] ?? family.charAt(0).toUpperCase() + family.slice(1);
}

// Format YYYY-MM as "Month YYYY" for h2 date groups
function formatMonth(yearMonth: string): string {
  if (!yearMonth || yearMonth.length < 7) return yearMonth;
  const [year, month] = yearMonth.split('-');
  const y = parseInt(year, 10);
  const m = parseInt(month, 10);
  if (isNaN(y) || isNaN(m)) return yearMonth;
  const d = new Date(Date.UTC(y, m - 1, 1));
  return d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long' });
}

// Format generated date for display
let formattedDate = '';
if (generated) {
  try {
    formattedDate = new Date(generated).toLocaleDateString('en-US', {
      timeZone: 'UTC',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    formattedDate = generated.slice(0, 10);
  }
}

// Sort newest-first (TD-03)
incidents.sort((a, b) => b.date.localeCompare(a.date));

// Group incidents by YYYY-MM (build-time, zero client JS)
const monthGroups = new Map<string, typeof incidents>();
for (const incident of incidents) {
  const yearMonth = incident.date.slice(0, 7);
  if (!monthGroups.has(yearMonth)) monthGroups.set(yearMonth, []);
  monthGroups.get(yearMonth)!.push(incident);
}

// Safe URL helper — mirrors IncidentPinLayer.ts safeUrl() (TD-05, T-19-03)
function safeUrl(url: string): string {
  try {
    const u = new URL(url);
    if (u.protocol === 'http:' || u.protocol === 'https:') {
      return url;
    }
  } catch {
    // malformed URL
  }
  return '#';
}

// Facet index (Phase 27, FACET-01/05/06) — build-time only, inert #news-facets JSON node below.
const archiveDir = path.resolve(process.cwd(), 'public/data/incidents/archive');
// incidents' `cut` is optional (string | number | undefined); IncidentLike requires
// string | number. computeNewsFacets/facets.mjs already guard every lookup with
// `cutToRegion.get(String(inc.cut))`, which safely no-ops on an undefined cut — no
// runtime behavior change, this cast only resolves the type-checker mismatch.
const facets = computeNewsFacets(incidents as unknown as import('../lib/newsFacets').IncidentLike[], loadIndex(), archiveDir);
const facetsProjection = {
  byFamily: facets.byFamily,
  byRegion: facets.byRegion,
  byMonth: facets.byMonth,
  byWindow: {
    today: facets.byWindow.today.length,
    sevenDay: facets.byWindow.sevenDay.length,
    thirtyDay: facets.byWindow.thirtyDay.length,
  },
  anchorDate: facets.anchorDate,
};

// Region names for the filter bar (at most 16 lookups) — CommuneMeta has no region
// name field, so loadRegion(regionFileId(...)).name is the only correct source.
const regionNames = new Map<string, string>(
  facets.byRegion.map((r) => [r.regionId, loadRegion(regionFileId(r.regionId)).name])
);

// F-32: server-side substitution — the indexed HTML must never contain a literal
// {n}/{date} token. Anchor date is formatted with mandatory timeZone: 'UTC' (a
// Chilean reader would otherwise see the label off by one day).
const anchorLabel = facets.anchorDate
  ? new Date(facets.anchorDate + 'T00:00:00Z').toLocaleDateString('en-US', {
      timeZone: 'UTC',
      month: 'short',
      day: 'numeric',
    })
  : '—';
const resultCountText = t.news_result_count.replace('{n}', String(incidents.length));
const windowLatestText = t.news_window_latest.replace('{date}', anchorLabel);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Recent Crime Incidents in Chile",
  "description": "Recent crime incidents reported in Chilean news media, geolocated by commune. Each incident cites and links to its source article.",
  "url": "https://ischilesafe.com/news/",
};
---

<EditorialLayout
  lang="en"
  title="Chile Crime News — Recent Reported Incidents"
  description="Recent crime incidents reported in Chilean news media, geolocated by commune. Each incident cites and links to its source article."
  enPath="/news/"
  esPath="/es/noticias/"
  jsonLd={jsonLd}
>
  <section>
    <h1>Recent Crime Incidents in Chile</h1>
    <p>
      This page surfaces recent crime incidents reported in Chilean news media and geolocated
      by commune. Each entry links to its original source article and to the commune page where
      more CEAD statistical context is available. Incidents are extracted from RSS feeds and
      classified by our automated pipeline. Attribution is always provided; no absolute
      risk verdicts are made.
    </p>
    {generated && (
      <p class="freshness">
        <time datetime={generated}>Updated {formattedDate}</time>
      </p>
    )}
    <p class="facet-semantics-note" id="news-facet-semantics">{t.news_facet_semantics_note}</p>
  </section>

  {incidents.length > 0 && (
    <details class="news-filter-bar" id="news-filters" open>
      <summary>{t.news_filter_heading}</summary>
      <div class="filter-groups">
        <fieldset class="filter-group" data-facet="window">
          <legend>{t.news_filter_window_label}</legend>
          <label class="filter-chip">
            <input type="radio" name="window" value="today" />
            <span class="filter-opt-label">{windowLatestText}</span>
            <span class="filter-count">{facets.byWindow.today.length}</span>
          </label>
          <label class="filter-chip">
            <input type="radio" name="window" value="7d" />
            <span class="filter-opt-label">{t.news_window_7d_label}</span>
            <span class="filter-count">{facets.byWindow.sevenDay.length}</span>
          </label>
          <label class="filter-chip">
            <input type="radio" name="window" value="30d" />
            <span class="filter-opt-label">{t.news_window_30d_label}</span>
            <span class="filter-count">{facets.byWindow.thirtyDay.length}</span>
          </label>
          <label class="filter-chip">
            <input type="radio" name="window" value="" checked />
            <span class="filter-opt-label">{t.news_window_all}</span>
            <span class="filter-count">{incidents.length}</span>
          </label>
        </fieldset>
        <fieldset class="filter-group" data-facet="region">
          <legend>{t.news_filter_region_label}</legend>
          {facets.byRegion.map((r) => (
            <label class="filter-chip">
              <input type="checkbox" name="region" value={r.regionId} />
              <span class="filter-opt-label">{regionNames.get(r.regionId) ?? r.regionId}</span>
              <span class="filter-count">{r.count}</span>
            </label>
          ))}
        </fieldset>
        <fieldset class="filter-group" data-facet="family">
          <legend>{t.news_filter_family_label}</legend>
          {facets.byFamily.map((f) => (
            <label class="filter-chip">
              <input type="checkbox" name="family" value={f.key} />
              <span class="filter-opt-label">{familyLabel(f.key)}</span>
              <span class="filter-count">{f.count}</span>
            </label>
          ))}
        </fieldset>
        <div class="filter-group" data-facet="comuna-search">
          <label for="news-comuna-q">{t.news_search_comuna_label}</label>
          <input
            type="search"
            id="news-comuna-q"
            placeholder={t.news_search_comuna_placeholder}
            autocomplete="off"
          />
        </div>
      </div>
      <p class="filter-actions">
        <span
          id="news-result-count"
          role="status"
          aria-live="polite"
          data-result-count-template={t.news_result_count}
        >
          {resultCountText}
        </span>
        <button type="button" id="news-clear-filters">{t.news_clear_filters}</button>
      </p>
    </details>
  )}

  <div id="news-empty" hidden>
    <p>{t.news_empty_heading}</p>
    <p>{t.news_empty_body}</p>
  </div>

  {incidents.length === 0 ? (
    <section>
      <p class="empty-state">No incidents available yet. Check back soon.</p>
    </section>
  ) : (
    Array.from(monthGroups.entries()).map(([yearMonth, groupIncidents]) => (
      <section class="news-month-section" id={'month-' + yearMonth}>
        <h2 class="news-date-group">{formatMonth(yearMonth)}</h2>
        {groupIncidents.map((incident) => {
          const communeInfo = getCommuneInfo(incident);
          return (
            <article
              class="news-card"
              data-family={incident.family ?? ''}
              data-region-id={cutToRegion.get(String(incident.cut)) ?? ''}
              data-year-month={yearMonth}
              data-commune-norm={communeInfo ? norm(communeInfo.name) : ''}
              data-date={incident.date}
            >
              <h3 class="news-title">
                <a href={safeUrl(incident.url)} target="_blank" rel="noopener noreferrer">
                  {incident.title_en}
                </a>
              </h3>
              <p class="news-meta">
                {incident.family && (
                  <span class="news-type-chip">{familyLabel(incident.family)}</span>
                )}
                {communeInfo && (
                  <span class="news-commune-chip">
                    <a href={'/commune/' + communeInfo.slug + '/'}>
                      {communeInfo.name}
                    </a>
                  </span>
                )}
                <span class="news-date-outlet">{incident.date} · {incident.outlet}</span>
              </p>
            </article>
          );
        })}
      </section>
    ))
  )}
  {/* H-2: set:html is unescaped; a `</script>` inside a serialized string (e.g. a
      poisoned family key from the LLM classifier) would close this element early
      and break out into markup — escape `<` at the serialization boundary. */}
  <script type="application/json" id="news-facets" set:html={escapeForInlineScript(JSON.stringify(facetsProjection))}></script>
  <script>
    import {
      parseFilterParams,
      serializeFilterParams,
      norm,
      cardMatchesFilters,
      computeFacetCounts,
      FILTER_LOGIC_MARKER,
      type FilterParams,
      type CardFilterState,
    } from '../lib/newsFilterLogic';

    (function () {
      const filtersElMaybe = document.getElementById('news-filters');
      if (!filtersElMaybe) return; // no incidents rendered — nothing to wire
      const filtersEl: HTMLElement = filtersElMaybe;

      filtersEl.setAttribute('data-filter-logic', FILTER_LOGIC_MARKER);

      const facetsBlob = document.getElementById('news-facets');
      let anchorDate: string | null = null;
      try {
        const parsed = JSON.parse(facetsBlob?.textContent || '{}');
        anchorDate = parsed.anchorDate ?? null;
      } catch {
        anchorDate = null;
      }

      const cardEls = Array.from(document.querySelectorAll<HTMLElement>('.news-card'));
      const cards: { el: HTMLElement; state: CardFilterState }[] = cardEls.map((el) => ({
        el,
        state: {
          family: el.getAttribute('data-family') || '',
          regionId: el.getAttribute('data-region-id') || '',
          date: el.getAttribute('data-date') || '',
          communeNorm: el.getAttribute('data-commune-norm') || '',
        },
      }));

      const monthSections = Array.from(
        document.querySelectorAll<HTMLElement>('.news-month-section')
      );

      const resultCountEl = document.getElementById('news-result-count');
      const resultCountTemplate = resultCountEl?.dataset.resultCountTemplate || '{n}';
      const emptyEl = document.getElementById('news-empty');
      const comunaInput = document.getElementById('news-comuna-q') as HTMLInputElement | null;
      const clearBtn = document.getElementById('news-clear-filters');

      let active: FilterParams = parseFilterParams(window.location.search);

      // Pre-populate controls from parsed params (T-12-01: value assignment only, never innerHTML)
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
        input.checked = input.value === active.window;
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((input) => {
        input.checked = active.region.includes(input.value);
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach((input) => {
        input.checked = active.family.includes(input.value);
      });
      if (comunaInput && active.q) {
        comunaInput.value = active.q;
      }

      function applyFilters(): void {
        let visibleTotal = 0;

        for (const { el, state } of cards) {
          const matches = cardMatchesFilters(state, active, anchorDate);
          el.hidden = !matches;
          if (matches) visibleTotal++;
        }

        for (const section of monthSections) {
          const visibleInSection = Array.from(
            section.querySelectorAll<HTMLElement>('.news-card')
          ).some((card) => !card.hidden);
          section.hidden = !visibleInSection;
        }

        if (emptyEl) emptyEl.hidden = visibleTotal !== 0;

        if (resultCountEl) {
          resultCountEl.textContent = resultCountTemplate.replace('{n}', String(visibleTotal));
        }

        // F-28 self-exclusion per-option counts, sourced from card data-* attrs (F-29)
        const windowKeys = ['today', '7d', '30d'];
        const windowCounts = computeFacetCounts(
          cards.map((c) => c.state),
          active,
          anchorDate,
          'window',
          windowKeys
        );
        // "All dates" (value="") has no window predicate of its own — its self-exclusion
        // count is simply how many cards match every OTHER active filter dimension.
        const allDatesCount = cards.filter((c) =>
          cardMatchesFilters(c.state, active, anchorDate, 'window')
        ).length;
        filtersEl.querySelectorAll<HTMLElement>('[data-facet="window"] label.filter-chip').forEach((label) => {
          const input = label.querySelector('input') as HTMLInputElement | null;
          const countEl = label.querySelector('.filter-count');
          if (!input || !countEl) return;
          countEl.textContent = String(input.value === '' ? allDatesCount : windowCounts[input.value] ?? 0);
        });

        const regionKeys = Array.from(
          filtersEl.querySelectorAll<HTMLInputElement>('[data-facet="region"] input')
        ).map((i) => i.value);
        const regionCounts = computeFacetCounts(
          cards.map((c) => c.state),
          active,
          anchorDate,
          'region',
          regionKeys
        );
        filtersEl.querySelectorAll<HTMLElement>('[data-facet="region"] label.filter-chip').forEach((label) => {
          const input = label.querySelector('input') as HTMLInputElement | null;
          const countEl = label.querySelector('.filter-count');
          if (!input || !countEl) return;
          countEl.textContent = String(regionCounts[input.value] ?? 0);
        });

        const familyKeys = Array.from(filtersEl.querySelectorAll<HTMLInputElement>('[data-facet="family"] input')).map((i) => i.value);
        const familyCounts = computeFacetCounts(
          cards.map((c) => c.state),
          active,
          anchorDate,
          'family',
          familyKeys
        );
        filtersEl.querySelectorAll<HTMLElement>('[data-facet="family"] label.filter-chip').forEach((label) => {
          const input = label.querySelector('input') as HTMLInputElement | null;
          const countEl = label.querySelector('.filter-count');
          if (!input || !countEl) return;
          countEl.textContent = String(familyCounts[input.value] ?? 0);
        });

        const nextParams = new URLSearchParams(location.search);
        nextParams.delete('family');
        nextParams.delete('region');
        nextParams.delete('window');
        nextParams.delete('q');
        for (const [key, value] of new URLSearchParams(serializeFilterParams(active))) {
          nextParams.set(key, value);
        }
        const qs = nextParams.toString();
        history.replaceState(
          null,
          '',
          location.pathname + (qs ? '?' + qs : '') + location.hash
        );
      }

      filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
        input.addEventListener('change', () => {
          active = { ...active, window: input.value as FilterParams['window'] };
          applyFilters();
        });
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((input) => {
        input.addEventListener('change', () => {
          const checked = Array.from(
            filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"]:checked')
          ).map((i) => i.value);
          active = { ...active, region: checked };
          applyFilters();
        });
      });
      filtersEl.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach((input) => {
        input.addEventListener('change', () => {
          const checked = Array.from(
            filtersEl.querySelectorAll<HTMLInputElement>('input[name="family"]:checked')
          ).map((i) => i.value);
          active = { ...active, family: checked };
          applyFilters();
        });
      });
      if (comunaInput) {
        comunaInput.addEventListener('input', () => {
          active = { ...active, q: comunaInput.value };
          applyFilters();
        });
      }
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          active = { family: [], region: [], window: '', q: '' };
          filtersEl.querySelectorAll<HTMLInputElement>('input[name="window"]').forEach((input) => {
            input.checked = input.value === '';
          });
          filtersEl.querySelectorAll<HTMLInputElement>('input[name="region"], input[name="family"]').forEach((input) => {
            input.checked = false;
          });
          if (comunaInput) comunaInput.value = '';
          applyFilters();
        });
      }

      applyFilters();
    })();
  </script>
</EditorialLayout>

<style>
  section {
    margin-bottom: var(--2xl);
  }

  .news-month-section {
    margin-bottom: var(--xl);
  }

  .news-date-group {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--md);
    padding-bottom: var(--xs);
    border-bottom: 1px solid var(--line);
  }

  .news-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--md);
    margin-bottom: var(--md);
  }

  .news-title {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    margin-bottom: var(--xs);
    line-height: 1.25;
  }

  .news-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .news-title a:hover {
    text-decoration: underline;
    color: var(--primary);
  }

  .news-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--xs);
    margin: 0;
  }

  /* P1-6: compact badge — named 12px exception for dense news list */
  .news-type-chip,
  .news-commune-chip {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 var(--sm);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    background: var(--line);
    color: var(--ink);
    margin-right: var(--xs);
  }

  .news-commune-chip a {
    color: var(--ink);
    text-decoration: none;
  }

  .news-commune-chip:hover {
    background: var(--bg);
  }

  .news-date-outlet {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .freshness {
    font-size: var(--text-label);
    color: var(--muted);
    margin-top: var(--sm);
  }

  .empty-state {
    color: var(--muted);
    font-style: italic;
  }

  /* Phase 28 — filter bar (UI-SPEC: subordinate to the card list, no accent wash) */
  .news-filter-bar {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--lg);
    margin-bottom: var(--xl);
    background: #fff;
  }

  .news-filter-bar summary {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  .filter-groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lg);
    margin-top: var(--md);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--sm);
  }

  .filter-group legend,
  .filter-group > label[for] {
    font-size: var(--text-label);
    font-weight: var(--weight-strong);
    color: var(--ink);
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--xs);
    min-height: 44px;
    padding: 0 var(--sm);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .filter-chip:has(input:checked) {
    background: var(--primary);
    color: #fff;
    border-radius: 4px;
  }

  .filter-count {
    color: var(--muted);
    font-size: var(--text-label);
    font-weight: 400;
  }

  .filter-chip:has(input:checked) .filter-count {
    color: #fff;
  }

  #news-comuna-q {
    min-height: 44px;
    padding: 0 var(--sm);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .filter-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    margin-top: var(--lg);
  }

  #news-result-count {
    font-size: var(--text-body);
    color: var(--primary);
  }

  #news-clear-filters {
    background: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--primary);
    padding: var(--xs) var(--sm);
    min-height: 44px;
    cursor: pointer;
  }

  #news-empty {
    padding: var(--lg);
    margin-bottom: var(--xl);
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 480px) {
    .filter-groups {
