---
/**
 * EN crime-type ranking page — /crime-ranking/{crime}/
 *
 * Rankings v2: the table, the year selector, the search box, the region filter
 * and the regional breakdown now live in RankingBoard.astro. The frontmatter
 * (data loading, national ranks, JSON-LD, hreflang) is unchanged.
 *
 * Changes from the previous version:
 *   - CRIME_RANKING_DEFS now comes from config/rankingStrings.ts (it used to be
 *     duplicated verbatim in this page and in its ES twin).
 *   - regionSlug is resolved here so the regional panel can link out.
 *   - RankingTableEnhancer and TrendChip are no longer used on this page.
 *
 * Zero client:* directives.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapPlaceholderSlot from '../../components/MapPlaceholderSlot.astro';
import MethodologyCaveat from '../../components/MethodologyCaveat.astro';
import RankingBoard from '../../components/RankingBoard.astro';
import { loadIndex, loadCommune, loadRegion, regionFileId } from '../../lib/data.ts';
import { FAMILY_LABELS_EN, RANKING_METHODOLOGY_EN, RANKING_RATE_EXPLAINER_EN } from '../../lib/familyDefs';
import { RANKING_DEFS } from '../../config/rankingStrings.ts';
import { buildBreadcrumb, buildItemList } from '../../lib/jsonld.ts';

export async function getStaticPaths() {
  return RANKING_DEFS.map((def) => ({
    params: { crime: def.en },
    props: { familyKey: def.familyKey, dataSource: def.dataSource, esParam: def.es },
  }));
}

const { crime } = Astro.params;
const { familyKey, dataSource, esParam } = Astro.props as {
  familyKey: string;
  dataSource: 'featured_rates' | 'by_family';
  esParam: string;
};

const index = loadIndex();

type Row = {
  name: string;
  slug: string;
  cut: string;
  regionName: string;
  regionSlug: string;
  regionId: number;
  rate: number;
  low_population: boolean;
  nationalRank: number | null;
  ratesByYear: Record<number, number>;
};

const regionCache = new Map<string, { name: string; slug: string }>();
function region(fileId: string) {
  if (!regionCache.has(fileId)) {
    try {
      const r = loadRegion(fileId);
      regionCache.set(fileId, { name: r.name, slug: r.slug });
    } catch {
      regionCache.set(fileId, { name: `Region ${fileId}`, slug: fileId });
    }
  }
  return regionCache.get(fileId)!;
}

const allRows: Omit<Row, 'nationalRank'>[] = [];
// Capture the latest complete year while iterating communes (CR-02).
// B-01 fix: derive latestYear from the data itself, never from the wall clock.
let latestYear = 0;
for (const meta of index) {
  const commune = loadCommune(meta.cut);
  if (!meta.low_population) {
    latestYear = Math.max(latestYear, commune.latestCompleteYear);
  }
  let rate: number;
  if (dataSource === 'featured_rates') {
    // Homicide subgroup 101 — lives in featured_rates, NOT by_family (Pitfall 1)
    rate = commune.featured_rates?.homicidios?.[commune.latestCompleteYear] ?? 0;
  } else {
    const entry = commune.series.find((s) => s.year === commune.latestCompleteYear && !s.partial);
    rate = entry?.by_family?.[familyKey] ?? 0;
  }
  // ratesByYear: complete years only (D-3)
  const ratesByYear: Record<number, number> = {};
  const completeYears = new Set(commune.series.filter((s) => !s.partial).map((s) => s.year));
  if (dataSource === 'featured_rates') {
    const hom = commune.featured_rates?.homicidios ?? {};
    for (const [y, v] of Object.entries(hom)) {
      const yr = Number(y);
      if (completeYears.has(yr)) ratesByYear[yr] = v as number;
    }
  } else {
    commune.series.filter((s) => !s.partial).forEach((s) => {
      ratesByYear[s.year] = s.by_family?.[familyKey] ?? 0;
    });
  }
  const rFileId = regionFileId(meta.region_id);
  const reg = region(rFileId);
  allRows.push({
    name: meta.name,
    slug: meta.slug,
    cut: meta.cut,
    regionName: commune.regionName,
    regionSlug: reg.slug,
    regionId: Number(rFileId),
    rate,
    low_population: meta.low_population,
    ratesByYear,
  });
}

const eligibleRows = allRows.filter((r) => !r.low_population).sort((a, b) => b.rate - a.rate);
const lowPopRows = allRows.filter((r) => r.low_population).sort((a, b) => b.rate - a.rate);

// Stable national rank assigned before any filter (CR-01)
let rankCounter = 0;
const rankingRows: Row[] = [
  ...eligibleRows.map((row) => ({ ...row, nationalRank: ++rankCounter })),
  ...lowPopRows.map((row) => ({ ...row, nationalRank: null })),
];

const familyNationalMean =
  eligibleRows.length > 0 ? eligibleRows.reduce((sum, r) => sum + r.rate, 0) / eligibleRows.length : 0;

const enPath = `/crime-ranking/${crime}/`;
const esPath = `/es/ranking-delito/${esParam}/`;

const familyLabel = FAMILY_LABELS_EN[familyKey] ?? familyKey;
const familyDef = RANKING_METHODOLOGY_EN[familyKey] ?? '';

const title = `Communes with the highest reported ${familyLabel.toLowerCase()} incidence in Chile — Chile Safety Map`;
const description = `Compare reported ${familyLabel.toLowerCase()} rates per 100,000 inhabitants across every commune in Chile. Official CEAD data, with national ranking.`;

const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${familyLabel} — National Ranking by Commune (Chile)`,
  description: `Annual reported ${familyLabel.toLowerCase()} rates per 100,000 inhabitants for every commune in Chile, sourced from CEAD (Centro de Estudios y Análisis del Delito).`,
  url: `https://ischilesafe.com${enPath}`,
  spatialCoverage: { '@type': 'Country', name: 'Chile' },
  temporalCoverage: `2005/${latestYear}`,
  measurementTechnique: 'Rate per 100,000 inhabitants, CEAD official police statistics',
  creator: { '@type': 'Organization', name: 'CEAD — Centro de Estudios y Análisis del Delito' },
};

const breadcrumb = buildBreadcrumb([
  { name: 'Home', url: 'https://ischilesafe.com/' },
  { name: 'Rankings', url: 'https://ischilesafe.com/rankings/' },
  { name: familyLabel },
]);

const eligibleRankingRows = rankingRows.filter((r) => !r.low_population);
const ranking = buildItemList(eligibleRankingRows, 'en', {
  name: `Communes by reported ${familyLabel.toLowerCase()} incidence (descending)`,
  order: 'Descending',
});

const jsonLd = [jsonLdDataset, breadcrumb, ranking];
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="crime-type-map"
  pageType="crime"
>
  <section class="crime-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <a href="/rankings/">Rankings</a>
      <span aria-hidden="true"> › </span>
      <span>{familyLabel}</span>
    </nav>
    <h1 class="crime-h1">
      Communes with the highest reported {familyLabel.toLowerCase()} incidence in Chile
    </h1>
    <p class="crime-def">{familyDef}</p>
    <p class="crime-def">{RANKING_RATE_EXPLAINER_EN}</p>
    <p class="hero-caveat">
      The national average is the <strong>simple mean across communes</strong> for this crime family
      (communes ≥ 10,000 inhabitants, latest complete year).
      <a href="/methodology/#comparison-criteria">Methodology</a>.
    </p>
  </section>

  <section aria-label="National ranking of communes">
    <h2 class="rk-section-h2">
      Communes ranked by {familyLabel.toLowerCase()} rate per 100,000 inhabitants (<span id="rk-year-label">{latestYear}</span>)
    </h2>
    <RankingBoard
      lang="en"
      familyKey={familyKey}
      latestYear={latestYear}
      mean={familyNationalMean}
      rows={rankingRows}
    />
  </section>

  <MapPlaceholderSlot mountType="crime-type-map" locale="en" />
  <MethodologyCaveat locale="en" />
</BaseLayout>

<style>
  .crime-hero { padding: var(--xl) 0 var(--lg); }

  .breadcrumb { font-size: var(--text-label); color: var(--muted); margin-bottom: var(--sm); }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--primary); }

  .crime-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
  }

  .crime-def {
    font-size: var(--text-body);
    color: var(--muted);
    margin: var(--sm) 0;
    max-width: 68ch;
  }

  .hero-caveat { font-size: var(--text-label); color: var(--muted); margin-top: var(--xs); }

  .rk-section-h2 {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: 0 0 var(--md);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
