---
/**
 * EN commune page — /commune/{slug}/
 *
 * getStaticPaths reads loadRolloutCuts() (the rollout gate, D-24/PAGES-04).
 * Non-rollout communes are NOT built — true 404 (D-26).
 *
 * vs-national and vs-regional computed against per-capita MEANS:
 *   loadNationalAverage() and loadRegionalAverage(region_id)
 * NEVER against loadNational()/loadRegion() series rate (pop-weighted incidence,
 * not the unweighted commune-mean these comparisons need — Pitfall 1).
 *
 * Zero client:* directives (D-09). All components are static .astro.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LevelChip from '../../components/LevelChip.astro';
import TrendChip from '../../components/TrendChip.astro';
import StatCard from '../../components/StatCard.astro';
import Sparkline from '../../components/Sparkline.astro';
import ComparisonCallout from '../../components/ComparisonCallout.astro';
import FamilyBreakdownBars from '../../components/FamilyBreakdownBars.astro';
import ComparableCommune from '../../components/ComparableCommune.astro';
import CommuneNewsSection from '../../components/CommuneNewsSection.astro';
import CommuneRankingTable from '../../components/CommuneRankingTable.astro';
import ComparatorPairsLinks from '../../components/ComparatorPairsLinks.astro';
import { FAMILY_SLUGS } from '../../config/i18n.ts';
import CrimeFamilyCharts from '../../components/CrimeFamilyCharts.astro';
import { FAMILY_ORDER } from '../../lib/familyDefs';
import MethodologyCaveat from '../../components/MethodologyCaveat.astro';
import {
  loadCommune,
  loadRegion,
  regionFileId,
  loadRolloutCuts,
  loadNationalAverage,
  loadRegionalAverage,
  nearestComparable,
  nearestComparables,
  latestCompleteYearRate,
  loadIndex,
  loadEnabledPairSlugs,
} from '../../lib/data.ts';
import { buildCommuneProse } from '../../lib/proseEngine.ts';
import { buildBreadcrumb, buildItemList } from '../../lib/jsonld.ts';
import { levelForRate } from '../../lib/colorScale.ts';
import { EN_STRINGS } from '../../config/i18n.ts';

export async function getStaticPaths() {
  const cuts = loadRolloutCuts();
  return cuts.map((cut) => {
    const meta = loadIndex().find((c) => c.cut === cut);
    return {
      params: { slug: meta?.slug ?? cut },
      props: { cut },
    };
  });
}

// --- Page-level data ---
const { cut } = Astro.props as { cut: string };
const data = loadCommune(cut);
const year = data.latestCompleteYear;
const rate = latestCompleteYearRate(data);

// Dimension 1: vs-national (MEAN, not SUM)
const nationalAvg = loadNationalAverage();
const vsNationalPct = nationalAvg > 0 ? ((rate - nationalAvg) / nationalAvg) * 100 : 0;
const vsNationalDir: 'above' | 'below' = vsNationalPct >= 0 ? 'above' : 'below';

// Dimension 2: vs-regional (MEAN, not SUM)
const regionalAvg = loadRegionalAverage(data.region_id);
const vsRegionalPct = regionalAvg > 0 ? ((rate - regionalAvg) / regionalAvg) * 100 : 0;
const vsRegionalDir: 'above' | 'below' = vsRegionalPct >= 0 ? 'above' : 'below';

// Dimension 4: dominant + secondary family
const seriesEntry = data.series.find((s) => s.year === year && !s.partial);
const byFamily = seriesEntry?.by_family ?? {};

// Dimension 5: comparable commune
const comparable = nearestComparable(cut);

// Region slug for breadcrumb — resolve via the region file, NOT data.slug
// (data.slug is the commune slug; region pages are built at /region/{region.slug}/).
const regionSlug = loadRegion(regionFileId(data.region_id)).slug;

// Compute incidence level (1–5) for LevelChip
const allRates = loadIndex()
  .filter((c) => !c.low_population)
  .map((c) => latestCompleteYearRate(loadCommune(c.cut)))
  .sort((a, b) => a - b);
const level = levelForRate(rate, allRates);

// Region commune count for regional-rank device (#N of M)
// region_id is the clean 1–16 region (999.1 resolved, quick-260616-ldi) so this
// count is exact — no more Tarapacá 11/14 collision with Aysén/Los Ríos.
const regionCommuneCount = loadIndex().filter(
  (c) => c.region_id === data.region_id
).length;

// Percentile rank cards (260620-hrh)
// national_rank/regional_rank are DESCENDING (rank 1 = highest incidence).
// Percentile = fraction of communes with MORE incidence than this one, clamped 1–99.
const NAT_TOTAL = 346;
const natPct = Math.min(99, Math.max(1, Math.round((NAT_TOTAL - data.national_rank) / NAT_TOTAL * 100)));
const regPct = Math.min(99, Math.max(1, Math.round((regionCommuneCount - data.regional_rank) / regionCommuneCount * 100)));

// Similar comunas in same region (D-07)
const similarComunas = nearestComparables(cut, 5);

// Comparator pairs for ComparatorPairsLinks (same-region, up to 5, sorted CUTs)
// Only enabled pairs are linked — prevents internal 404 links (BUG-2 fix).
// Fall back to including low_population communes when no non-low-pop neighbors exist
// (e.g., Arica is the only non-low-pop commune in its region — Pitfall guard).
const allIndex = loadIndex();
const currentMeta = allIndex.find((c) => c.cut === cut);
const _sameRegionNonLP = allIndex.filter(
  (c) => c.region_id === (currentMeta?.region_id ?? '') && c.cut !== cut && !c.low_population
);
const _sameRegionCandidates = _sameRegionNonLP.length > 0
  ? _sameRegionNonLP
  : allIndex.filter((c) => c.region_id === (currentMeta?.region_id ?? '') && c.cut !== cut);
const _enabledSlugs = loadEnabledPairSlugs();
const comparatorPairs = _sameRegionCandidates.slice(0, 5).map((c) => {
  const sorted = [cut, c.cut].sort();
  const pA = sorted[0]!;
  const pB = sorted[1]!;
  return {
    cutA: pA,
    cutB: pB,
    nameA: pA === cut ? data.name : c.name,
    nameB: pB === cut ? data.name : c.name,
  };
}).filter((p) => _enabledSlugs.has(`${p.cutA}-vs-${p.cutB}`));

// Prose
const prose = buildCommuneProse(data, 'en');

// Year selector data map — all years in series (complete + partial)
const availableYears = [...data.series]
  .sort((a, b) => b.year - a.year)
  .map((s) => s.year);

const yearData: Record<string, {
  rate: number;
  byFamily: Record<string, number>;
  homRate: number | null;
  homCount: number | null;
}> = {};
for (const s of data.series) {
  const yrStr = String(s.year);
  const homRateVal = data.featured_rates?.homicidios?.[yrStr];
  const homCountVal = data.featured_rates?.homicidios_count?.[yrStr];
  yearData[yrStr] = {
    rate: s.rate_per_100k,
    byFamily: s.by_family,
    homRate: homRateVal !== undefined ? homRateVal : null,
    homCount: homCountVal !== undefined ? homCountVal : null,
  };
}

// URLs
const enPath = `/commune/${data.slug}/`;
const esPath = `/es/comuna/${data.slug}/`;

// Meta
const t = EN_STRINGS;

// i18n strings needed by vanilla JS (passed via JSON island — no {expr} in <script>)
const yearI18n = {
  rateLabelTemplate: t.rate_label,          // 'Rate per 100,000 inhabitants ({year})'
  familyHeadingTemplate: t.family_breakdown_heading, // 'Reported incidence by crime category ({year})'
  homHeadingTemplate: 'Homicides ({year})',
  homSourceTemplate: 'Source: CEAD, subgroup 101 Life Crimes ({year})',
  homEmptyTemplate: 'No reported cases — CEAD {year}',
  homUnit: 'per 100,000 inhabitants',
  casesSingular: 'case',
  casesPlural: 'cases',
  locale: 'en-US',
  familyOrder: [...FAMILY_ORDER],
};
const title = `${data.name} Crime Data — Chile Safety Map`;
const description = `Official CEAD crime statistics for ${data.name}, ${data.regionName}: reported incidence rate, national ranking, annual evolution 2005–${year}.`;

// JSON-LD: Dataset + Place (UI-SPEC lines 270-286)
const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': ['Dataset', 'Place'],
  name: `${data.name} — Reported Crime Incidence`,
  description: `Annual reported crime incidence rates per 100,000 inhabitants for ${data.name}, sourced from CEAD (Centro de Estudios y Análisis del Delito), Chile.`,
  url: `https://ischilesafe.com/commune/${data.slug}/`,
  spatialCoverage: {
    '@type': 'Place',
    name: data.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: data.regionName },
  },
  temporalCoverage: `2005/${year}`,
  measurementTechnique: 'Rate per 100,000 inhabitants, official CEAD police statistics',
  creator: { '@type': 'Organization', name: 'CEAD — Centro de Estudios y Análisis del Delito' },
};

// BreadcrumbList: mirrors 4-level visual breadcrumb Home › Communes › {Region} › {Commune}
const breadcrumb = buildBreadcrumb([
  { name: 'Home',          url: 'https://ischilesafe.com/' },
  { name: 'Communes',      url: 'https://ischilesafe.com/communes/' },
  { name: data.regionName, url: `https://ischilesafe.com/region/${regionSlug}/` },
  { name: data.name },  // current — omits item per spec
]);

// ItemList: "similar comunas" by proximity — NOT a safety rank (resolved A1 / T-13-05)
const similarList = buildItemList(similarComunas, 'en', { order: 'Unordered' });

const jsonLd = [jsonLdDataset, breadcrumb, similarList];
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="commune-map"
  pageType="commune"
>
  <!-- 2. CommuneHero -->
  <section class="commune-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <a href="/communes/">Communes</a>
      <span aria-hidden="true"> › </span>
      <a href={`/region/${regionSlug}/`}>{data.regionName}</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">{data.name}</span>
    </nav>
    <h1 class="commune-h1">{data.name}</h1>
    <div class="hero-meta">
      <LevelChip level={level} locale="en" />
      <span class="population-note">Population: {data.population.toLocaleString()}</span>
    </div>
    {data.low_population && (
      <p class="low-pop-caveat">{t.low_population_caveat}</p>
    )}
    <!-- Year selector — moved into hero for prominence (260620-hrh) -->
    <div class="year-selector-row">
      <label for="year-select" class="year-selector-label">{t.year_selector_label}</label>
      <select id="year-select" class="year-selector-select">
        {availableYears.map((y) => (
          <option value={String(y)} selected={y === year}>{y}</option>
        ))}
      </select>
    </div>
  </section>

  <!-- 3. KeyStatsRow -->
  <section class="key-stats-row" aria-label="Key statistics">
    <!-- Rate card — inline to allow id hooks for year selector JS -->
    <div class="stat-card">
      <div class="stat-value" id="rate-value">{Math.round(rate).toLocaleString('en-US')}</div>
      <div class="stat-label" id="rate-label">{t.rate_label.replace('{year}', String(year))}</div>
    </div>
    <StatCard
      value={t.rank_pct_value.replace('{pct}', String(natPct))}
      label={t.rank_national_label}
      sublabel={t.rank_sublabel.replace('{year}', String(year)).replace('{rank}', String(data.national_rank)).replace('{total}', String(NAT_TOTAL))}
    />
    <StatCard
      value={t.rank_pct_value.replace('{pct}', String(regPct))}
      label={t.rank_regional_label.replace('{region}', data.regionName)}
      sublabel={t.rank_sublabel.replace('{year}', String(year)).replace('{rank}', String(data.regional_rank)).replace('{total}', String(regionCommuneCount))}
    />
  </section>

  <!-- JSON islands: year data + i18n strings for vanilla JS (no {expr} in script) -->
  <script type="application/json" id="year-data" set:html={JSON.stringify(yearData)}></script>
  <script type="application/json" id="year-i18n" set:html={JSON.stringify(yearI18n)}></script>

  <!-- 4. SparklineSection -->
  <section class="sparkline-section" aria-label="Annual evolution">
    <h2 class="section-heading">{t.sparkline_heading}</h2>
    <Sparkline series={data.series} activeYear={year} />
    <TrendChip trend={data.trend} locale="en" />
  </section>

  <!-- 5. ComparisonCallouts -->
  <section class="comparison-callouts" aria-label="National and regional comparisons">
    <ComparisonCallout
      pct={vsNationalPct}
      direction={vsNationalDir}
      scope="national"
      locale="en"
    />
    <ComparisonCallout
      pct={vsRegionalPct}
      direction={vsRegionalDir}
      scope="regional"
      locale="en"
    />
  </section>

  <!-- 6. CrimeFamilyBreakdown -->
  <section class="family-breakdown" aria-label="Crime family breakdown">
    <h2 class="section-heading" id="family-heading">
      {t.family_breakdown_heading.replace('{year}', String(year))}
    </h2>
    <FamilyBreakdownBars byFamily={byFamily} locale="en" level={level} />
  </section>

  <!-- 6a. Homicide rate (HOM-02 parity with map ResultPanel) — distinct from the broad vida/Life-crimes family -->
  {(() => {
    const hom = data.featured_rates?.homicidios;
    const homCount = data.featured_rates?.homicidios_count;
    // 0 is valid data — use !== undefined, never truthiness
    const homRate = hom !== undefined && hom[String(year)] !== undefined ? hom[String(year)] : null;
    const count = homCount !== undefined && homCount[String(year)] !== undefined ? homCount[String(year)] : null;
    return (
      <section class="homicide-section" aria-label="Homicide rate">
        <h2 class="section-heading" id="hom-heading">{`Homicides (${year})`}</h2>
        <p class="homicide-figure" style={homRate !== null ? undefined : 'display:none'}>
          <span class="homicide-rate" id="hom-rate">{homRate !== null ? Math.round(homRate).toLocaleString('en-US') : ''}</span>
          <span class="homicide-unit"> per 100,000 inhabitants</span>
          <span class="homicide-count" id="hom-count" style={count !== null ? undefined : 'display:none'}> ({count} {count === 1 ? 'case' : 'cases'})</span>
        </p>
        <p class="homicide-empty" id="hom-empty" style={homRate === null ? undefined : 'display:none'}>{`No reported cases — CEAD ${year}`}</p>
        <p class="homicide-source" id="hom-source">Source: CEAD, subgroup 101 Life Crimes ({year})</p>
      </section>
    );
  })()}

  <!-- 6a-2. Longitudinal evolution charts — static SVG, zero JS, all years -->
  <CrimeFamilyCharts
    series={data.series}
    homicidios={data.featured_rates?.homicidios ?? {}}
    locale="en"
    heading={t.charts_heading}
  />
  <p class="chart-partial-note">{t.chart_partial_note}</p>

  <!-- 6b. Composite Crime Index section (CI-05/CI-06) — static index-mode surface, no map toggle -->
  {(() => {
    const COMPOSITE_YEAR = 2024;
    const ci = data.composite_index?.[String(COMPOSITE_YEAR)];
    if (!ci) return null;
    const BAND_EN_PAGE = ['Very Low', 'Low', 'Moderate', 'High', 'Very High'];
    const bandLabel = BAND_EN_PAGE[ci.level - 1] ?? '';
    return (
      <section class="panel-section composite-index-section" aria-label="Composite Crime Index">
        <h2 class="section-heading">{t.ci_section_heading}</h2>
        <div>
          <span class="ci-score-big">{Math.round(ci.score)}</span>
          <span class="ci-band-label">{bandLabel}</span>
        </div>
        <div class="ci-rank">
          {t.ci_rank_national.replace('#{rank}', `#${ci.rank}`).replace('{total}', '346')}
          {' · '}
          {t.ci_rank_regional.replace('#{rank}', `#${ci.regional_rank}`).replace('{region}', data.regionName)}
        </div>
        <div class="ci-caveat">{t.ci_caveat_text}</div>
      </section>
    );
  })()}

  <!-- 6c. ENUSC VHDV victimization module (VL-03/VL-04) -->
  {(() => {
    const vhdv = data.enusc_vhdv;
    if (!vhdv) {
      return (
        <section class="enusc-no-estimate" aria-label={t.enusc_no_estimate_aria}>
          <p class="enusc-no-estimate-text">{t.enusc_no_estimate_text}</p>
        </section>
      );
    }
    return (
      <section class="panel-section enusc-vhdv-section" aria-label={t.enusc_section_aria}>
        <h2 class="section-heading">{t.enusc_section_heading}</h2>
        <div class="enusc-rate">
          {(vhdv.vhdv_rate * 100).toFixed(1)}%
          <span class="enusc-year">(2024)</span>
        </div>
        <div class="enusc-ci">
          {t.enusc_ci_label}: {(vhdv.ci_lower * 100).toFixed(1)}% – {(vhdv.ci_upper * 100).toFixed(1)}%
        </div>
        <div class="enusc-caveat">{t.enusc_caveat_text}</div>
      </section>
    );
  })()}

  <!-- 6d. Recent news incidents (quick-260810-tqr) -->
  <CommuneNewsSection cut={data.cut} communeName={data.name} locale="en" />

  <!-- 7. ComparableCommune -->
  <ComparableCommune comparable={comparable} locale="en" />

  <!-- 8. Map spoke (D-08) — static link only, zero client:* -->
  <section class="map-spoke" aria-label="View on national map">
    <h2 class="section-heading">{t.map_spoke_heading}</h2>
    <a href={`/map/?cut=${data.cut}`} class="map-spoke-cta">
      {t.map_spoke_cta.replace('{name}', data.name)}
    </a>
  </section>

  <!-- 8b-pre. Comparator pairs spoke (CMP-06 / spine assertion M) — only rendered when enabled pairs exist -->
  {comparatorPairs.length > 0 && <ComparatorPairsLinks pairs={comparatorPairs} locale="en" />}

  <!-- 8b. Similar comunas in this region (D-07) -->
  <section class="similar-comunas-spoke" aria-label="Similar communes in this region">
    <h2 class="section-heading">{t.similar_communes_heading}</h2>
    <p class="spoke-intro">{t.similar_communes_intro.replace('{region}', data.regionName)}</p>
    <CommuneRankingTable rows={similarComunas} locale="en" />
  </section>

  <!-- 8c. Per-crime-type ranking spoke (D-10) -->
  <section class="crime-type-spoke" aria-label="Rankings by crime type">
    <h2 class="section-heading">{t.crime_type_heading}</h2>
    <ul class="crime-type-list">
      <li>
        <a href="/crime-ranking/homicide/">homicide ranking</a>
      </li>
      {Object.entries(byFamily).filter(([key]) => key !== 'vida').map(([key]) => (
        <li>
          <a href={`/crime/${FAMILY_SLUGS[key]?.en ?? key}/`}>
            {FAMILY_SLUGS[key]?.en ?? key} ranking
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 9. ProseSummary -->
  <section class="prose-summary" aria-label="Summary">
    {prose.split('\n\n').map((para) => <p>{para}</p>)}
  </section>

  <!-- 10. MethodologyCaveat -->
  <MethodologyCaveat locale="en" />
</BaseLayout>

<script>
// Year selector — vanilla JS, no framework island (D-09)
// All server data comes from JSON islands — NEVER from {expr} interpolation.
(function () {
  const yearDataEl = document.getElementById('year-data');
  const yearI18nEl = document.getElementById('year-i18n');
  const sel = document.getElementById('year-select') as HTMLSelectElement | null;
  if (!yearDataEl || !yearI18nEl || !sel) return;

  const yearData = JSON.parse(yearDataEl.textContent ?? '{}') as Record<string, {
    rate: number;
    byFamily: Record<string, number>;
    homRate: number | null;
    homCount: number | null;
  }>;

  const i18n = JSON.parse(yearI18nEl.textContent ?? '{}') as {
    rateLabelTemplate: string;
    familyHeadingTemplate: string;
    homHeadingTemplate: string;
    homSourceTemplate: string;
    homEmptyTemplate: string;
    homUnit: string;
    casesSingular: string;
    casesPlural: string;
    locale: string;
    familyOrder: string[];
  };

  function applyYear(yr: string) {
    const d = yearData[yr];
    if (!d) return;

    // Rate card
    const rateVal = document.getElementById('rate-value');
    const rateLbl = document.getElementById('rate-label');
    if (rateVal) rateVal.textContent = Math.round(d.rate).toLocaleString(i18n.locale);
    if (rateLbl) rateLbl.textContent = i18n.rateLabelTemplate.replace('{year}', yr);

    // Family heading
    const famHeading = document.getElementById('family-heading');
    if (famHeading) famHeading.textContent = i18n.familyHeadingTemplate.replace('{year}', yr);

    // Family bars
    const vals = i18n.familyOrder.map((key: string) => d.byFamily[key] ?? 0);
    const max = Math.max(...vals, 1);
    i18n.familyOrder.forEach((key: string, idx: number) => {
      const val = vals[idx] ?? 0;
      const pct = Math.round((val / max) * 100) + '%';
      const fillEl = document.querySelector(`.family-bar-fill[data-family="${key}"]`) as HTMLElement | null;
      const valEl = document.querySelector(`.family-bar-val[data-family="${key}"]`) as HTMLElement | null;
      if (fillEl) fillEl.style.width = pct;
      if (valEl) valEl.textContent = String(Math.round(val));
    });

    // Homicide section
    const homHeading = document.getElementById('hom-heading');
    const homRate = document.getElementById('hom-rate');
    const homCount = document.getElementById('hom-count');
    const homEmpty = document.getElementById('hom-empty');
    const homSource = document.getElementById('hom-source');
    if (homHeading) homHeading.textContent = i18n.homHeadingTemplate.replace('{year}', yr);
    if (homSource) homSource.textContent = i18n.homSourceTemplate.replace('{year}', yr);
    if (d.homRate !== null) {
      if (homRate) {
        homRate.textContent = Math.round(d.homRate).toLocaleString(i18n.locale);
        (homRate.parentElement as HTMLElement | null)?.style && ((homRate.parentElement as HTMLElement).style.display = '');
      }
      if (homEmpty) homEmpty.style.display = 'none';
      if (homCount) {
        if (d.homCount !== null) {
          homCount.textContent = ` (${d.homCount} ${d.homCount === 1 ? i18n.casesSingular : i18n.casesPlural})`;
          homCount.style.display = '';
        } else {
          homCount.style.display = 'none';
        }
      }
    } else {
      if (homRate) {
        const fig = homRate.closest('.homicide-figure') as HTMLElement | null;
        if (fig) fig.style.display = 'none';
      }
      if (homEmpty) {
        homEmpty.textContent = i18n.homEmptyTemplate.replace('{year}', yr);
        homEmpty.style.display = '';
      }
    }

    // Sparkline active rect
    const rects = document.querySelectorAll<SVGRectElement>('.sparkline rect[data-year]');
    rects.forEach((rect) => {
      rect.setAttribute('fill', rect.getAttribute('data-year') === yr ? 'var(--primary)' : 'var(--muted)');
    });
  }

  sel.addEventListener('change', () => {
    applyYear(sel.value);
  });
})();
</script>

<style>
  .commune-hero {
    padding: var(--xl) 0 var(--lg);
  }

  .breadcrumb {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--sm);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .commune-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
    margin-top: var(--sm);
  }

  .population-note {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .low-pop-caveat {
    margin-top: var(--md);
    padding: var(--sm) var(--md);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-label);
    color: var(--muted);
  }

  .key-stats-row {
    display: grid;
