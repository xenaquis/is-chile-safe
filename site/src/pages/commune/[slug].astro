---
/**
 * EN commune page — /commune/{slug}/
 *
 * getStaticPaths reads loadRolloutCuts() (the rollout gate, D-24/PAGES-04).
 * Non-rollout communes are NOT built — true 404 (D-26).
 *
 * vs-national and vs-regional computed against per-capita MEANS:
 *   loadNationalAverage() and loadRegionalAverage(region_id)
 * NEVER against loadNational()/loadRegion() series rate (those are SUMs, Pitfall 1).
 *
 * Zero client:* directives (D-09). All components are static .astro.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LevelChip from '../../components/LevelChip.astro';
import TrendChip from '../../components/TrendChip.astro';
import StatCard from '../../components/StatCard.astro';
import Sparkline from '../../components/Sparkline.astro';
import ComparisonCallout from '../../components/ComparisonCallout.astro';
import FamilyBreakdownBars from '../../components/FamilyBreakdownBars.astro';
import ComparableCommune from '../../components/ComparableCommune.astro';
import CommuneRankingTable from '../../components/CommuneRankingTable.astro';
import { FAMILY_SLUGS } from '../../config/i18n.ts';
import MethodologyCaveat from '../../components/MethodologyCaveat.astro';
import {
  loadCommune,
  loadRegion,
  regionFileId,
  loadRolloutCuts,
  loadNationalAverage,
  loadRegionalAverage,
  nearestComparable,
  nearestComparables,
  latestCompleteYearRate,
  loadIndex,
} from '../../lib/data.ts';
import { buildCommuneProse } from '../../lib/proseEngine.ts';
import { buildBreadcrumb, buildItemList } from '../../lib/jsonld.ts';
import { levelForRate } from '../../lib/colorScale.ts';
import { EN_STRINGS } from '../../config/i18n.ts';

export async function getStaticPaths() {
  const cuts = loadRolloutCuts();
  return cuts.map((cut) => {
    const meta = loadIndex().find((c) => c.cut === cut);
    return {
      params: { slug: meta?.slug ?? cut },
      props: { cut },
    };
  });
}

// --- Page-level data ---
const { cut } = Astro.props as { cut: string };
const data = loadCommune(cut);
const year = data.latestCompleteYear;
const rate = latestCompleteYearRate(data);

// Dimension 1: vs-national (MEAN, not SUM)
const nationalAvg = loadNationalAverage();
const vsNationalPct = nationalAvg > 0 ? ((rate - nationalAvg) / nationalAvg) * 100 : 0;
const vsNationalDir: 'above' | 'below' = vsNationalPct >= 0 ? 'above' : 'below';

// Dimension 2: vs-regional (MEAN, not SUM)
const regionalAvg = loadRegionalAverage(data.region_id);
const vsRegionalPct = regionalAvg > 0 ? ((rate - regionalAvg) / regionalAvg) * 100 : 0;
const vsRegionalDir: 'above' | 'below' = vsRegionalPct >= 0 ? 'above' : 'below';

// Dimension 4: dominant + secondary family
const seriesEntry = data.series.find((s) => s.year === year && !s.partial);
const byFamily = seriesEntry?.by_family ?? {};

// Dimension 5: comparable commune
const comparable = nearestComparable(cut);

// Region slug for breadcrumb — resolve via the region file, NOT data.slug
// (data.slug is the commune slug; region pages are built at /region/{region.slug}/).
const regionSlug = loadRegion(regionFileId(data.region_id)).slug;

// Compute incidence level (1–5) for LevelChip
const allRates = loadIndex()
  .filter((c) => !c.low_population)
  .map((c) => latestCompleteYearRate(loadCommune(c.cut)))
  .sort((a, b) => a - b);
const level = levelForRate(rate, allRates);

// Region commune count for regional-rank device (#N of M)
// NOTE: BUGFIX-999.1 — Tarapacá region_id may collide with Aysén/Los Ríos
// provincial codes (11/14); count may be slightly off for those regions. Accept.
const regionCommuneCount = loadIndex().filter(
  (c) => c.region_id === data.region_id
).length;

// Similar comunas in same region (D-07)
const similarComunas = nearestComparables(cut, 5);

// Prose
const prose = buildCommuneProse(data, 'en');

// URLs
const enPath = `/commune/${data.slug}/`;
const esPath = `/es/comuna/${data.slug}/`;

// Meta
const t = EN_STRINGS;
const title = `${data.name} Crime Data — Chile Safety Map`;
const description = `Official CEAD crime statistics for ${data.name}, ${data.regionName}: reported incidence rate, national ranking, annual evolution 2005–${year}.`;

// JSON-LD: Dataset + Place (UI-SPEC lines 270-286)
const jsonLdDataset = {
  '@context': 'https://schema.org',
  '@type': ['Dataset', 'Place'],
  name: `${data.name} — Reported Crime Incidence`,
  description: `Annual reported crime incidence rates per 100,000 inhabitants for ${data.name}, sourced from CEAD (Centro de Estudios y Análisis del Delito), Chile.`,
  url: `https://ischilesafe.com/commune/${data.slug}/`,
  spatialCoverage: {
    '@type': 'Place',
    name: data.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: data.regionName },
  },
  temporalCoverage: `2005/${year}`,
  measurementTechnique: 'Rate per 100,000 inhabitants, official CEAD police statistics',
  creator: { '@type': 'Organization', name: 'CEAD — Centro de Estudios y Análisis del Delito' },
};

// BreadcrumbList: mirrors 4-level visual breadcrumb Home › Communes › {Region} › {Commune}
const breadcrumb = buildBreadcrumb([
  { name: 'Home',          url: 'https://ischilesafe.com/' },
  { name: 'Communes',      url: 'https://ischilesafe.com/communes/' },
  { name: data.regionName, url: `https://ischilesafe.com/region/${regionSlug}/` },
  { name: data.name },  // current — omits item per spec
]);

// ItemList: "similar comunas" by proximity — NOT a safety rank (resolved A1 / T-13-05)
const similarList = buildItemList(similarComunas, 'en', { order: 'Unordered' });

const jsonLd = [jsonLdDataset, breadcrumb, similarList];
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  enPath={enPath}
  esPath={esPath}
  jsonLd={jsonLd}
  mountType="commune-map"
  pageType="commune"
>
  <!-- 2. CommuneHero -->
  <section class="commune-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <a href="/communes/">Communes</a>
      <span aria-hidden="true"> › </span>
      <a href={`/region/${regionSlug}/`}>{data.regionName}</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">{data.name}</span>
    </nav>
    <h1 class="commune-h1">{data.name}</h1>
    <div class="hero-meta">
      <LevelChip level={level} locale="en" />
      <span class="population-note">Population: {data.population.toLocaleString()}</span>
    </div>
    {data.low_population && (
      <p class="low-pop-caveat">{t.low_population_caveat}</p>
    )}
  </section>

  <!-- 3. KeyStatsRow -->
  <section class="key-stats-row" aria-label="Key statistics">
    <StatCard
      label={t.rate_label.replace('{year}', String(year))}
      value={Math.round(rate).toLocaleString()}
    />
    <StatCard
      label={t.national_rank_label}
      value={`#${data.national_rank} ${t.rank_of} 346`}
    />
    <StatCard
      label={t.regional_rank_label}
      value={`#${data.regional_rank} of ${regionCommuneCount}`}
    />
  </section>

  <!-- 4. SparklineSection -->
  <section class="sparkline-section" aria-label="Annual evolution">
    <h2 class="section-heading">{t.sparkline_heading}</h2>
    <Sparkline series={data.series} activeYear={year} />
    <TrendChip trend={data.trend} locale="en" />
  </section>

  <!-- 5. ComparisonCallouts -->
  <section class="comparison-callouts" aria-label="National and regional comparisons">
    <ComparisonCallout
      pct={vsNationalPct}
      direction={vsNationalDir}
      scope="national"
      locale="en"
    />
    <ComparisonCallout
      pct={vsRegionalPct}
      direction={vsRegionalDir}
      scope="regional"
      locale="en"
    />
  </section>

  <!-- 6. CrimeFamilyBreakdown -->
  <section class="family-breakdown" aria-label="Crime family breakdown">
    <h2 class="section-heading">
      {t.family_breakdown_heading.replace('{year}', String(year))}
    </h2>
    <FamilyBreakdownBars byFamily={byFamily} locale="en" level={level} />
  </section>

  <!-- 7. ComparableCommune -->
  <ComparableCommune comparable={comparable} locale="en" />

  <!-- 8. Map spoke (D-08) — static link only, zero client:* -->
  <section class="map-spoke" aria-label="View on national map">
    <h2 class="section-heading">View on Map</h2>
    <a href={`/map/?cut=${data.cut}`} class="map-spoke-cta">
      See {data.name} on the interactive Chile crime map →
    </a>
  </section>

  <!-- 8b. Similar comunas in this region (D-07) -->
  <section class="similar-comunas-spoke" aria-label="Similar communes in this region">
    <h2 class="section-heading">Similar Communes in This Region</h2>
    <p class="spoke-intro">Communes in {data.regionName} with similar reported CEAD incidence rates:</p>
    <CommuneRankingTable rows={similarComunas} locale="en" />
  </section>

  <!-- 8c. Per-crime-type ranking spoke (D-10) -->
  <section class="crime-type-spoke" aria-label="Rankings by crime type">
    <h2 class="section-heading">Rankings by Crime Type</h2>
    <ul class="crime-type-list">
      {Object.entries(byFamily).map(([key]) => (
        <li>
          <a href={`/crime/${FAMILY_SLUGS[key]?.en ?? key}/`}>
            {FAMILY_SLUGS[key]?.en ?? key} ranking
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 9. ProseSummary -->
  <section class="prose-summary" aria-label="Summary">
    {prose.split('\n\n').map((para) => <p>{para}</p>)}
  </section>

  <!-- 10. MethodologyCaveat -->
  <MethodologyCaveat locale="en" />
</BaseLayout>

<style>
  .commune-hero {
    padding: var(--xl) 0 var(--lg);
  }

  .breadcrumb {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--sm);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .commune-h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin: var(--sm) 0;
    line-height: 1.15;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--md);
    flex-wrap: wrap;
    margin-top: var(--sm);
  }

  .population-note {
    font-size: var(--text-label);
    color: var(--muted);
  }

  .low-pop-caveat {
    margin-top: var(--md);
    padding: var(--sm) var(--md);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-label);
    color: var(--muted);
  }

  .key-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--md);
    margin: var(--xl) 0;
  }

  @media (max-width: 600px) {
    .key-stats-row {
      grid-template-columns: 1fr;
    }
  }

  .sparkline-section {
    margin: var(--xl) 0;
  }

  .section-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-strong);
    color: var(--ink);
    margin-bottom: var(--md);
  }

  .comparison-callouts {
    display: flex;
    gap: var(--md);
    flex-wrap: wrap;
    margin: var(--xl) 0;
  }

  .family-breakdown {
    margin: var(--xl) 0;
  }

  .map-spoke {
    margin: var(--xl) 0;
  }

  .map-spoke-cta {
    display: inline-block;
    padding: var(--sm) var(--md);
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    border-radius: var(--radius);
    font-size: var(--text-body);
  }

  .map-spoke-cta:hover {
    opacity: 0.9;
  }

  .similar-comunas-spoke {
    margin: var(--xl) 0;
  }

  .spoke-intro {
    font-size: var(--text-label);
    color: var(--muted);
    margin-bottom: var(--md);
  }

  .crime-type-spoke {
    margin: var(--xl) 0;
  }

  .crime-type-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sm);
  }

  .crime-type-list li a {
    display: inline-block;
    padding: var(--xs) var(--sm);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-label);
    color: var(--primary);
    text-decoration: none;
    text-transform: capitalize;
  }

  .crime-type-list li a:hover {
    background: var(--bg);
  }

  .prose-summary {
    margin: var(--2xl) 0;
    max-width: 72ch;
  }

  .prose-summary p {
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: var(--md);
  }
</style>
