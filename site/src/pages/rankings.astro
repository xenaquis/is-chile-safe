---
/**
 * /rankings/ — EN rankings hub (IA-03, D-12).
 * Rankings v2: the plain link list becomes RankingHub.astro (8 cards carrying
 * the national average and the commune at the top of each ranking).
 * The ItemList now points at the ranking pages, which the hub never linked to.
 */
import EditorialLayout from '../layouts/EditorialLayout.astro';
import RankingHub from '../components/RankingHub.astro';
import { RANKING_DEFS, rankingPath } from '../config/rankingStrings.ts';
import { FAMILY_LABELS_EN } from '../lib/familyDefs';
import { buildItemList } from '../lib/jsonld.ts';

const rankingLinks = [
  { name: 'Communes with the lowest reported crime incidence in Chile', url: 'https://ischilesafe.com/safest-cities-in-chile/' },
  { name: 'Browse all 346 communes', url: 'https://ischilesafe.com/communes/' },
  ...RANKING_DEFS.map((def) => ({
    name: `${FAMILY_LABELS_EN[def.familyKey] ?? def.familyKey} — national ranking by commune`,
    url: `https://ischilesafe.com${rankingPath(def, 'en')}`,
  })),
];
const rankingItemList = buildItemList(rankingLinks, 'en', { order: 'Unordered', urlMode: 'full' });
---

<EditorialLayout
  lang="en"
  title="Crime Incidence Rankings — Chile | Chile Safety Map"
  description="Explore reported crime incidence rankings by commune, crime type, and region across Chile. Data: CEAD official Chilean police statistics."
  enPath="/rankings/"
  esPath="/es/rankings/"
  pageType="ranking"
  jsonLd={[rankingItemList]}
>
  <RankingHub lang="en" />
</EditorialLayout>
